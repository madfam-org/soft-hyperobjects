{
  "project": {
    "name": "Heated Vest",
    "slug": "heated-vest",
    "version": "0.1.0",
    "engine": "fc",
    "description": {
      "en": "A softshell vest prepared for heating: a sleeveless front + back with a front opening, overlaid with conductive heating routes (marked serpentine traces a heating element follows) and a battery pocket sized to the Yantra4D `battery-holder`. Fashion Cabinet owns the vest + routing; Yantra4D owns the printable battery holder. Routes and pocket are marked for the maker; no electronics/heating element is drafted here. FC-200 e-textile capsule.\n\nOfficial visualizer and configurator: Fashion Cabinet",
      "es": "Un chaleco softshell preparado para calefacción: un frente + espalda sin mangas con abertura frontal, con rutas de calefacción conductoras marcadas (trazas serpenteantes que sigue un elemento calefactor) y una bolsa de batería dimensionada al `battery-holder` de Yantra4D. Fashion Cabinet posee el chaleco + el ruteo; Yantra4D posee el portapilas imprimible. Las rutas y la bolsa se marcan para quien elabora; no se traza electrónica. Cápsula e-textil FC-200.\n\nVisualizador y configurador oficial: Fashion Cabinet"
    },
    "difficulty": "intermediate",
    "tags": ["etextile", "wearable-tech", "heated", "vest", "conductive", "hardware", "commons", "made-to-measure"],
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "LicenseRef-FC1-pending",
      "lineage": [{ "source": "Original draft for Fashion Cabinet", "license": "original" }]
    }
  },
  "modes": [
    { "id": "set", "label": { "en": "Full Vest", "es": "Chaleco completo" }, "script_file": "main.py", "pieces": ["front", "back"] }
  ],
  "pieces": [
    { "id": "front", "label": { "en": "Front (battery pocket)", "es": "Frente (bolsa de batería)" }, "default_color": "#3a4048", "cut": { "quantity": 2, "on_fold": false, "mirror": true } },
    { "id": "back", "label": { "en": "Back (heating zones)", "es": "Espalda (zonas de calor)" }, "default_color": "#3a4048", "cut": { "quantity": 1, "on_fold": true, "fold_edge": "center", "mirror": true } }
  ],
  "parameters": [
    { "id": "chest_girth", "type": "slider", "default": 1040, "min": 700, "max": 1600, "step": 10, "measurement": { "standard": "iso_8559", "code": "chest_bust_girth" }, "label": { "en": "Chest girth (mm)", "es": "Contorno de pecho (mm)" }, "tooltip": { "en": "Full chest", "es": "Pecho completo" } },
    { "id": "vest_length", "type": "slider", "default": 640, "min": 420, "max": 900, "step": 10, "label": { "en": "Length (mm)", "es": "Largo (mm)" }, "tooltip": { "en": "Shoulder to hem", "es": "Del hombro al ruedo" } },
    { "id": "neck_width", "type": "slider", "default": 190, "min": 120, "max": 320, "step": 5, "label": { "en": "Neck width (mm)", "es": "Ancho de cuello (mm)" }, "tooltip": { "en": "Neck opening", "es": "Abertura de cuello" } },
    { "id": "shoulder_w", "type": "slider", "default": 120, "min": 80, "max": 200, "step": 5, "label": { "en": "Shoulder width (mm)", "es": "Ancho de hombro (mm)" }, "tooltip": { "en": "Half shoulder width", "es": "Medio ancho de hombro" } },
    { "id": "armhole_drop", "type": "slider", "default": 280, "min": 200, "max": 420, "step": 10, "label": { "en": "Armhole depth (mm)", "es": "Profundidad de sisa (mm)" }, "tooltip": { "en": "Armhole depth", "es": "Profundidad de la sisa" } },
    { "id": "vest_ease", "type": "slider", "default": 120, "min": 40, "max": 360, "step": 10, "label": { "en": "Layering ease (mm)", "es": "Holgura de capa (mm)" }, "tooltip": { "en": "Ease for wearing over layers", "es": "Holgura para usar sobre capas" } },
    { "id": "battery_w", "type": "slider", "default": 80, "min": 40, "max": 160, "step": 5, "label": { "en": "Battery-pocket opening (mm)", "es": "Abertura de bolsa (mm)" }, "tooltip": { "en": "Sized to the Yantra4D battery holder", "es": "A la medida del portapilas de Yantra4D" } },
    { "id": "heat_zones", "type": "slider", "default": 3, "min": 1, "max": 6, "step": 1, "label": { "en": "Heating zones", "es": "Zonas de calor" }, "tooltip": { "en": "Marked serpentine heat routes", "es": "Rutas serpenteantes marcadas" } }
  ],
  "presets": [
    { "id": "commuter", "label": { "en": "Commuter", "es": "Urbano" }, "values": { "vest_ease": 120, "heat_zones": 3 } },
    { "id": "outdoor", "label": { "en": "Outdoor", "es": "Exterior" }, "values": { "vest_ease": 240, "heat_zones": 5, "vest_length": 720 } }
  ],
  "export_formats": ["svg", "dxf", "json"],
  "fabrics": [],
  "notion": {
    "kind": "custom",
    "subtype": "battery pocket",
    "hardware_ref": {
      "platform": "yantra4d",
      "project_slug": "battery-holder",
      "linked": true,
      "params_map": { "cell": "battery_w" }
    }
  },
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "e_textile",
    "interfaces": [
      { "id": "shoulder_seam", "type": "shoulder", "label": { "en": "Shoulder seam", "es": "Costura de hombro" }, "edges": [{ "piece": "front", "edge": "shoulder" }, { "piece": "back", "edge": "shoulder" }], "parameters": ["neck_width", "shoulder_w"] },
      { "id": "conductive_route", "type": "custom", "label": { "en": "Heating routing plan", "es": "Plan de ruteo de calor" }, "edges": [{ "piece": "back", "edge": "hem" }], "parameters": ["battery_w", "heat_zones"] }
    ],
    "capabilities": { "made_to_measure": true, "fold_cutting": true, "fabric_compensation": false, "hardware_bridge": true, "e_textile": true },
    "societal_benefit": {
      "en": "An open, made-to-measure heated vest with marked heating routes and a battery pocket sized to an open printable Yantra4D holder makes warmth-on-demand a repairable, washable, open garment — you reprint the holder and re-route the element instead of discarding a sealed product.",
      "es": "Un chaleco con calefacción abierto y a la medida con rutas de calor marcadas y una bolsa de batería dimensionada a un portapilas imprimible abierto de Yantra4D vuelve el calor a demanda una prenda abierta, reparable y lavable — reimprimes el portapilas y re-ruteas el elemento en vez de desechar un producto sellado."
    },
    "commons_license": "LicenseRef-FC1-pending"
  }
}
