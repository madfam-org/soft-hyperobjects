{
  "project": {
    "name": "A-Line Dress",
    "slug": "a-line-dress",
    "version": "0.1.0",
    "engine": "fc",
    "description": {
      "en": "FC-100 rank #22. Waist-seamless sleeveless shift-to-flare dress: a fitted bust with internal side-bust darts, back fisheye darts, a CB invisible zipper, and an A-line hem a flare wider than the bust quarter; neck and armhole facings are derived from the measured openings.\n\nOfficial visualizer and configurator: Fashion Cabinet",
      "es": "Rango #22 del FC-100. Vestido línea A sin mangas y sin costura de cintura: busto entallado con pinzas laterales internas, pinzas fisheye traseras, cierre invisible en CB y dobladillo línea A con vuelo sobre el cuarto de busto; las vistas de escote y sisa se derivan de las aberturas medidas.\n\nVisualizador y configurador oficial: Fashion Cabinet",
      "fr": "Rang n°22 du FC-100. Robe chasuble sans manches, du buste ajusté à l'évasé, sans couture de taille : buste ajusté avec pinces de côté internes, pinces poisson au dos, fermeture invisible au milieu dos et ourlet trapèze plus large que le quart de poitrine ; les parementures d'encolure et d'emmanchure sont dérivées des ouvertures mesurées.\n\nVisualiseur et configurateur officiel : Fashion Cabinet"
    },
    "difficulty": "intermediate",
    "tags": [
      "dress",
      "a-line",
      "sleeveless",
      "woven",
      "zipper",
      "fc100",
      "hyperobject",
      "commons"
    ],
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "CERN-OHL-W-2.0",
      "lineage": [
        {
          "source": "Original draft for Fashion Cabinet (bodice block + A-line skirt families)",
          "license": "original"
        }
      ]
    }
  },
  "modes": [
    {
      "id": "dress",
      "label": {
        "en": "A-line dress (all pieces)",
        "es": "Vestido línea A (todas las piezas)",
        "fr": "Robe trapèze (toutes les pièces)"
      },
      "script_file": "main.py",
      "pieces": [
        "front",
        "back",
        "neck_facing",
        "armhole_facing"
      ]
    }
  ],
  "pieces": [
    {
      "id": "front",
      "label": {
        "en": "Dress Front",
        "es": "Delantero de Vestido",
        "fr": "Devant de robe"
      },
      "default_color": "#7a4a68",
      "cut": {
        "quantity": 1,
        "on_fold": true,
        "mirror": true
      }
    },
    {
      "id": "back",
      "label": {
        "en": "Dress Back",
        "es": "Trasero de Vestido",
        "fr": "Dos de robe"
      },
      "default_color": "#5f3752",
      "cut": {
        "quantity": 2,
        "mirror": true
      }
    },
    {
      "id": "neck_facing",
      "label": {
        "en": "Neck Facing",
        "es": "Vista de Escote",
        "fr": "Parementure d'encolure"
      },
      "default_color": "#9a6a88",
      "cut": {
        "quantity": 1
      }
    },
    {
      "id": "armhole_facing",
      "label": {
        "en": "Armhole Facing",
        "es": "Vista de Sisa",
        "fr": "Parementure d'emmanchure"
      },
      "default_color": "#b08aa2",
      "cut": {
        "quantity": 2
      }
    }
  ],
  "parameters": [
    {
      "id": "bust_girth",
      "type": "slider",
      "default": 920,
      "min": 600,
      "max": 1700,
      "step": 10,
      "measurement": {
        "standard": "iso_8559",
        "code": "bust_girth"
      },
      "label": {
        "en": "Bust girth (mm)",
        "es": "Contorno de busto (mm)",
        "fr": "Tour de buste (mm)"
      }
    },
    {
      "id": "waist_girth",
      "type": "slider",
      "default": 740,
      "min": 450,
      "max": 1500,
      "step": 10,
      "measurement": {
        "standard": "iso_8559",
        "code": "waist_girth"
      },
      "tooltip": {
        "en": "Places the back fisheye darts",
        "es": "Ubica las pinzas fisheye traseras",
        "fr": "Positionne les pinces poisson du dos"
      },
      "label": {
        "en": "Waist girth (mm)",
        "es": "Contorno de cintura (mm)",
        "fr": "Tour de taille (mm)"
      }
    },
    {
      "id": "dress_length",
      "type": "slider",
      "default": 950,
      "min": 700,
      "max": 1400,
      "step": 10,
      "label": {
        "en": "Dress length, nape to hem (mm)",
        "es": "Largo de vestido, nuca a dobladillo (mm)",
        "fr": "Longueur de robe, nuque à l'ourlet (mm)"
      }
    },
    {
      "id": "flare_mm",
      "type": "slider",
      "default": 110,
      "min": 40,
      "max": 400,
      "step": 10,
      "tooltip": {
        "en": "Extra half-hem width beyond the bust quarter",
        "es": "Ancho extra de medio dobladillo sobre el cuarto de busto",
        "fr": "Largeur supplémentaire du demi-ourlet au-delà du quart de poitrine"
      },
      "label": {
        "en": "Hem flare (mm)",
        "es": "Vuelo de dobladillo (mm)",
        "fr": "Évasement du bas (mm)"
      }
    },
    {
      "id": "strap_width",
      "type": "slider",
      "default": 42,
      "min": 24,
      "max": 80,
      "step": 2,
      "label": {
        "en": "Strap width (mm)",
        "es": "Ancho de tirante (mm)",
        "fr": "Largeur de bretelle (mm)"
      }
    },
    {
      "id": "front_drop",
      "type": "slider",
      "default": 95,
      "min": 60,
      "max": 160,
      "step": 5,
      "label": {
        "en": "Front neck drop (mm)",
        "es": "Caída de escote delantero (mm)",
        "fr": "Descente d'encolure devant (mm)"
      }
    },
    {
      "id": "zipper_length",
      "type": "slider",
      "default": 400,
      "min": 250,
      "max": 600,
      "step": 10,
      "label": {
        "en": "Zipper length (mm)",
        "es": "Largo de cierre (mm)",
        "fr": "Longueur de fermeture à glissière (mm)"
      }
    },
    {
      "id": "bust_dart_intake",
      "type": "slider",
      "default": 28,
      "min": 0,
      "max": 50,
      "step": 2,
      "advanced": true,
      "label": {
        "en": "Bust dart intake (mm)",
        "es": "Profundidad de pinza de busto (mm)",
        "fr": "Valeur de la pince de poitrine (mm)"
      }
    },
    {
      "id": "seam_allowance",
      "type": "slider",
      "default": 10,
      "min": 0,
      "max": 20,
      "step": 1,
      "label": {
        "en": "Seam allowance (mm)",
        "es": "Margen de costura (mm)",
        "fr": "Marge de couture (mm)"
      }
    },
    {
      "id": "hem_allowance",
      "type": "slider",
      "default": 30,
      "min": 0,
      "max": 60,
      "step": 5,
      "label": {
        "en": "Hem allowance (mm)",
        "es": "Margen de dobladillo (mm)",
        "fr": "Marge d'ourlet (mm)"
      }
    }
  ],
  "presets": [
    {
      "id": "knee",
      "label": {
        "en": "Knee",
        "es": "A la rodilla",
        "fr": "Genou"
      },
      "values": {
        "dress_length": 850
      }
    },
    {
      "id": "midi",
      "label": {
        "en": "Midi",
        "es": "Midi",
        "fr": "Midi"
      },
      "values": {
        "dress_length": 1050
      }
    }
  ],
  "constraints": [
    {
      "expression": "zipper_length < dress_length / 2",
      "severity": "warning",
      "message": {
        "en": "Zippers longer than half the dress length are clamped by the draft",
        "es": "Cierres mayores a la mitad del largo del vestido se limitan en el trazo",
        "fr": "Les fermetures plus longues que la moitié de la robe sont bridées par le tracé"
      }
    },
    {
      "expression": "waist_girth <= bust_girth + 80",
      "severity": "warning",
      "message": {
        "en": "Width is bust-derived; a waist beyond bust + ease needs more flare or a larger size",
        "es": "El ancho se deriva del busto; una cintura mayor al busto + holgura requiere más vuelo o una talla mayor",
        "fr": "La largeur est dérivée de la poitrine ; une taille supérieure à poitrine + aisance exige plus d'évasé ou une taille de patron supérieure"
      }
    }
  ],
  "export_formats": [
    "svg",
    "dxf",
    "json"
  ],
  "fabrics": [
    "popelina-algodon"
  ],
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "garment",
    "interfaces": [
      {
        "id": "neckline",
        "type": "neckline",
        "edges": [
          {
            "piece": "front",
            "edge": "neck"
          },
          {
            "piece": "back",
            "edge": "neck"
          }
        ],
        "parameters": [
          "front_drop"
        ]
      },
      {
        "id": "armscye",
        "type": "armscye",
        "edges": [
          {
            "piece": "front",
            "edge": "armhole"
          },
          {
            "piece": "back",
            "edge": "armhole"
          }
        ],
        "parameters": [
          "bust_girth",
          "strap_width"
        ]
      },
      {
        "id": "hem",
        "type": "hem",
        "edges": [
          {
            "piece": "front",
            "edge": "hem"
          },
          {
            "piece": "back",
            "edge": "hem"
          }
        ],
        "parameters": [
          "dress_length",
          "flare_mm",
          "hem_allowance"
        ]
      },
      {
        "id": "cb_zipper",
        "type": "zipper_tape",
        "edges": [
          {
            "piece": "back",
            "edge": "center"
          }
        ],
        "parameters": [
          "zipper_length"
        ]
      }
    ],
    "capabilities": {
      "made_to_measure": true,
      "fold_cutting": true,
      "fabric_compensation": false,
      "knit_negative_ease": false
    },
    "societal_benefit": {
      "en": "First dress of the FC-100: one tier-2 cartridge that graduates makers from separates to dresses — waist-seamless shaping with internal darts, an invisible zipper, and facings computed from measured curves instead of guessed.",
      "es": "Primer vestido del FC-100: un cartucho de nivel 2 que lleva a quien confecciona de las prendas separadas a los vestidos — silueta sin costura de cintura con pinzas internas, cierre invisible y vistas calculadas a partir de curvas medidas en lugar de adivinarse.",
      "fr": "Première robe du FC-100 : une cartouche de niveau 2 qui fait passer les couturières des pièces séparées aux robes — une mise en forme sans couture de taille avec pinces internes, une fermeture invisible et des parementures calculées d'après des courbes mesurées plutôt que devinées."
    },
    "commons_license": "CERN-OHL-W-2.0"
  }
}
