            "piece": "front",
            "edge": "neck"
          },
          {
            "piece": "back",
            "edge": "neck"
          },
          {
            "piece": "hood",
            "edge": "neck"
          }
        ],
        "parameters": [
          "neck_girth",
          "hood_height",
          "hood_depth"
        ]
      },
      {
        "id": "armscye",
        "type": "armscye",
        "edges": [
          {
            "piece": "front",
            "edge": "armhole"
          },
          {
            "piece": "back",
            "edge": "armhole"
          },
          {
            "piece": "sleeve",
            "edge": "cap"
