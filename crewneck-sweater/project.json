  "constraints": [
    {
      "expression": "sweater_ease >= 60",
      "severity": "warning",
      "message": {
        "en": "Sweater knits need room to hang; below 60 mm ease the body reads fitted and seams strain",
        "es": "El tejido de suéter necesita caída; debajo de 60 mm de holgura el cuerpo queda entallado y las costuras sufren",
        "fr": "Les tricots de pull ont besoin de place pour tomber ; en dessous de 60 mm d'aisance le corps paraît ajusté et les coutures forcent"
      }
    },
    {
      "expression": "cuff_ratio <= 0.8",
      "severity": "warning",
      "message": {
        "en": "Sweater-rib cuffs rely on strong negative ease; above 0.80 the deep cuff bells open",
        "es": "Los puños de rib de suéter dependen de holgura negativa fuerte; arriba de 0.80 el puño profundo se acampana",
        "fr": "Les poignets en côtes de pull reposent sur une forte aisance négative ; au-delà de 0,80 le poignet profond s'évase"
      }
    }
