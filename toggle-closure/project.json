    {
      "id": "barrel_len",
      "type": "slider",
      "group": "construction",
      "default": 38,
      "min": 18,
      "max": 80,
      "step": 1,
      "label": {
        "en": "Toggle length (mm)",
        "es": "Largo del alamar (mm)",
        "fr": "Longueur du brandebourg (mm)"
      }
    },
    {
      "id": "cord_dia",
      "type": "slider",
      "group": "construction",
      "default": 4,
      "min": 1.5,
      "max": 10,
      "step": 0.5,
      "label": {
        "en": "Cord diameter (mm)",
        "es": "Diámetro de cordón (mm)",
        "fr": "Diamètre du cordon (mm)"
      }
    },
    {
      "id": "count",
      "type": "slider",
      "group": "construction",
      "default": 4,
      "min": 1,
      "max": 12,
      "step": 1,
      "label": {
        "en": "Number of toggles",
        "es": "Número de alamares",
        "fr": "Nombre de brandebourgs"
      }
    },
    {
      "id": "run_length",
      "type": "slider",
      "group": "construction",
      "default": 300,
      "min": 40,
      "max": 1000,
      "step": 5,
      "label": {
        "en": "Placement run (mm)",
        "es": "Largo de la línea (mm)",
        "fr": "Longueur de la ligne de placement (mm)"
      }
    },
    {
      "id": "end_offset",
      "type": "slider",
      "group": "construction",
      "default": 15,
      "min": 5,
      "max": 100,
      "step": 1,
      "label": {
        "en": "End inset (mm)",
        "es": "Margen extremo (mm)",
        "fr": "Retrait d'extrémité (mm)"
      }
