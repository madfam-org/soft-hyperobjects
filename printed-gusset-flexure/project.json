{
  "project": {
    "name": "Printed Gusset Flexure",
    "slug": "printed-gusset-flexure",
    "version": "0.1.0",
    "engine": "fc",
    "description": {
      "en": "A Yantra4D-bridged notion for the additive-manufacturing frontier of trims: a 3D-printed thin TPU diamond gusset cut with a slit lattice so it stretches biaxially for underarm, crotch, or side-vent range of motion. Fashion Cabinet owns the fashion (sizing to the wearer, the sewable-edge placement guide) while the printed part itself is a Yantra4D solid (`tpu-gusset-flexure`). One material identity spans this notion and that solid.\n\nOfficial visualizer and configurator: Fashion Cabinet",
      "es": "Un avío puenteado con Yantra4D para la frontera de manufactura aditiva de los avíos: un refuerzo de diamante TPU delgado impreso en 3D cortado con una retícula de ranuras para que estire biaxialmente en axila, entrepierna o abertura lateral. Fashion Cabinet posee la moda (dimensionado a quien lo usa, la guía de colocación del canto cosible) mientras la parte impresa es un sólido de Yantra4D (`tpu-gusset-flexure`). Una identidad de material abarca este avío y ese sólido.\n\nVisualizador y configurador oficial: Fashion Cabinet"
    },
    "difficulty": "intermediate",
    "tags": [
      "gusset",
      "flexure",
      "stretch",
      "tpu",
      "am-fashion",
      "notion",
      "printed-textile",
      "hyperobject",
      "commons"
    ],
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "LicenseRef-FC1-pending",
      "lineage": [
        {
          "source": "Original draft for Fashion Cabinet",
          "license": "original"
        }
      ]
    }
  },
  "modes": [
    {
      "id": "placement-guide",
      "label": {
        "en": "Placement Guide",
        "es": "Guía de colocación"
      },
      "script_file": "main.py",
      "pieces": [
        "placement-guide"
      ]
    }
  ],
  "pieces": [
    {
      "id": "placement-guide",
      "label": {
        "en": "Printed Gusset Flexure Placement Guide",
        "es": "Guía de Printed Gusset Flexure"
      },
      "default_color": "#8a94a0",
      "cut": {
        "quantity": 1,
        "on_fold": false,
        "mirror": false
      }
    }
  ],
  "parameter_groups": [
    {
      "id": "construction",
      "label": {
        "en": "Construction",
        "es": "Construcción",
        "fr": "Construction"
      }
    }
  ],
  "parameters": [
    {
      "id": "gusset_w",
      "type": "slider",
      "group": "construction",
      "default": 70,
      "min": 20,
      "max": 200,
      "step": 2,
      "label": {
        "en": "Gusset width (mm)",
        "es": "Ancho del refuerzo (mm)"
      }
    },
    {
      "id": "gusset_h",
      "type": "slider",
      "group": "construction",
      "default": 90,
      "min": 20,
      "max": 260,
      "step": 2,
      "label": {
        "en": "Gusset height (mm)",
        "es": "Alto del refuerzo (mm)"
      }
    },
    {
      "id": "wall",
      "type": "slider",
      "group": "construction",
      "default": 1.4,
      "min": 0.8,
      "max": 4.0,
      "step": 0.1,
      "label": {
        "en": "Printed wall (mm)",
        "es": "Pared impresa (mm)"
      }
    },
    {
      "id": "seam_allowance",
      "type": "slider",
      "group": "construction",
      "default": 8,
      "min": 0,
      "max": 25,
      "step": 1,
      "label": {
        "en": "Sew-edge allowance (mm)",
        "es": "Margen de canto cosible (mm)"
      },
      "advanced": true
    }
  ],
  "presets": [
    {
      "id": "default",
      "label": {
        "en": "Default",
        "es": "Predeterminado"
      },
      "values": {
        "gusset_w": 70
      }
    }
  ],
  "export_formats": [
    "svg",
    "dxf",
    "json"
  ],
  "fabrics": [],
  "notion": {
    "kind": "custom",
    "subtype": "printed gusset flexure",
    "hardware_ref": {
      "platform": "yantra4d",
      "project_slug": "tpu-gusset-flexure",
      "linked": true,
      "params_map": {
        "diag_w": "gusset_w",
        "diag_h": "gusset_h",
        "wall": "wall"
      }
    }
  },
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "notion",
    "interfaces": [
      {
