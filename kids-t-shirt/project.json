  "constraints": [
    {
      "expression": "chest_girth <= 820",
      "severity": "warning",
      "message": {
        "en": "Above this girth, size up to the adult t-shirt-crew block instead",
        "es": "Por encima de este contorno, usa mejor el bloque adulto t-shirt-crew",
        "fr": "Au-delà de ce tour, passez plutôt au bloc adulte t-shirt-crew"
      }
    },
    {
      "expression": "sleeve_length <= body_length",
      "severity": "warning",
      "message": {
        "en": "Sleeve longer than the body — check the measurements",
        "es": "Manga más larga que el cuerpo — revisa las medidas",
        "fr": "Manche plus longue que le corps — vérifiez les mesures"
      }
    },
    {
      "expression": "neckband_ratio <= 1.0",
      "severity": "warning",
      "message": {
        "en": "A rib binding at or above the opening length won't hug the neck; keep it below 1.0",
        "es": "Un vivo de rib igual o mayor a la abertura no ceñirá el cuello; manténlo por debajo de 1.0",
        "fr": "Une bordure côtelée égale ou supérieure à la longueur de l'ouverture ne serrera pas le cou ; gardez-la sous 1.0"
      }
    }
  ],
