      },
      "tooltip": {
        "en": "Extra height above the shoulder",
        "es": "Altura extra sobre el hombro",
        "fr": "Hauteur supplémentaire au-dessus de l'épaule"
      }
    },
    {
      "id": "sleeve_grown",
      "type": "slider",
      "group": "fit",
      "default": 150,
      "min": 60,
      "max": 260,
      "step": 10,
