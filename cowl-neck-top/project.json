      "group": "body",
      "default": 620,
      "min": 420,
      "max": 900,
      "step": 10,
      "label": {
        "en": "Length (mm)",
        "es": "Largo (mm)",
        "fr": "Longueur (mm)"
      },
      "tooltip": {
        "en": "Shoulder to hem",
        "es": "Del hombro al ruedo",
        "fr": "De l'épaule au bas"
      }
    },
    {
