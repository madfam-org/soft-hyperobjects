  "export_formats": [
    "svg",
    "dxf",
    "json",
    "pdf"
  ],
  "fabrics": [],
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "garment",
    "interfaces": [
      {
        "id": "shoulder_seam",
        "type": "shoulder",
        "label": {
          "en": "Shoulder seam",
          "es": "Costura de hombro",
          "fr": "Couture d'épaule"
        },
        "edges": [
          {
            "piece": "front",
            "edge": "shoulder"
          },
          {
            "piece": "back",
            "edge": "shoulder"
          }
        ],
        "parameters": [
          "neck_width",
          "chest_girth"
        ]
      },
      {
        "id": "side_seam",
        "type": "side_seam",
        "label": {
          "en": "Side seam",
          "es": "Costura lateral",
          "fr": "Couture latérale"
        },
        "edges": [
          {
            "piece": "front",
            "edge": "side"
          },
          {
            "piece": "back",
            "edge": "side"
          }
        ],
        "parameters": [
          "top_length"
        ]
      }
    ],
    "capabilities": {
      "made_to_measure": true,
      "fold_cutting": true,
      "fabric_compensation": false
    },
    "societal_benefit": {
      "en": "An open, made-to-measure cowl top gets its drape from the front's own folded facing rather than a separate collar, so a draped neckline becomes a single-fabric, easy-to-cut commons object sized to the wearer.",
      "es": "Un top cowl abierto y a la medida obtiene su drapeado de la vista doblada del propio frente en lugar de un cuello aparte, de modo que un escote drapeado se vuelve un objeto común de una sola tela, fácil de cortar y ajustado a quien lo viste.",
      "fr": "Un haut à col bénitier ouvert et sur mesure tire son drapé de la propre parementure repliée du devant plutôt que d'un col séparé, de sorte qu'une encolure drapée devient un objet commun d'une seule pièce de tissu, facile à couper et dimensionné à celui qui le porte."
    },
    "commons_license": "CERN-OHL-W-2.0"
  }
