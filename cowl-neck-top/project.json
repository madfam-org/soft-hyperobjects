{
  "project": {
    "name": "Cowl-Neck Top",
    "slug": "cowl-neck-top",
    "version": "0.1.0",
    "engine": "fc",
    "description": {
      "en": "A relaxed top whose front neckline rises above the shoulder into a self-facing that folds back into a soft cowl — no separate collar. The front shoulder matches the back exactly, so the shoulder seam balances by construction; cut in a fluid fabric for the drape. A soft-goods garment — no hardware. FC-200 long-tail (silhouette gap).\n\nOfficial visualizer and configurator: Fashion Cabinet",
      "es": "Un top holgado cuyo escote frontal se eleva por encima del hombro en una vista propia que se dobla en una caída suave (cowl) — sin cuello aparte. El hombro frontal coincide exactamente con la espalda, así que la costura de hombro se equilibra por construcción; córtese en tela fluida para el drapeado. Una prenda textil — sin herrajes. Cola larga FC-200 (hueco de silueta).\n\nVisualizador y configurador oficial: Fashion Cabinet"
    },
    "difficulty": "intermediate",
    "tags": [
      "cowl",
      "top",
      "draped",
      "knit",
      "commons",
      "made-to-measure"
    ],
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "LicenseRef-FC1-pending",
      "lineage": [
        {
          "source": "Original draft for Fashion Cabinet",
          "license": "original"
        }
      ]
    }
  },
  "modes": [
    {
      "id": "set",
      "label": {
        "en": "Full Top",
        "es": "Top completo"
      },
      "script_file": "main.py",
      "pieces": [
        "front",
        "back"
      ]
    }
  ],
  "pieces": [
    {
      "id": "front",
      "label": {
        "en": "Front (cowl)",
        "es": "Frente (cowl)"
      },
      "default_color": "#5a6a7a",
      "cut": {
        "quantity": 1,
        "on_fold": true,
        "fold_edge": "center",
        "mirror": true
      }
    },
    {
      "id": "back",
      "label": {
        "en": "Back",
        "es": "Espalda"
      },
      "default_color": "#5a6a7a",
      "cut": {
        "quantity": 1,
        "on_fold": true,
        "fold_edge": "center",
        "mirror": true
      }
    }
  ],
  "parameter_groups": [
    {
      "id": "body",
      "label": {
        "en": "Body Measurements",
        "es": "Medidas Corporales",
        "fr": "Mesures du corps"
      }
    },
    {
      "id": "fit",
      "label": {
        "en": "Fit & Style",
        "es": "Ajuste y Estilo",
        "fr": "Coupe et style"
      }
    }
  ],
  "parameters": [
    {
      "id": "chest_girth",
      "type": "slider",
      "group": "body",
      "default": 980,
      "min": 650,
      "max": 1500,
      "step": 10,
      "measurement": {
        "standard": "iso_8559",
        "code": "chest_bust_girth"
      },
      "label": {
        "en": "Chest girth (mm)",
        "es": "Contorno de pecho (mm)"
      },
      "tooltip": {
        "en": "Full chest",
        "es": "Pecho completo"
      }
    },
    {
      "id": "top_length",
      "type": "slider",
      "group": "body",
      "default": 620,
      "min": 420,
      "max": 900,
      "step": 10,
      "label": {
        "en": "Length (mm)",
        "es": "Largo (mm)"
      },
      "tooltip": {
        "en": "Shoulder to hem",
        "es": "Del hombro al ruedo"
      }
    },
    {
      "id": "neck_width",
      "type": "slider",
      "group": "fit",
      "default": 220,
      "min": 160,
      "max": 380,
      "step": 5,
      "label": {
        "en": "Neck width (mm)",
        "es": "Ancho de cuello (mm)"
      },
      "tooltip": {
        "en": "Base neck opening",
        "es": "Abertura base de cuello"
      }
    },
    {
      "id": "cowl_drop",
      "type": "slider",
      "group": "fit",
      "default": 150,
      "min": 60,
      "max": 300,
      "step": 10,
      "label": {
        "en": "Cowl depth (mm)",
        "es": "Profundidad del cowl (mm)"
      },
      "tooltip": {
        "en": "How deep the cowl folds",
        "es": "Cuánto cae el cowl"
      }
    },
    {
      "id": "cowl_rise",
      "type": "slider",
      "group": "fit",
      "default": 90,
      "min": 30,
      "max": 200,
      "step": 10,
      "label": {
        "en": "Cowl rise (mm)",
        "es": "Elevación del cowl (mm)"
      },
      "tooltip": {
        "en": "Extra height above the shoulder",
        "es": "Altura extra sobre el hombro"
      }
