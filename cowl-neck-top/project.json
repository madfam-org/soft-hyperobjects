    {
      "id": "sleeve_grown",
      "type": "slider",
      "group": "fit",
      "default": 150,
      "min": 60,
      "max": 260,
      "step": 10,
      "label": {
        "en": "Grown sleeve (mm)",
        "es": "Manga nacida (mm)"
