      "tooltip": {
        "en": "Grown-on cap sleeve",
        "es": "Manga nacida"
      }
    },
    {
      "id": "ease",
      "type": "slider",
      "group": "fit",
      "default": 120,
      "min": 40,
      "max": 360,
      "step": 10,
      "label": {
        "en": "Fit ease (mm)",
        "es": "Holgura (mm)"
      },
      "tooltip": {
        "en": "Soft ease",
        "es": "Holgura suave"
      }
    }
  ],
  "presets": [
    {
      "id": "soft",
      "label": {
        "en": "Soft cowl",
        "es": "Cowl suave"
      },
      "values": {
        "cowl_rise": 90,
        "cowl_drop": 150
      }
    },
    {
      "id": "deep",
      "label": {
        "en": "Deep cowl",
        "es": "Cowl profundo"
      },
      "values": {
        "cowl_rise": 150,
        "cowl_drop": 240
      }
    }
  ],
  "export_formats": [
    "svg",
    "dxf",
    "json"
  ],
  "fabrics": [],
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "garment",
    "interfaces": [
      {
        "id": "shoulder_seam",
        "type": "shoulder",
        "label": {
          "en": "Shoulder seam",
          "es": "Costura de hombro"
        },
        "edges": [
          {
            "piece": "front",
            "edge": "shoulder"
          },
          {
            "piece": "back",
            "edge": "shoulder"
          }
        ],
        "parameters": [
          "neck_width",
          "chest_girth"
        ]
      },
      {
        "id": "side_seam",
        "type": "side_seam",
        "label": {
          "en": "Side seam",
          "es": "Costura lateral"
        },
        "edges": [
          {
            "piece": "front",
            "edge": "side"
          },
          {
            "piece": "back",
            "edge": "side"
          }
        ],
        "parameters": [
          "top_length"
        ]
      }
    ],
    "capabilities": {
      "made_to_measure": true,
      "fold_cutting": true,
      "fabric_compensation": false
    },
    "societal_benefit": {
      "en": "An open, made-to-measure cowl top gets its drape from the front's own folded facing rather than a separate collar, so a draped neckline becomes a single-fabric, easy-to-cut commons object sized to the wearer.",
      "es": "Un top cowl abierto y a la medida obtiene su drapeado de la vista doblada del propio frente en lugar de un cuello aparte, de modo que un escote drapeado se vuelve un objeto común de una sola tela, fácil de cortar y ajustado a quien lo viste."
    },
