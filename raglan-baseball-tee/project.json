  "constraints": [
    {
      "expression": "sleeve_length >= (chest_girth + knit_ease) * 0.24 + 100",
      "severity": "warning",
      "message": {
        "en": "Sleeve too short for this chest — the raglan underarm would reach the sleeve hem; lengthen the sleeve",
        "es": "Manga demasiado corta para este pecho — la sisa raglán alcanzaría el dobladillo; alarga la manga",
        "fr": "Manche trop courte pour cette poitrine — l'aisselle raglan atteindrait l'ourlet de manche ; rallongez la manche"
      }
    },
    {
      "expression": "neck_girth >= raglan_neck_w * 8",
      "severity": "warning",
      "message": {
        "en": "Raglan points sit very wide for this neck girth; the neckline will distort",
        "es": "Los puntos raglán quedan muy anchos para este contorno de cuello; el escote se deformará",
        "fr": "Les points raglan tombent très larges pour ce tour d'encolure ; l'encolure se déformera"
      }
    }
  ],
