{
  "project": {
    "name": "Drawcord Anchor",
    "slug": "drawcord-anchor",
    "version": "0.1.0",
    "engine": "fc",
    "description": {
      "en": "A Yantra4D-bridged notion: the placement guide for the exit + cord-lock anchor for a hood, hem, or waist drawcord. Fashion Cabinet owns the placement; the finding SOLID is the Yantra4D `cord-lock` cartridge, referenced through notion.hardware_ref.\n\nOfficial visualizer and configurator: Fashion Cabinet",
      "es": "Un avío puenteado con Yantra4D: la guía de colocación para the exit + cord-lock anchor for a hood, hem, or waist drawcord. Fashion Cabinet posee la colocación; el SÓLIDO del avío es el cartucho `cord-lock` de Yantra4D, referenciado por notion.hardware_ref.\n\nVisualizador y configurador oficial: Fashion Cabinet"
    },
    "difficulty": "beginner",
    "tags": [
      "drawcord",
      "cord-lock",
      "anchor",
      "notion",
      "hardware",
      "finding",
      "hyperobject",
      "commons"
    ],
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "LicenseRef-FC1-pending",
      "lineage": [
        {
          "source": "Original draft for Fashion Cabinet",
          "license": "original"
        }
      ]
    }
  },
  "modes": [
    {
      "id": "placement-guide",
      "label": {
        "en": "Placement Guide",
        "es": "Guía de colocación"
      },
      "script_file": "main.py",
      "pieces": [
        "placement-guide"
      ]
    }
  ],
  "pieces": [
    {
      "id": "placement-guide",
      "label": {
        "en": "Drawcord Anchor Placement Guide",
        "es": "Guía de Drawcord Anchor"
      },
      "default_color": "#8a8f94",
      "cut": {
        "quantity": 1,
        "on_fold": false,
        "mirror": false
      }
    }
  ],
  "parameters": [
    {
      "id": "cord_dia",
      "type": "slider",
      "default": 4,
      "min": 2,
      "max": 10,
      "step": 0.5,
      "label": {
        "en": "Drawcord diameter (mm)",
        "es": "Diámetro de cordón (mm)"
      }
    },
    {
      "id": "count",
      "type": "slider",
      "default": 2,
      "min": 1,
      "max": 8,
      "step": 1,
      "label": {
        "en": "Number of anchors",
        "es": "Número de anclajes"
      }
    },
    {
      "id": "run_length",
      "type": "slider",
      "default": 200,
      "min": 40,
      "max": 800,
      "step": 5,
      "label": {
        "en": "Placement run (mm)",
        "es": "Largo de la línea (mm)"
      }
    },
    {
      "id": "end_offset",
      "type": "slider",
      "default": 15,
      "min": 5,
      "max": 100,
      "step": 1,
      "label": {
        "en": "End inset (mm)",
        "es": "Margen extremo (mm)"
      }
    }
  ],
  "presets": [
    {
      "id": "default",
      "label": {
        "en": "Default",
        "es": "Predeterminado"
      },
      "values": {
        "cord_dia": 4
      }
    }
  ],
  "export_formats": [
    "svg",
    "dxf",
    "json"
  ],
  "fabrics": [],
  "notion": {
    "kind": "custom",
    "subtype": "drawcord anchor placement",
    "hardware_ref": {
      "platform": "yantra4d",
      "project_slug": "cord-lock",
      "linked": true,
      "params_map": {
        "cord_dia": "cord_dia"
      }
    }
  },
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "notion",
    "interfaces": [
      {
        "id": "placement_line",
        "type": "custom",
        "label": {
          "en": "Fastener placement line",
          "es": "Línea de colocación"
        },
        "edges": [
          {
            "piece": "placement-guide",
            "edge": "guide"
          }
        ],
        "parameters": [
          "cord_dia",
          "count",
          "run_length"
        ]
      }
    ],
    "capabilities": {
      "made_to_measure": true,
      "fold_cutting": false,
      "fabric_compensation": false,
      "hardware_bridge": true
    },
    "societal_benefit": {
      "en": "Turns the exit + cord-lock anchor for a hood, hem, or waist drawcord into an open, made-to-measure placement guide with the printable finding an open Yantra4D object — repairable and free.",
      "es": "Convierte the exit + cord-lock anchor for a hood, hem, or waist drawcord en una guía de colocación abierta y a la medida con el avío imprimible como objeto abierto de Yantra4D — reparable y libre."
    },
    "commons_license": "LicenseRef-FC1-pending"
  }
}
