  "constraints": [
    {
      "expression": "button_stand >= 25",
      "severity": "warning",
      "message": {
        "en": "Narrow button stands crowd standard 11.5 mm shirt buttons",
        "es": "Tapetas angostas aprietan los botones de camisa estándar de 11.5 mm",
        "fr": "Des pattes de boutonnage étroites serrent les boutons de chemise standard de 11,5 mm"
      }
    },
    {
      "expression": "yoke_drop >= 60",
      "severity": "warning",
      "message": {
        "en": "Very shallow yokes leave no room for the back neck curve",
        "es": "Canesús muy bajos no dejan espacio para la curva del escote trasero",
        "fr": "Des empiècements très peu profonds ne laissent aucune place pour la courbe d'encolure dos"
      }
    }
  ],
