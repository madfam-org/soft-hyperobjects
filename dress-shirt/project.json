    "svg",
    "dxf",
    "json",
    "pdf"
  ],
  "fabrics": [
    "popelina-algodon"
  ],
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "garment",
    "interfaces": [
      {
        "id": "neckline",
        "type": "neckline",
        "edges": [
          {
            "piece": "front",
            "edge": "neck"
          },
          {
            "piece": "yoke",
            "edge": "neck"
          }
        ],
        "parameters": [
          "neck_girth"
        ]
      },
      {
        "id": "armscye",
        "type": "armscye",
        "edges": [
          {
            "piece": "front",
            "edge": "armhole"
          },
          {
            "piece": "back",
            "edge": "armhole"
          }
        ],
        "parameters": [
          "chest_girth",
          "woven_ease"
        ]
      },
      {
        "id": "cuff",
        "type": "cuff",
        "edges": [
          {
            "piece": "sleeve",
            "edge": "hem"
          }
        ],
        "parameters": [
          "wrist_opening"
        ]
      },
      {
        "id": "button_stand",
        "type": "button_stand",
        "edges": [
          {
            "piece": "front",
            "edge": "center"
          }
        ],
        "parameters": [
          "button_stand",
          "body_length"
        ]
      }
    ],
    "capabilities": {
      "made_to_measure": true,
      "fold_cutting": true,
      "fabric_compensation": false,
      "knit_negative_ease": false
    },
    "societal_benefit": {
      "en": "The wardrobe's formal workhorse — and the cartridge that proves chained derivation: the collar stand is computed from the measured neckline, then the collar fall from the stand's own measured edge, so every derived piece stays true when the body measurements change.",
      "es": "El caballo de batalla formal del guardarropa — y el cartucho que demuestra la derivación en cadena: el pie de cuello se calcula del escote medido y la caída del cuello del borde medido del propio pie, de modo que cada pieza derivada sigue siendo fiel cuando cambian las medidas del cuerpo.",
      "fr": "La bête de somme habillée du vestiaire — et la cartouche qui prouve la dérivation enchaînée : le pied de col est calculé à partir de l'encolure mesurée, puis le tombant du col à partir du propre bord mesuré du pied, de sorte que chaque pièce dérivée reste fidèle quand les mesures du corps changent."
    },
