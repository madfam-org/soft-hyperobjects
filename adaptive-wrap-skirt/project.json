{
  "project": {
    "name": "Adaptive Wrap Skirt",
    "slug": "adaptive-wrap-skirt",
    "version": "0.1.0",
    "engine": "fc",
    "description": {
      "en": "A wrap skirt that closes with magnetic clasps instead of ties or buttons — a wide-wrap A-line panel whose overlap and waistband snap shut, so it fastens one-handed, seated, or with limited fine-motor control. The magnetic-clasp solid bridges to Yantra4D `magnetic-clasp`. FC-200 long-tail (adaptive).\n\nOfficial visualizer and configurator: Fashion Cabinet",
      "es": "Una falda cruzada que cierra con broches magnéticos en vez de lazos o botones — un panel amplio en A cuyo cruce y pretina se cierran a presión, para abrocharla con una mano, sentado o con motricidad fina limitada. El broche se puentea al `magnetic-clasp` de Yantra4D. Cola larga FC-200 (adaptativo).\n\nVisualizador y configurador oficial: Fashion Cabinet"
    },
    "difficulty": "beginner",
    "tags": ["adaptive", "inclusive", "skirt", "wrap", "magnetic", "hardware", "commons", "made-to-measure"],
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "LicenseRef-FC1-pending",
      "lineage": [{ "source": "Original draft for Fashion Cabinet", "license": "original" }]
    }
  },
  "modes": [
    { "id": "set", "label": { "en": "Full Skirt", "es": "Falda completa" }, "script_file": "main.py", "pieces": ["panel", "band"] }
  ],
  "pieces": [
    { "id": "panel", "label": { "en": "Wrap panel", "es": "Panel cruzado" }, "default_color": "#7a6a5a", "cut": { "quantity": 1, "on_fold": false, "mirror": false } },
    { "id": "band", "label": { "en": "Waistband (clasps)", "es": "Pretina (broches)" }, "default_color": "#6a5a4a", "cut": { "quantity": 1, "on_fold": false, "mirror": false } }
  ],
  "parameters": [
    { "id": "waist_girth", "type": "slider", "default": 780, "min": 550, "max": 1400, "step": 10, "measurement": { "standard": "iso_8559", "code": "waist_girth" }, "label": { "en": "Waist girth (mm)", "es": "Contorno de cintura (mm)" }, "tooltip": { "en": "Fitted waist", "es": "Cintura ajustada" } },
    { "id": "hip_girth", "type": "slider", "default": 980, "min": 650, "max": 1500, "step": 10, "measurement": { "standard": "iso_8559", "code": "hip_girth" }, "label": { "en": "Hip girth (mm)", "es": "Contorno de cadera (mm)" }, "tooltip": { "en": "Full hip", "es": "Cadera completa" } },
    { "id": "skirt_length", "type": "slider", "default": 620, "min": 300, "max": 1100, "step": 10, "label": { "en": "Length (mm)", "es": "Largo (mm)" }, "tooltip": { "en": "Waist to hem", "es": "De la cintura al ruedo" } },
    { "id": "wrap_overlap", "type": "slider", "default": 280, "min": 150, "max": 450, "step": 10, "label": { "en": "Wrap overlap (mm)", "es": "Cruce (mm)" }, "tooltip": { "en": "How far the wrap crosses over", "es": "Cuánto cruza el envolvente" } },
    { "id": "band_height", "type": "slider", "default": 45, "min": 25, "max": 90, "step": 5, "label": { "en": "Waistband height (mm)", "es": "Alto de pretina (mm)" }, "tooltip": { "en": "Finished band height", "es": "Alto terminado de la pretina" } },
    { "id": "clasps", "type": "slider", "default": 3, "min": 2, "max": 8, "step": 1, "label": { "en": "Magnetic clasps", "es": "Broches magnéticos" }, "tooltip": { "en": "At the wrap overlap; sets the Yantra4D count", "es": "En el cruce; define la cantidad de Yantra4D" } }
  ],
  "presets": [
    { "id": "everyday", "label": { "en": "Everyday", "es": "Diario" }, "values": { "skirt_length": 620, "clasps": 3 } },
    { "id": "midi", "label": { "en": "Midi", "es": "Midi" }, "values": { "skirt_length": 820, "clasps": 4 } }
  ],
