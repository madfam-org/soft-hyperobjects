    {
      "id": "body_length",
      "type": "slider",
      "default": 720,
      "min": 400,
      "max": 1000,
      "step": 10,
      "group": "body",
      "label": {
        "en": "Body length, nape to hem (mm)",
        "es": "Largo de cuerpo, nuca a dobladillo (mm)",
        "fr": "Longueur du corps, nuque à l'ourlet (mm)",
        "pt": "Comprimento, nuca à barra (mm)"
      }
    },
    {
      "id": "neck_girth",
      "type": "slider",
      "default": 380,
      "min": 300,
      "max": 520,
      "step": 5,
      "group": "body",
      "measurement": {
        "standard": "iso_8559",
        "code": "neck_girth"
      },
      "label": {
        "en": "Neck girth (mm)",
        "es": "Contorno de cuello (mm)",
        "fr": "Tour de cou (mm)",
        "pt": "Contorno de pescoço (mm)"
      }
    },
    {
      "id": "sleeve_length",
      "type": "slider",
      "default": 220,
      "min": 80,
      "max": 700,
      "step": 5,
      "group": "body",
      "label": {
        "en": "Sleeve length, shoulder to hem (mm)",
        "es": "Largo de manga, hombro a dobladillo (mm)",
        "fr": "Longueur de manche, épaule à l'ourlet (mm)",
        "pt": "Comprimento da manga, ombro à barra (mm)"
      }
    },
    {
      "id": "knit_ease",
      "type": "slider",
      "default": 60,
      "min": -80,
      "max": 300,
      "step": 10,
      "group": "fit",
      "label": {
        "en": "Total ease (mm, negative = compression)",
        "es": "Holgura total (mm, negativa = compresión)",
        "fr": "Aisance totale (mm, négative = compression)",
        "pt": "Folga total (mm, negativa = compressão)"
      }
    },
    {
      "id": "armhole_depth",
      "type": "slider",
      "default": 0,
      "min": 0,
      "max": 350,
      "step": 5,
      "group": "fit",
      "advanced": true,
      "label": {
        "en": "Armhole depth (mm, 0 = auto)",
        "es": "Profundidad de sisa (mm, 0 = auto)",
        "fr": "Profondeur d'emmanchure (mm, 0 = auto)",
        "pt": "Profundidade de cava (mm, 0 = automático)"
      }
    },
    {
      "id": "sleeve_opening",
      "type": "slider",
      "default": 0,
      "min": 0,
      "max": 500,
      "step": 5,
      "group": "fit",
      "advanced": true,
      "label": {
        "en": "Sleeve opening, flat (mm, 0 = auto)",
        "es": "Abertura de manga, extendida (mm, 0 = auto)",
        "fr": "Ouverture de manche, à plat (mm, 0 = auto)",
        "pt": "Abertura da manga, plana (mm, 0 = automático)"
      }
    },
    {
      "id": "neckband_ratio",
      "type": "slider",
      "default": 0.85,
      "min": 0.7,
      "max": 1.0,
      "step": 0.01,
      "group": "construction",
      "advanced": true,
      "label": {
        "en": "Neckband/opening ratio",
        "es": "Proporción cuello/abertura",
        "fr": "Proportion col/ouverture",
        "pt": "Proporção gola/abertura"
      }
    },
    {
      "id": "neckband_width",
      "type": "slider",
      "default": 20,
      "min": 10,
      "max": 40,
      "step": 1,
      "group": "construction",
      "label": {
        "en": "Neckband finished width (mm)",
        "es": "Ancho terminado del cuello (mm)",
        "fr": "Largeur finie du col (mm)",
        "pt": "Largura acabada da gola (mm)"
      }
    },
    {
      "id": "seam_allowance",
      "type": "slider",
      "default": 7,
      "min": 0,
      "max": 20,
      "step": 1,
      "group": "construction",
      "label": {
        "en": "Seam allowance (mm)",
        "es": "Margen de costura (mm)",
        "fr": "Marge de couture (mm)",
        "pt": "Margem de costura (mm)"
      }
    },
    {
      "id": "hem_allowance",
