{
  "project": {
    "name": "T-shirt (Crew Neck)",
    "slug": "t-shirt-crew",
    "version": "0.1.0",
    "engine": "fc",
    "description": {
      "en": "FC-100 rank #1 — the most-produced garment on earth, parametric. Front and back cut on fold, a sleeve whose cap is solved numerically to match the front + back armholes, and a rib neckband derived from the measured neck opening. Relaxed drop-shoulder knit draft with jersey-appropriate allowances.\n\nOfficial visualizer and configurator: Fashion Cabinet",
      "es": "Rango #1 del FC-100 — la prenda más producida del planeta, paramétrica. Delantero y trasero cortados al doblez, una manga cuya copa se resuelve numéricamente para coincidir con las sisas delantera + trasera, y un cuello de rib derivado de la abertura medida del escote. Trazo de punto con hombro caído y márgenes para jersey.\n\nVisualizador y configurador oficial: Fashion Cabinet",
      "fr": "FC-100 rang n°1 — le vêtement le plus produit sur terre, paramétrique. Devant et Dos coupés au pli, une Manche dont la tête est résolue numériquement pour s'accorder aux Emmanchures devant + dos, et une encolure côtelée dérivée de l'ouverture d'Encolure mesurée. Tracé maille détendu à épaule tombante avec Marges de couture adaptées au jersey.\n\nVisualiseur et configurateur officiel : Fashion Cabinet",
      "pt": "Posto #1 do FC-100 — a peça mais produzida do planeta, paramétrica. Frente e costas cortadas na dobra, uma manga cuja cabeça é resolvida numericamente para casar com as cavas da frente + das costas, e uma gola canelada derivada da abertura de pescoço medida. Traçado de malha solto, de ombro caído, com margens próprias para jérsei.\n\nVisualizador e configurador oficial: Fashion Cabinet"
    },
    "difficulty": "beginner",
    "tags": [
      "t-shirt",
      "tee",
      "knit",
      "fc100",
      "hyperobject",
      "commons"
    ],
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "CERN-OHL-W-2.0",
      "lineage": [
        {
          "source": "Original draft for Fashion Cabinet; relaxed drop-shoulder knit block from standard industry practice",
          "license": "original"
        }
      ]
    }
  },
  "modes": [
    {
      "id": "tee",
      "label": {
        "en": "T-shirt (all pieces)",
        "es": "Playera (todas las piezas)",
        "fr": "T-shirt (toutes les pièces)",
        "pt": "Camiseta (todas as peças)"
      },
      "script_file": "main.py",
      "pieces": [
        "front",
        "back",
        "sleeve",
        "neckband"
      ]
    }
  ],
  "pieces": [
    {
      "id": "front",
      "label": {
        "en": "Front",
        "es": "Delantero",
        "fr": "Devant",
        "pt": "Frente"
      },
      "default_color": "#4a8fc9",
      "cut": {
        "quantity": 1,
        "on_fold": true,
        "mirror": true
      }
    },
    {
      "id": "back",
      "label": {
        "en": "Back",
        "es": "Trasero",
        "fr": "Dos",
        "pt": "Costas"
      },
      "default_color": "#3a6f9f",
      "cut": {
        "quantity": 1,
        "on_fold": true,
        "mirror": true
      }
    },
    {
      "id": "sleeve",
      "label": {
        "en": "Sleeve",
        "es": "Manga",
        "fr": "Manche",
        "pt": "Manga"
      },
      "default_color": "#6aa4d4",
      "cut": {
        "quantity": 2,
        "mirror": true
      }
    },
    {
      "id": "neckband",
      "label": {
        "en": "Neckband (rib)",
        "es": "Cuello (rib)",
        "fr": "Col bord-côte (rib)",
        "pt": "Gola (canelado)"
      },
      "default_color": "#8fb8dc",
      "cut": {
        "quantity": 1
      }
    }
  ],
  "parameter_groups": [
    {
      "id": "body",
      "label": {
        "en": "Body Measurements",
        "es": "Medidas Corporales",
        "fr": "Mesures corporelles",
        "pt": "Medidas Corporais"
      }
    },
    {
      "id": "fit",
      "label": {
        "en": "Fit & Style",
        "es": "Ajuste y Estilo",
        "fr": "Ajustement et style",
        "pt": "Caimento e Estilo"
      }
    },
    {
      "id": "construction",
      "label": {
        "en": "Construction",
        "es": "Construcción",
        "fr": "Montage",
        "pt": "Construção"
      }
    }
  ],
  "parameters": [
    {
      "id": "chest_girth",
      "type": "slider",
      "default": 980,
      "min": 600,
      "max": 1800,
      "step": 10,
      "group": "body",
      "measurement": {
        "standard": "iso_8559",
        "code": "chest_bust_girth"
