  "constraints": [
    {
      "expression": "knit_ease >= -80",
      "severity": "warning",
      "message": {
        "en": "Strong compression fits depend on fabric stretch; check the fabric card",
        "es": "Los ajustes de compresión dependen del estiramiento de la tela; revisa la ficha de tela",
        "fr": "Les coupes très compressives dépendent de l'élasticité du tissu ; vérifiez la fiche du tissu",
        "pt": "Caimentos de compressão forte dependem da elasticidade do tecido; verifique a ficha do tecido"
      }
    },
    {
      "expression": "sleeve_length <= body_length",
      "severity": "warning",
      "message": {
        "en": "Sleeve longer than the body — intentional only for wrap styles",
        "es": "Manga más larga que el cuerpo — solo intencional en estilos envolventes",
        "fr": "Manche plus longue que le corps — intentionnel uniquement pour les styles portefeuille",
        "pt": "Manga mais longa que o corpo — só é intencional em modelos transpassados"
      }
    }
  ],
