    "jersey-algodon"
  ],
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "garment",
    "interfaces": [
      {
        "id": "neckline",
        "type": "neckline",
        "edges": [
          {
            "piece": "front",
            "edge": "neck"
          },
          {
            "piece": "back",
            "edge": "neck"
          }
        ],
        "parameters": [
          "neck_girth",
          "neckband_ratio"
        ]
      },
      {
        "id": "armscye",
        "type": "armscye",
        "edges": [
          {
            "piece": "front",
            "edge": "armhole"
          },
          {
            "piece": "back",
            "edge": "armhole"
          },
          {
            "piece": "sleeve",
            "edge": "cap"
          }
        ],
        "parameters": [
          "armhole_depth",
          "chest_girth",
          "knit_ease"
        ]
      },
      {
        "id": "hem",
        "type": "hem",
        "edges": [
          {
            "piece": "front",
            "edge": "hem"
          },
          {
            "piece": "back",
            "edge": "hem"
          }
        ],
        "parameters": [
          "body_length",
          "hem_allowance"
        ]
      }
    ],
    "capabilities": {
      "made_to_measure": true,
      "fold_cutting": true,
      "fabric_compensation": false,
      "knit_negative_ease": true
    },
    "societal_benefit": {
      "en": "The t-shirt is the world's default garment; a verified parametric block makes made-to-measure basics accessible to anyone with fabric and a cutter, and gives the rest of the FC-100 its simplest teaching example of solved seam matching.",
      "es": "La playera es la prenda por defecto del mundo; un bloque paramétrico verificado hace accesibles los básicos a medida a cualquiera con tela y cortadora, y da al resto del FC-100 su ejemplo más simple de costuras resueltas.",
      "fr": "Le t-shirt est le vêtement par défaut du monde ; un bloc paramétrique vérifié rend les basiques sur mesure accessibles à quiconque dispose de tissu et d'un cutter, et donne au reste du FC-100 son exemple pédagogique le plus simple de correspondance de couture résolue.",
      "pt": "A camiseta é a peça padrão do mundo; um molde base paramétrico verificado torna os básicos sob medida acessíveis a qualquer pessoa com tecido e uma tesoura, e dá ao resto do FC-100 seu exemplo didático mais simples de casamento de costuras resolvido."
    },
