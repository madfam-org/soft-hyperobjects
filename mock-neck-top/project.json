  "export_formats": [
    "svg",
    "dxf",
    "json"
  ],
  "fabrics": [],
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "garment",
    "interfaces": [
      {
        "id": "shoulder_seam",
        "type": "shoulder",
        "label": {
          "en": "Shoulder seam",
          "es": "Costura de hombro",
          "fr": "Couture d'épaule"
        },
        "edges": [
          {
            "piece": "front",
            "edge": "shoulder"
          },
          {
            "piece": "back",
            "edge": "shoulder"
          }
        ],
        "parameters": [
          "neck_width",
          "chest_girth"
        ]
      },
      {
        "id": "side_seam",
        "type": "side_seam",
        "label": {
          "en": "Side seam",
          "es": "Costura lateral",
          "fr": "Couture latérale"
        },
        "edges": [
          {
            "piece": "front",
            "edge": "side"
          },
          {
            "piece": "back",
            "edge": "side"
          }
        ],
        "parameters": [
          "top_length"
        ]
      },
      {
        "id": "neck_band",
        "type": "neckline",
        "label": {
          "en": "Mock-neck band",
          "es": "Banda de cuello mock",
          "fr": "Bande de col montant"
        },
        "edges": [
          {
            "piece": "band",
            "edge": "attach"
          },
          {
            "piece": "front",
            "edge": "neck"
          }
        ],
        "parameters": [
          "neck_width",
          "mock_height"
        ]
      }
    ],
    "capabilities": {
      "made_to_measure": true,
      "fold_cutting": true,
      "fabric_compensation": false
    },
    "societal_benefit": {
      "en": "An open, made-to-measure mock-neck top solves the neckband length from the wearer's own neckline so the collar sits clean, turning a knit staple into a repeatable commons object without factory grading.",
      "es": "Un top de cuello mock abierto y a la medida resuelve el largo de la banda a partir del escote de quien lo viste para que el cuello asiente limpio, convirtiendo un básico de punto en un objeto común repetible sin escalado de fábrica.",
      "fr": "Un haut à col mock ouvert et sur mesure résout la longueur de la bande d'encolure à partir de l'encolure propre de qui le porte pour que le col repose net, transformant un basique en maille en un objet du commons reproductible sans gradation industrielle."
    },
    "commons_license": "CERN-OHL-W-2.0"
  }
}
