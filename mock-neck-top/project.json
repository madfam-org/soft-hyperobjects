      "default": 170,
      "min": 130,
      "max": 300,
      "step": 5,
      "label": {
        "en": "Neck width (mm)",
        "es": "Ancho de cuello (mm)",
        "fr": "Largeur d'encolure (mm)"
      },
      "tooltip": {
        "en": "Jewel neck width",
        "es": "Ancho de escote redondo",
        "fr": "Largeur d'encolure ras-du-cou"
      }
    },
    {
      "id": "mock_height",
      "type": "slider",
      "group": "construction",
      "default": 60,
      "min": 35,
      "max": 110,
      "step": 5,
      "label": {
        "en": "Mock height (mm)",
        "es": "Alto del mock (mm)",
        "fr": "Hauteur de col montant (mm)"
      },
      "tooltip": {
        "en": "Stand height (short — not a turtleneck)",
        "es": "Altura del cuello (corto — no tortuga)",
        "fr": "Hauteur du col droit (court — pas un col roulé)"
      }
    },
    {
      "id": "sleeve_grown",
      "type": "slider",
      "group": "fit",
      "default": 150,
      "min": 60,
      "max": 260,
      "step": 10,
      "label": {
