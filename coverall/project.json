  "constraints": [
    {
      "expression": "back_rise >= front_rise",
      "severity": "warning",
      "message": {
        "en": "A back rise below the front rise is clamped up to the front rise by the draft",
        "es": "Un tiro trasero menor al delantero se eleva al tiro delantero en el trazo"
      }
    },
    {
      "expression": "waist_girth <= chest_girth + 200",
      "severity": "warning",
      "message": {
        "en": "A waist much larger than the chest fights the fitted bodice side taper; add ease instead",
        "es": "Una cintura mucho mayor al pecho pelea con el entalle del talle; añade holgura en su lugar"
      }
    },
    {
      "expression": "coverall_ease >= 120",
      "severity": "warning",
      "message": {
        "en": "A work coverall needs generous ease to move and layer under; below ~120 mm it binds at the action back",
        "es": "Un overol de trabajo necesita holgura para moverse y llevar capas; debajo de ~120 mm se restringe en la espalda de acción"
      }
    }
  ],
