{
  "project": {
    "name": "Handkerchief Skirt",
    "slug": "handkerchief-skirt",
    "version": "0.1.0",
    "engine": "fc",
    "description": {
      "en": "The pointed-hem handkerchief skirt: square-ish panels hung from a solved circular waist arc so their outer corners drop into handkerchief points below the side hem. Distinct from FC-100's straight/gathered skirts — the points are the square geometry, not shaping. A soft-goods garment — a side zip is the maker's hardware. FC-200 long-tail (skirt gap).\n\nOfficial visualizer and configurator: Fashion Cabinet",
      "es": "La falda de puntas (handkerchief): paneles casi cuadrados colgados de un arco de cintura circular resuelto para que sus esquinas exteriores caigan en puntas por debajo del ruedo lateral. Distinta de las faldas rectas/fruncidas de FC-100 — las puntas son la geometría del cuadrado, no el moldeado. Una prenda textil — la cremallera lateral es herraje de quien elabora. Cola larga FC-200 (hueco de falda).\n\nVisualizador y configurador oficial: Fashion Cabinet",
      "fr": "La jupe à pointes (mouchoir) : des panneaux presque carrés suspendus à un arc de taille circulaire résolu pour que leurs coins extérieurs tombent en pointes sous l'ourlet latéral. Distincte des jupes droites/froncées de FC-100 — les pointes sont la géométrie du carré, non la mise en forme. Un vêtement textile — une fermeture latérale est la quincaillerie du fabricant. Longue traîne FC-200 (manque jupe).\n\nVisualiseur et configurateur officiel : Fashion Cabinet"
    },
    "difficulty": "intermediate",
    "tags": [
      "handkerchief-skirt",
      "skirt",
      "pointed-hem",
      "asymmetric",
      "commons",
      "made-to-measure"
    ],
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "CERN-OHL-W-2.0",
      "lineage": [
        {
          "source": "Original draft for Fashion Cabinet",
          "license": "original"
        }
      ]
    }
  },
  "modes": [
    {
      "id": "set",
      "label": {
        "en": "Full Skirt",
        "es": "Falda completa",
        "fr": "Jupe complète"
      },
      "script_file": "main.py",
      "pieces": [
        "panel",
        "waistband"
      ]
    }
  ],
  "pieces": [
    {
      "id": "panel",
      "label": {
        "en": "Panel (front + back)",
        "es": "Panel (frente + espalda)",
        "fr": "Panneau (devant + dos)"
      },
      "default_color": "#5a6a6a",
      "cut": {
        "quantity": 2,
        "on_fold": true,
        "fold_edge": "center",
        "mirror": true
      }
    },
    {
      "id": "waistband",
      "label": {
        "en": "Waistband",
        "es": "Pretina",
        "fr": "Ceinture"
      },
      "default_color": "#4a5a5a",
      "cut": {
        "quantity": 1
      }
    }
  ],
  "parameter_groups": [
    {
      "id": "body",
      "label": {
        "en": "Body Measurements",
        "es": "Medidas Corporales",
        "fr": "Mesures du corps"
      }
    },
    {
      "id": "fit",
      "label": {
        "en": "Fit & Style",
        "es": "Ajuste y Estilo",
        "fr": "Coupe et style"
      }
    },
    {
      "id": "construction",
      "label": {
        "en": "Construction",
        "es": "Construcción",
        "fr": "Construction"
      }
    }
  ],
  "parameters": [
    {
      "id": "waist_girth",
      "type": "slider",
      "group": "body",
      "default": 760,
      "min": 520,
      "max": 1300,
      "step": 10,
      "measurement": {
        "standard": "iso_8559",
        "code": "waist_girth"
      },
      "label": {
        "en": "Waist girth (mm)",
        "es": "Contorno de cintura (mm)",
        "fr": "Tour de taille (mm)"
      },
      "tooltip": {
        "en": "Fitted waist",
        "es": "Cintura ajustada",
        "fr": "Taille ajustée"
      }
    },
    {
      "id": "point_drop",
      "type": "slider",
      "group": "fit",
      "default": 620,
      "min": 300,
      "max": 1100,
      "step": 10,
      "label": {
        "en": "Point drop (mm)",
        "es": "Caída de punta (mm)",
        "fr": "Chute de pointe (mm)"
      },
      "tooltip": {
        "en": "Length to the handkerchief points",
        "es": "Largo hasta las puntas",
        "fr": "Longueur jusqu'aux pointes"
      }
    },
    {
      "id": "band_height",
      "type": "slider",
      "group": "construction",
      "default": 40,
      "min": 20,
      "max": 90,
      "step": 5,
      "label": {
        "en": "Waistband height (mm)",
        "es": "Alto de pretina (mm)",
        "fr": "Hauteur de ceinture (mm)"
      },
      "tooltip": {
        "en": "Finished band height",
        "es": "Alto de pretina terminada",
        "fr": "Hauteur de ceinture finie"
      }
    }
  ],
  "presets": [
