      "type": "slider",
      "default": 560,
      "min": 200,
      "max": 760,
      "step": 10,
      "label": {
        "en": "Sleeve length to cuff seam (mm)",
        "es": "Largo de manga hasta puño (mm)",
        "fr": "Longueur de manche jusqu'à la couture du poignet (mm)"
      }
    },
    {
      "id": "fleece_ease",
      "type": "slider",
      "default": 140,
      "min": 40,
      "max": 400,
      "step": 10,
      "label": {
        "en": "Total ease (mm)",
        "es": "Holgura total (mm)",
        "fr": "Aisance totale (mm)"
      }
    },
    {
      "id": "cuff_ratio",
