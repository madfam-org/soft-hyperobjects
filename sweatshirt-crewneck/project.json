    {
      "id": "hemband_height",
      "type": "slider",
      "default": 60,
      "min": 30,
      "max": 100,
      "step": 5,
      "label": {
        "en": "Hem band height (mm)",
        "es": "Alto de pretina (mm)",
        "fr": "Hauteur de bord-côte de bas (mm)"
      }
    },
    {
      "id": "neckband_width",
      "type": "slider",
      "default": 22,
      "min": 12,
      "max": 40,
      "step": 1,
      "label": {
        "en": "Neckband width (mm)",
        "es": "Ancho de cuello (mm)",
        "fr": "Largeur du col (mm)"
      }
    },
    {
      "id": "seam_allowance",
      "type": "slider",
      "default": 8,
      "min": 0,
      "max": 20,
      "step": 1,
      "label": {
        "en": "Seam allowance (mm)",
        "es": "Margen de costura (mm)",
        "fr": "Marge de couture (mm)"
      }
    }
  ],
