      "id": "sweatshirt",
      "label": {
        "en": "Sweatshirt (all pieces)",
        "es": "Sudadera (todas las piezas)",
        "fr": "Sweat-shirt (toutes les pièces)"
      },
      "script_file": "main.py",
      "pieces": [
        "front",
        "back",
        "sleeve",
        "neckband",
        "cuff",
        "hem_band"
      ]
    }
  ],
