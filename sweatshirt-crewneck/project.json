      "default_color": "#b3c0cc",
      "cut": {
        "quantity": 2
      }
    },
    {
      "id": "hem_band",
      "label": {
        "en": "Hem Band (rib)",
        "es": "Pretina (rib)",
        "fr": "Bord-côte de bas (côtes)"
      },
      "default_color": "#b3c0cc",
      "cut": {
        "quantity": 1
      }
    }
  ],
  "parameters": [
    {
      "id": "chest_girth",
      "type": "slider",
      "default": 980,
      "min": 650,
      "max": 1900,
      "step": 10,
      "measurement": {
        "standard": "iso_8559",
        "code": "chest_bust_girth"
      },
      "label": {
        "en": "Chest girth (mm)",
        "es": "Contorno de pecho (mm)",
        "fr": "Tour de poitrine (mm)"
      }
    },
    {
      "id": "body_length",
      "type": "slider",
      "default": 660,
      "min": 420,
      "max": 950,
      "step": 10,
      "label": {
        "en": "Body length to band seam (mm)",
        "es": "Largo de cuerpo hasta pretina (mm)",
        "fr": "Longueur de corps jusqu'à la couture de ceinture (mm)"
      }
    },
    {
      "id": "neck_girth",
      "type": "slider",
      "default": 380,
      "min": 300,
      "max": 520,
      "step": 5,
      "measurement": {
