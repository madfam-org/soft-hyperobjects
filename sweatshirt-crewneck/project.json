{
  "project": {
    "name": "Crewneck Sweatshirt",
    "slug": "sweatshirt-crewneck",
    "version": "0.1.0",
    "engine": "fc",
    "description": {
      "en": "FC-100 rank #6. Boxy fleece crewneck: front/back on fold, long sleeve with the cap solved to the armholes, and neckband, cuffs, and hem band derived from measured openings times rib recovery ratios.\n\nOfficial visualizer and configurator: Fashion Cabinet",
      "es": "Rango #6 del FC-100. Sudadera holgada de felpa: delantero/trasero al doblez, manga larga con copa resuelta a las sisas, y cuello, puños y pretina derivados de aberturas medidas por proporciones de rib.\n\nVisualizador y configurador oficial: Fashion Cabinet"
    },
    "difficulty": "beginner",
    "tags": ["sweatshirt", "crewneck", "fleece", "fc100", "hyperobject", "commons"],
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "LicenseRef-FC1-pending",
      "lineage": [{ "source": "Original draft for Fashion Cabinet", "license": "original" }]
    }
  },
  "modes": [
    {
      "id": "sweatshirt",
      "label": { "en": "Sweatshirt (all pieces)", "es": "Sudadera (todas las piezas)" },
      "script_file": "main.py",
      "pieces": ["front", "back", "sleeve", "neckband", "cuff", "hem_band"]
    }
  ],
  "pieces": [
    { "id": "front", "label": { "en": "Front", "es": "Delantero" }, "default_color": "#7a8a99", "cut": { "quantity": 1, "on_fold": true, "mirror": true } },
    { "id": "back", "label": { "en": "Back", "es": "Trasero" }, "default_color": "#5f6d7a", "cut": { "quantity": 1, "on_fold": true, "mirror": true } },
    { "id": "sleeve", "label": { "en": "Sleeve", "es": "Manga" }, "default_color": "#93a3b3", "cut": { "quantity": 2, "mirror": true } },
    { "id": "neckband", "label": { "en": "Neckband (rib)", "es": "Cuello (rib)" }, "default_color": "#b3c0cc", "cut": { "quantity": 1 } },
    { "id": "cuff", "label": { "en": "Cuff (rib)", "es": "Puño (rib)" }, "default_color": "#b3c0cc", "cut": { "quantity": 2 } },
    { "id": "hem_band", "label": { "en": "Hem Band (rib)", "es": "Pretina (rib)" }, "default_color": "#b3c0cc", "cut": { "quantity": 1 } }
  ],
  "parameters": [
    { "id": "chest_girth", "type": "slider", "default": 980, "min": 650, "max": 1900, "step": 10, "measurement": { "standard": "iso_8559", "code": "chest_bust_girth" }, "label": { "en": "Chest girth (mm)", "es": "Contorno de pecho (mm)" } },
    { "id": "body_length", "type": "slider", "default": 660, "min": 420, "max": 950, "step": 10, "label": { "en": "Body length to band seam (mm)", "es": "Largo de cuerpo hasta pretina (mm)" } },
    { "id": "neck_girth", "type": "slider", "default": 380, "min": 300, "max": 520, "step": 5, "measurement": { "standard": "iso_8559", "code": "neck_girth" }, "label": { "en": "Neck girth (mm)", "es": "Contorno de cuello (mm)" } },
    { "id": "sleeve_length", "type": "slider", "default": 560, "min": 200, "max": 760, "step": 10, "label": { "en": "Sleeve length to cuff seam (mm)", "es": "Largo de manga hasta puño (mm)" } },
    { "id": "fleece_ease", "type": "slider", "default": 140, "min": 40, "max": 400, "step": 10, "label": { "en": "Total ease (mm)", "es": "Holgura total (mm)" } },
    { "id": "cuff_ratio", "type": "slider", "default": 0.78, "min": 0.6, "max": 0.95, "step": 0.01, "advanced": true, "label": { "en": "Cuff/opening ratio", "es": "Proporción puño/abertura" } },
    { "id": "hemband_ratio", "type": "slider", "default": 0.85, "min": 0.7, "max": 1.0, "step": 0.01, "advanced": true, "label": { "en": "Hem band/hem ratio", "es": "Proporción pretina/dobladillo" } },
    { "id": "neckband_ratio", "type": "slider", "default": 0.85, "min": 0.7, "max": 1.0, "step": 0.01, "advanced": true, "label": { "en": "Neckband/opening ratio", "es": "Proporción cuello/abertura" } },
    { "id": "cuff_height", "type": "slider", "default": 60, "min": 30, "max": 100, "step": 5, "label": { "en": "Cuff height (mm)", "es": "Alto de puño (mm)" } },
    { "id": "hemband_height", "type": "slider", "default": 60, "min": 30, "max": 100, "step": 5, "label": { "en": "Hem band height (mm)", "es": "Alto de pretina (mm)" } },
    { "id": "neckband_width", "type": "slider", "default": 22, "min": 12, "max": 40, "step": 1, "label": { "en": "Neckband width (mm)", "es": "Ancho de cuello (mm)" } },
    { "id": "seam_allowance", "type": "slider", "default": 8, "min": 0, "max": 20, "step": 1, "label": { "en": "Seam allowance (mm)", "es": "Margen de costura (mm)" } }
  ],
  "presets": [
    { "id": "size-m", "label": { "en": "M", "es": "M" }, "values": { "chest_girth": 980, "body_length": 660, "sleeve_length": 560 } },
    { "id": "size-l", "label": { "en": "L", "es": "G" }, "values": { "chest_girth": 1060, "body_length": 690, "sleeve_length": 580 } },
    { "id": "oversized", "label": { "en": "Oversized", "es": "Oversize" }, "values": { "chest_girth": 1060, "fleece_ease": 260, "body_length": 700, "sleeve_length": 600 } }
  ],
  "constraints": [
    {
      "expression": "fleece_ease >= 80",
      "severity": "warning",
      "message": { "en": "Fleece needs generous ease; below 80 mm the fit reads compression", "es": "La felpa requiere holgura generosa; debajo de 80 mm el ajuste se siente de compresión" }
    }
  ],
  "export_formats": ["svg", "dxf", "json"],
  "fabrics": ["felpa-algodon"],
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "garment",
    "interfaces": [
      { "id": "neckline", "type": "neckline", "edges": [{ "piece": "front", "edge": "neck" }, { "piece": "back", "edge": "neck" }], "parameters": ["neck_girth", "neckband_ratio"] },
      { "id": "armscye", "type": "armscye", "edges": [{ "piece": "front", "edge": "armhole" }, { "piece": "back", "edge": "armhole" }, { "piece": "sleeve", "edge": "cap" }], "parameters": ["chest_girth", "fleece_ease"] },
      { "id": "cuff", "type": "cuff", "edges": [{ "piece": "sleeve", "edge": "hem" }], "parameters": ["cuff_ratio", "cuff_height"] },
      { "id": "hem", "type": "hem", "edges": [{ "piece": "front", "edge": "hem" }, { "piece": "back", "edge": "hem" }], "parameters": ["hemband_ratio", "hemband_height"] }
    ],
    "capabilities": { "made_to_measure": true, "fold_cutting": true, "fabric_compensation": false, "knit_negative_ease": false },
    "societal_benefit": {
      "en": "The wardrobe's warm default. Three rib bands computed from measured openings make it the commons' reference for ribbed-finish construction — the same rule the hoodie, zip hoodie, and joggers reuse.",
      "es": "El básico abrigador del guardarropa. Tres ribs calculados de aberturas medidas lo vuelven la referencia del commons para acabados en rib — la misma regla que reutilizan la sudadera con capucha, la de cierre y los joggers."
    },
    "commons_license": "LicenseRef-FC1-pending"
  }
}
