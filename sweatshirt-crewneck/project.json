  "constraints": [
    {
      "expression": "fleece_ease >= 80",
      "severity": "warning",
      "message": {
        "en": "Fleece needs generous ease; below 80 mm the fit reads compression",
        "es": "La felpa requiere holgura generosa; debajo de 80 mm el ajuste se siente de compresión",
        "fr": "Le molleton demande une aisance généreuse ; en dessous de 80 mm, la coupe se lit comme de la compression"
      }
    }
  ],
  "export_formats": [
    "svg",
    "dxf",
    "json"
  ],
  "fabrics": [
    "felpa-algodon"
  ],
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "garment",
    "interfaces": [
      {
        "id": "neckline",
        "type": "neckline",
        "edges": [
          {
            "piece": "front",
            "edge": "neck"
          },
          {
            "piece": "back",
            "edge": "neck"
          }
        ],
        "parameters": [
          "neck_girth",
          "neckband_ratio"
        ]
      },
      {
        "id": "armscye",
        "type": "armscye",
        "edges": [
          {
            "piece": "front",
            "edge": "armhole"
          },
          {
            "piece": "back",
            "edge": "armhole"
          },
          {
            "piece": "sleeve",
            "edge": "cap"
          }
        ],
        "parameters": [
          "chest_girth",
          "fleece_ease"
        ]
      },
      {
        "id": "cuff",
        "type": "cuff",
        "edges": [
          {
            "piece": "sleeve",
            "edge": "hem"
          }
        ],
        "parameters": [
          "cuff_ratio",
          "cuff_height"
        ]
      },
      {
        "id": "hem",
        "type": "hem",
        "edges": [
          {
            "piece": "front",
            "edge": "hem"
          },
          {
            "piece": "back",
            "edge": "hem"
          }
        ],
        "parameters": [
          "hemband_ratio",
          "hemband_height"
        ]
      }
    ],
    "capabilities": {
      "made_to_measure": true,
      "fold_cutting": true,
      "fabric_compensation": false,
      "knit_negative_ease": false
    },
    "societal_benefit": {
      "en": "The wardrobe's warm default. Three rib bands computed from measured openings make it the commons' reference for ribbed-finish construction — the same rule the hoodie, zip hoodie, and joggers reuse.",
      "es": "El básico abrigador del guardarropa. Tres ribs calculados de aberturas medidas lo vuelven la referencia del commons para acabados en rib — la misma regla que reutilizan la sudadera con capucha, la de cierre y los joggers.",
      "fr": "Le repli chaud de la garde-robe. Trois bords côtelés calculés depuis les ouvertures mesurées en font la référence du commun pour la construction à finition côtelée — la même règle que réutilisent le sweat à capuche, le sweat à capuche zippé et les joggings."
    },
