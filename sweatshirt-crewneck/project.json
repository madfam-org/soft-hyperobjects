      "default_color": "#93a3b3",
      "cut": {
        "quantity": 2,
        "mirror": true
      }
    },
    {
      "id": "neckband",
      "label": {
        "en": "Neckband (rib)",
        "es": "Cuello (rib)",
        "fr": "Col bord-côte (rib)"
