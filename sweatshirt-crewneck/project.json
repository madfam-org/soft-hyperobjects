      "default_color": "#b3c0cc",
      "cut": {
        "quantity": 1
      }
    },
    {
      "id": "cuff",
      "label": {
        "en": "Cuff (rib)",
        "es": "Puño (rib)",
        "fr": "Poignet (côtes)"
