{
  "project": {
    "name": "Tank Top",
    "slug": "tank-top",
    "version": "0.1.0",
    "engine": "fc",
    "description": {
      "en": "FC-100 rank #8. Sleeveless knit tank with a deep armhole scoop and narrow straps; neck and armhole binding strips are derived from the measured openings times a rib ratio.\n\nOfficial visualizer and configurator: Fashion Cabinet",
      "es": "Rango #8 del FC-100. Camiseta de tirantes de punto con sisa profunda y tirantes angostos; las tiras de vivo del escote y las sisas se derivan de las aberturas medidas por una proporción de rib.\n\nVisualizador y configurador oficial: Fashion Cabinet",
      "fr": "FC-100 rang n°8. Débardeur en maille sans manche à Emmanchure profonde et bretelles étroites ; les bandes de propreté de l'Encolure et des Emmanchures sont dérivées des ouvertures mesurées multipliées par un ratio de côte.\n\nVisualiseur et configurateur officiel : Fashion Cabinet"
    },
    "difficulty": "beginner",
    "tags": [
      "tank",
      "sleeveless",
      "knit",
      "fc100",
      "hyperobject",
      "commons"
    ],
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "LicenseRef-FC1-pending",
      "lineage": [
        {
          "source": "Original draft for Fashion Cabinet",
          "license": "original"
        }
      ]
    }
  },
  "modes": [
    {
      "id": "tank",
      "label": {
        "en": "Tank (all pieces)",
        "es": "Camiseta (todas las piezas)",
        "fr": "Débardeur (toutes les pièces)"
      },
      "script_file": "main.py",
      "pieces": [
        "front",
        "back",
        "neck_binding",
        "armhole_binding"
      ]
    }
  ],
  "pieces": [
    {
      "id": "front",
      "label": {
        "en": "Front",
        "es": "Delantero",
        "fr": "Devant"
      },
      "default_color": "#c98a4a",
      "cut": {
        "quantity": 1,
        "on_fold": true,
        "mirror": true
      }
    },
    {
      "id": "back",
      "label": {
        "en": "Back",
        "es": "Trasero",
        "fr": "Dos"
      },
      "default_color": "#a06c38",
      "cut": {
        "quantity": 1,
        "on_fold": true,
        "mirror": true
      }
    },
    {
      "id": "neck_binding",
      "label": {
        "en": "Neck Binding",
        "es": "Vivo de Escote",
        "fr": "Biais d'encolure"
      },
      "default_color": "#d9a86c",
      "cut": {
        "quantity": 1
      }
    },
    {
      "id": "armhole_binding",
      "label": {
        "en": "Armhole Binding",
        "es": "Vivo de Sisa",
        "fr": "Biais d'emmanchure"
      },
      "default_color": "#e3bc8a",
      "cut": {
        "quantity": 2
      }
    }
  ],
  "parameters": [
    {
      "id": "chest_girth",
      "type": "slider",
      "default": 940,
      "min": 600,
      "max": 1700,
      "step": 10,
      "measurement": {
        "standard": "iso_8559",
        "code": "chest_bust_girth"
      },
      "label": {
        "en": "Chest girth (mm)",
        "es": "Contorno de pecho (mm)",
        "fr": "Tour de poitrine (mm)"
      }
    },
    {
      "id": "body_length",
      "type": "slider",
      "default": 680,
      "min": 380,
      "max": 950,
      "step": 10,
      "label": {
        "en": "Body length, nape to hem (mm)",
        "es": "Largo de cuerpo (mm)",
        "fr": "Longueur du corps, nuque à l'ourlet (mm)"
      }
    },
    {
      "id": "neck_girth",
      "type": "slider",
      "default": 380,
      "min": 300,
      "max": 520,
      "step": 5,
      "measurement": {
        "standard": "iso_8559",
        "code": "neck_girth"
      },
      "label": {
        "en": "Neck girth (mm)",
        "es": "Contorno de cuello (mm)",
        "fr": "Tour de cou (mm)"
      }
    },
    {
      "id": "knit_ease",
      "type": "slider",
      "default": 30,
      "min": -100,
      "max": 250,
      "step": 10,
      "label": {
        "en": "Total ease (mm)",
        "es": "Holgura total (mm)",
        "fr": "Aisance totale (mm)"
      }
    },
    {
      "id": "strap_width",
      "type": "slider",
      "default": 38,
      "min": 20,
      "max": 80,
      "step": 2,
      "label": {
        "en": "Strap width (mm)",
        "es": "Ancho de tirante (mm)",
        "fr": "Largeur de bretelle (mm)"
      }
    },
    {
      "id": "binding_ratio",
      "type": "slider",
      "default": 0.9,
      "min": 0.75,
      "max": 1.0,
      "step": 0.01,
      "advanced": true,
      "label": {
        "en": "Binding/opening ratio",
        "es": "Proporción vivo/abertura",
        "fr": "Rapport biais/ouverture"
      }
    },
    {
      "id": "binding_width",
      "type": "slider",
      "default": 12,
      "min": 8,
      "max": 25,
      "step": 1,
      "label": {
        "en": "Binding finished width (mm)",
        "es": "Ancho terminado del vivo (mm)",
        "fr": "Largeur finie du biais (mm)"
      }
    },
    {
      "id": "seam_allowance",
      "type": "slider",
      "default": 7,
      "min": 0,
      "max": 20,
      "step": 1,
      "label": {
        "en": "Seam allowance (mm)",
        "es": "Margen de costura (mm)",
        "fr": "Marge de couture (mm)"
      }
    },
    {
      "id": "hem_allowance",
      "type": "slider",
      "default": 25,
      "min": 0,
      "max": 50,
      "step": 5,
      "label": {
        "en": "Hem allowance (mm)",
        "es": "Margen de dobladillo (mm)",
        "fr": "Marge d'ourlet (mm)"
      }
    }
  ],
  "presets": [
    {
      "id": "size-s",
      "label": {
        "en": "S",
        "es": "CH",
        "fr": "S"
      },
      "values": {
        "chest_girth": 860,
        "body_length": 650
      }
    },
    {
      "id": "size-m",
      "label": {
        "en": "M",
        "es": "M",
        "fr": "M"
      },
      "values": {
        "chest_girth": 940,
        "body_length": 680
      }
    },
    {
      "id": "size-l",
      "label": {
        "en": "L",
        "es": "G",
        "fr": "L"
      },
      "values": {
        "chest_girth": 1020,
        "body_length": 710
      }
    }
  ],
  "constraints": [
    {
      "expression": "strap_width >= 20",
      "severity": "warning",
      "message": {
        "en": "Very narrow straps need stabilized binding",
        "es": "Tirantes muy angostos requieren vivo estabilizado",
        "fr": "Des bretelles très étroites exigent une bande de propreté stabilisée"
      }
    }
  ],
  "export_formats": [
    "svg",
    "dxf",
    "json"
  ],
  "fabrics": [
    "jersey-algodon"
  ],
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "garment",
    "interfaces": [
      {
        "id": "neckline",
        "type": "neckline",
        "edges": [
          {
            "piece": "front",
            "edge": "neck"
          },
          {
            "piece": "back",
            "edge": "neck"
          }
        ],
        "parameters": [
          "neck_girth",
          "binding_ratio"
        ]
      },
      {
        "id": "armscye",
        "type": "armscye",
        "edges": [
          {
            "piece": "front",
            "edge": "armhole"
          },
          {
            "piece": "back",
            "edge": "armhole"
          }
        ],
        "parameters": [
          "chest_girth",
          "knit_ease"
        ]
      },
      {
        "id": "hem",
        "type": "hem",
        "edges": [
          {
            "piece": "front",
            "edge": "hem"
          },
          {
            "piece": "back",
            "edge": "hem"
          }
        ],
        "parameters": [
          "body_length",
          "hem_allowance"
        ]
      }
    ],
    "capabilities": {
      "made_to_measure": true,
      "fold_cutting": true,
      "fabric_compensation": false,
      "knit_negative_ease": true
    },
    "societal_benefit": {
      "en": "The simplest sleeveless staple — and the cartridge that teaches bound-edge construction, where finishing strips are computed from measured curves instead of guessed.",
      "es": "El básico sin mangas más simple — y el cartucho que enseña la construcción con vivos, donde las tiras de acabado se calculan a partir de curvas medidas en lugar de adivinarse.",
      "fr": "Le basique sans manche le plus simple — et la cartouche qui enseigne la construction à bord gansé, où les bandes de finition sont calculées à partir de courbes mesurées au lieu d'être estimées."
    },
    "commons_license": "LicenseRef-FC1-pending"
  }
}
