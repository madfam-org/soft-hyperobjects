  "constraints": [
    {
      "expression": "button_stand >= 25",
      "severity": "warning",
      "message": {
        "en": "Narrow button stands crowd standard 11.5 mm shirt studs",
        "es": "Tapetas angostas aprietan los botones-broche de camisa estándar de 11.5 mm",
        "fr": "Des pattes de boutonnage étroites serrent les boutons de plastron de chemise standard de 11,5 mm"
      }
    },
    {
      "expression": "bib_height <= body_length - 300",
      "severity": "warning",
      "message": {
        "en": "A bib taller than the chest runs past the waistband — keep it above the trouser line",
        "es": "Una pechera más alta que el pecho pasa la pretina — mantenla sobre la línea del pantalón",
        "fr": "Un plastron plus haut que la poitrine dépasse la ceinture — gardez-le au-dessus de la ligne du pantalon"
      }
    },
    {
      "expression": "bib_width <= chest_girth / 2",
      "severity": "warning",
      "message": {
        "en": "The bib should not exceed half the chest — it is a plastron, not the whole front",
        "es": "La pechera no debe exceder la mitad del pecho — es un plastrón, no todo el delantero",
        "fr": "Le plastron ne doit pas excéder la moitié de la poitrine — c'est un plastron, non tout le devant"
      }
    }
  ],
