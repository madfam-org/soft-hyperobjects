{
  "project": {
    "name": "Collar Stay",
    "slug": "collar-stay",
    "version": "0.1.0",
    "engine": "fc",
    "description": {
      "en": "A Yantra4D-bridged notion: the placement guide for the tapered blade that keeps a shirt-collar point crisp. Fashion Cabinet owns the placement; the finding SOLID is the Yantra4D `collar-stay` cartridge, referenced through notion.hardware_ref.\n\nOfficial visualizer and configurator: Fashion Cabinet",
      "es": "Un avío puenteado con Yantra4D: la guía de colocación para the tapered blade that keeps a shirt-collar point crisp. Fashion Cabinet posee la colocación; el SÓLIDO del avío es el cartucho `collar-stay` de Yantra4D, referenciado por notion.hardware_ref.\n\nVisualizador y configurador oficial: Fashion Cabinet"
    },
    "difficulty": "beginner",
    "tags": [
      "collar-stay",
      "shirt",
      "stiffener",
      "notion",
      "hardware",
      "finding",
      "hyperobject",
      "commons"
    ],
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "LicenseRef-FC1-pending",
      "lineage": [
        {
          "source": "Original draft for Fashion Cabinet",
          "license": "original"
        }
      ]
    }
  },
  "modes": [
    {
      "id": "placement-guide",
      "label": {
        "en": "Placement Guide",
        "es": "Guía de colocación"
      },
      "script_file": "main.py",
      "pieces": [
        "placement-guide"
      ]
    }
  ],
  "pieces": [
    {
      "id": "placement-guide",
      "label": {
        "en": "Collar Stay Placement Guide",
        "es": "Guía de Collar Stay"
      },
      "default_color": "#8a8f94",
      "cut": {
        "quantity": 1,
        "on_fold": false,
        "mirror": false
      }
    }
  ],
  "parameter_groups": [
    {
      "id": "construction",
      "label": {
        "en": "Construction",
        "es": "Construcción",
        "fr": "Construction"
      }
    }
  ],
  "parameters": [
    {
      "id": "stay_len",
      "type": "slider",
      "group": "construction",
      "default": 65,
      "min": 35,
      "max": 120,
      "step": 1,
      "label": {
        "en": "Collar-point length (mm)",
        "es": "Largo de punta (mm)"
      }
    },
    {
      "id": "base_w",
      "type": "slider",
      "group": "construction",
      "default": 12,
      "min": 6,
      "max": 25,
      "step": 0.5,
      "label": {
        "en": "Base width (mm)",
        "es": "Ancho de base (mm)"
      }
    },
    {
      "id": "count",
      "type": "slider",
      "group": "construction",
      "default": 2,
      "min": 1,
      "max": 4,
      "step": 1,
      "label": {
        "en": "Number of stays",
        "es": "Número de ballenas"
      }
    },
    {
      "id": "run_length",
      "type": "slider",
      "group": "construction",
      "default": 160,
      "min": 40,
      "max": 400,
      "step": 5,
      "label": {
        "en": "Placement span (mm)",
        "es": "Largo de colocación (mm)"
      }
    },
    {
      "id": "end_offset",
      "type": "slider",
      "group": "construction",
      "default": 20,
      "min": 5,
      "max": 100,
      "step": 1,
      "label": {
        "en": "End inset (mm)",
        "es": "Margen extremo (mm)"
      }
    }
  ],
  "presets": [
    {
      "id": "default",
      "label": {
        "en": "Default",
        "es": "Predeterminado"
      },
      "values": {
        "stay_len": 65
      }
    }
  ],
  "export_formats": [
    "svg",
    "dxf",
    "json"
  ],
  "fabrics": [],
  "notion": {
    "kind": "custom",
    "subtype": "collar stay placement",
    "hardware_ref": {
      "platform": "yantra4d",
      "project_slug": "collar-stay",
      "linked": true,
      "params_map": {
        "stay_len": "stay_len",
        "base_w": "base_w"
      }
    }
  },
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "notion",
    "interfaces": [
      {
        "id": "placement_line",
        "type": "custom",
        "label": {
          "en": "Fastener placement line",
          "es": "Línea de colocación"
        },
        "edges": [
          {
            "piece": "placement-guide",
            "edge": "guide"
          }
        ],
        "parameters": [
          "stay_len",
          "base_w",
          "count",
          "run_length"
        ]
      }
    ],
    "capabilities": {
      "made_to_measure": true,
      "fold_cutting": false,
      "fabric_compensation": false,
      "hardware_bridge": true
    },
    "societal_benefit": {
      "en": "Turns the tapered blade that keeps a shirt-collar point crisp into an open, made-to-measure placement guide with the printable finding an open Yantra4D object — repairable and free.",
      "es": "Convierte the tapered blade that keeps a shirt-collar point crisp en una guía de colocación abierta y a la medida con el avío imprimible como objeto abierto de Yantra4D — reparable y libre."
    },
    "commons_license": "LicenseRef-FC1-pending"
  }
}
