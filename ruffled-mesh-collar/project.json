        "pt": "Malha para franzir"
      },
      "cut": {
        "quantity": 1
      }
    },
    {
      "id": "binding",
      "label": {
        "en": "Binding strip",
        "es": "Tira de ribete",
        "fr": "Bande de bordure",
        "pt": "Tira de acabamento"
      },
      "cut": {
        "quantity": 1
      }
    }
  ],
  "parameters": [
    {
      "id": "length",
      "type": "slider",
      "label": {
        "en": "Length (mm)",
        "es": "Largo (mm)",
        "fr": "Longueur (mm)",
        "pt": "Comprimento (mm)"
      },
      "default": 500,
      "min": 400.0,
      "max": 600.0,
      "step": 0.1
    },
    {
      "id": "width",
      "type": "slider",
      "label": {
        "en": "Width (mm)",
        "es": "Ancho (mm)",
        "fr": "Largeur (mm)",
        "pt": "Largura (mm)"
      },
      "default": 70,
      "min": 56.0,
      "max": 84.0,
      "step": 0.1
    }
  ],
  "presets": [
    {
      "id": "expanded",
      "label": {
        "en": "Expanded study",
        "es": "Estudio ampliado",
        "fr": "Étude agrandie",
        "pt": "Estudo ampliado"
      },
      "values": {
        "length": 550.0,
        "width": 63.0
      }
    }
  ],
  "constraints": [
    {
      "expression": "length > width",
      "message": {
        "en": "Length must exceed width",
        "es": "El largo debe superar el ancho",
        "fr": "La longueur doit dépasser la largeur",
        "pt": "O comprimento deve superar a largura"
