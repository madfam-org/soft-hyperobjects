{
  "project": {
    "name": "Robe",
    "slug": "robe",
    "version": "0.1.0",
    "engine": "fc",
    "description": {
      "en": "FC-100 rank #42. Shawl-front lounge robe: back on fold, two wrap fronts with a straight open-wrap diagonal in place of the front neck (no closures), wide sleeves with the cap solved to the armholes, self belt with loops, and patch pockets. The shawl collar is simplified to a plain hemmed wrap edge in v0.\n\nOfficial visualizer and configurator: Fashion Cabinet",
      "es": "Rango #42 del FC-100. Bata de descanso con frente cruzado: trasero al doblez, dos delanteros envolventes con una diagonal recta de cruce abierto en lugar del escote delantero (sin cierres), mangas amplias con copa resuelta a las sisas, cinturón propio con presillas y bolsillos de parche. El cuello chal se simplifica en v0 a un canto envolvente con dobladillo.\n\nVisualizador y configurador oficial: Fashion Cabinet"
    },
    "difficulty": "beginner",
    "tags": ["robe", "bata", "lounge", "wrap", "fc100", "hyperobject", "commons"],
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "LicenseRef-FC1-pending",
      "lineage": [{ "source": "Original draft for Fashion Cabinet", "license": "original" }]
    }
  },
  "modes": [
    {
      "id": "robe",
      "label": { "en": "Robe (all pieces)", "es": "Bata (todas las piezas)" },
      "script_file": "main.py",
      "pieces": ["back", "front", "sleeve", "belt", "belt_loop", "pocket"]
    }
  ],
  "pieces": [
    { "id": "back", "label": { "en": "Back", "es": "Trasero" }, "default_color": "#8a5a66", "cut": { "quantity": 1, "on_fold": true, "mirror": true } },
    { "id": "front", "label": { "en": "Front (wrap)", "es": "Delantero (cruzado)" }, "default_color": "#a06e7c", "cut": { "quantity": 2, "mirror": true } },
    { "id": "sleeve", "label": { "en": "Sleeve", "es": "Manga" }, "default_color": "#b58794", "cut": { "quantity": 2, "mirror": true } },
    { "id": "belt", "label": { "en": "Belt", "es": "Cinturón" }, "default_color": "#c9a1ad", "cut": { "quantity": 1 } },
    { "id": "belt_loop", "label": { "en": "Belt Loop", "es": "Presilla" }, "default_color": "#c9a1ad", "cut": { "quantity": 2 } },
    { "id": "pocket", "label": { "en": "Patch Pocket", "es": "Bolsillo de Parche" }, "default_color": "#d8b7c1", "cut": { "quantity": 2 } }
  ],
  "parameters": [
    { "id": "chest_girth", "type": "slider", "default": 1040, "min": 650, "max": 1900, "step": 10, "measurement": { "standard": "iso_8559", "code": "chest_bust_girth" }, "label": { "en": "Chest girth (mm)", "es": "Contorno de pecho (mm)" } },
    { "id": "robe_length", "type": "slider", "default": 1100, "min": 700, "max": 1500, "step": 10, "label": { "en": "Robe length, nape to hem (mm)", "es": "Largo de bata, nuca a dobladillo (mm)" } },
    { "id": "neck_girth", "type": "slider", "default": 400, "min": 300, "max": 520, "step": 5, "measurement": { "standard": "iso_8559", "code": "neck_girth" }, "label": { "en": "Neck girth (mm)", "es": "Contorno de cuello (mm)" } },
    { "id": "sleeve_length", "type": "slider", "default": 540, "min": 250, "max": 760, "step": 10, "label": { "en": "Sleeve length to hem (mm)", "es": "Largo de manga a dobladillo (mm)" } },
    { "id": "lounge_ease", "type": "slider", "default": 240, "min": 120, "max": 500, "step": 10, "label": { "en": "Total lounge ease (mm)", "es": "Holgura total de descanso (mm)" } },
    { "id": "belt_width", "type": "slider", "default": 80, "min": 50, "max": 120, "step": 5, "label": { "en": "Belt width (mm)", "es": "Ancho de cinturón (mm)" } },
    { "id": "seam_allowance", "type": "slider", "default": 10, "min": 0, "max": 20, "step": 1, "label": { "en": "Seam allowance (mm)", "es": "Margen de costura (mm)" } },
    { "id": "hem_allowance", "type": "slider", "default": 30, "min": 0, "max": 60, "step": 5, "label": { "en": "Hem allowance (mm)", "es": "Margen de dobladillo (mm)" } }
  ],
  "presets": [
    { "id": "size-m", "label": { "en": "M", "es": "M" }, "values": { "chest_girth": 1040, "robe_length": 1100, "sleeve_length": 540 } },
    { "id": "size-l", "label": { "en": "L (long)", "es": "G (larga)" }, "values": { "chest_girth": 1200, "robe_length": 1250, "sleeve_length": 560 } }
  ],
  "constraints": [
    {
      "expression": "lounge_ease >= 160",
      "severity": "warning",
      "message": { "en": "A wrap robe needs generous ease; below 160 mm the fronts barely overlap", "es": "Una bata cruzada requiere holgura generosa; debajo de 160 mm los delanteros apenas cruzan" }
    }
  ],
  "export_formats": ["svg", "dxf", "json"],
  "fabrics": ["felpa-algodon", "manta-cruda"],
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "garment",
    "interfaces": [
      { "id": "armscye", "type": "armscye", "edges": [{ "piece": "front", "edge": "armhole" }, { "piece": "back", "edge": "armhole" }, { "piece": "sleeve", "edge": "cap" }], "parameters": ["chest_girth", "lounge_ease"] },
      { "id": "hem", "type": "hem", "edges": [{ "piece": "front", "edge": "hem" }, { "piece": "back", "edge": "hem" }], "parameters": ["robe_length", "hem_allowance"] }
    ],
    "capabilities": { "made_to_measure": true, "fold_cutting": true, "fabric_compensation": false, "knit_negative_ease": false },
    "societal_benefit": {
      "en": "Closure-free dressing: a belted wrap fits a wide range of bodies from one draft and needs no buttons, zips, or fine motor effort — the commons' reference for adaptive lounge and care-setting wear, and its first wrap-front draft.",
      "es": "Vestirse sin cierres: un cruce con cinturón ajusta a una amplia gama de cuerpos desde un solo trazo y no exige botones, cierres ni motricidad fina — la referencia del commons para ropa de descanso adaptable y de cuidados, y su primer trazo de frente cruzado."
    },
    "commons_license": "LicenseRef-FC1-pending"
  }
}
