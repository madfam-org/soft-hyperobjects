{
  "project": {
    "name": "Bra Ring & Slider",
    "slug": "bra-ring-slider",
    "version": "0.1.0",
    "engine": "fc",
    "description": {
      "en": "A Yantra4D-bridged notion: the placement guide for the ring-and-slider set that adjusts bra and lingerie straps. Fashion Cabinet owns the placement; the finding SOLID is the Yantra4D `bra-ring-slider` cartridge, referenced through notion.hardware_ref.\n\nOfficial visualizer and configurator: Fashion Cabinet",
      "es": "Un avío puenteado con Yantra4D: la guía de colocación para the ring-and-slider set that adjusts bra and lingerie straps. Fashion Cabinet posee la colocación; el SÓLIDO del avío es el cartucho `bra-ring-slider` de Yantra4D, referenciado por notion.hardware_ref.\n\nVisualizador y configurador oficial: Fashion Cabinet"
    },
    "difficulty": "beginner",
    "tags": [
      "bra-ring-slider",
      "lingerie",
      "strap-adjuster",
      "notion",
      "hardware",
      "finding",
      "hyperobject",
      "commons"
    ],
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "LicenseRef-FC1-pending",
      "lineage": [
        {
          "source": "Original draft for Fashion Cabinet",
          "license": "original"
        }
      ]
    }
  },
  "modes": [
    {
      "id": "placement-guide",
      "label": {
        "en": "Placement Guide",
        "es": "Guía de colocación"
      },
      "script_file": "main.py",
      "pieces": [
        "placement-guide"
      ]
    }
  ],
  "pieces": [
    {
      "id": "placement-guide",
      "label": {
        "en": "Bra Ring & Slider Placement Guide",
        "es": "Guía de Bra Ring & Slider"
      },
      "default_color": "#8a8f94",
      "cut": {
        "quantity": 1,
        "on_fold": false,
        "mirror": false
      }
    }
  ],
  "parameters": [
    {
      "id": "strap_width",
      "type": "slider",
      "default": 12,
      "min": 5,
      "max": 30,
      "step": 0.5,
      "label": {
        "en": "Strap width (mm)",
        "es": "Ancho de tirante (mm)"
      }
    },
    {
      "id": "count",
      "type": "slider",
      "default": 2,
      "min": 1,
      "max": 4,
      "step": 1,
      "label": {
        "en": "Ring/slider sets",
        "es": "Juegos de argolla"
      }
    },
    {
      "id": "run_length",
      "type": "slider",
      "default": 120,
      "min": 40,
      "max": 400,
      "step": 5,
      "label": {
        "en": "Placement run (mm)",
        "es": "Largo de la línea (mm)"
      }
    },
    {
      "id": "end_offset",
      "type": "slider",
      "default": 10,
      "min": 5,
      "max": 60,
      "step": 1,
      "label": {
        "en": "End inset (mm)",
        "es": "Margen extremo (mm)"
      }
    }
  ],
  "presets": [
    {
      "id": "default",
      "label": {
        "en": "Default",
        "es": "Predeterminado"
      },
      "values": {
        "strap_width": 12
      }
    }
  ],
  "export_formats": [
    "svg",
    "dxf",
    "json"
  ],
  "fabrics": [],
  "notion": {
    "kind": "custom",
    "subtype": "bra ring slider placement",
    "hardware_ref": {
      "platform": "yantra4d",
      "project_slug": "bra-ring-slider",
      "linked": true,
      "params_map": {
        "strap_w": "strap_width"
      }
    }
  },
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "notion",
    "interfaces": [
      {
        "id": "placement_line",
        "type": "custom",
        "label": {
          "en": "Fastener placement line",
          "es": "Línea de colocación"
        },
        "edges": [
          {
            "piece": "placement-guide",
            "edge": "guide"
          }
        ],
        "parameters": [
          "strap_width",
          "count",
          "run_length"
        ]
      }
    ],
    "capabilities": {
      "made_to_measure": true,
      "fold_cutting": false,
      "fabric_compensation": false,
      "hardware_bridge": true
    },
    "societal_benefit": {
      "en": "Turns the ring-and-slider set that adjusts bra and lingerie straps into an open, made-to-measure placement guide with the printable finding an open Yantra4D object — repairable and free.",
      "es": "Convierte the ring-and-slider set that adjusts bra and lingerie straps en una guía de colocación abierta y a la medida con el avío imprimible como objeto abierto de Yantra4D — reparable y libre."
    },
    "commons_license": "LicenseRef-FC1-pending"
  }
}
