        "id": "waist_seam",
        "type": "waistband",
        "label": {
          "en": "Gathered waist ↔ band",
          "es": "Cintura fruncida ↔ pretina"
        },
        "edges": [
          {
            "piece": "skirt",
            "edge": "waist"
          },
          {
            "piece": "band",
            "edge": "attach"
          }
        ],
