          }
        ],
        "parameters": [
          "shoulder_len",
          "wide_w",
          "narrow_w",
          "seam_allowance"
        ]
      }
    ],
    "capabilities": {
      "made_to_measure": true,
      "fold_cutting": false,
      "fabric_compensation": false,
      "printed_textile": true,
      "am_fashion": true
    },
    "societal_benefit": {
      "en": "Turns rank insignia and costume shoulder structure, made an open printable finding: sized to the garment and sewn in, with the printable part an open Yantra4D object — the whole finding repairable, made-to-measure, and free to make.",
      "es": "Convierte rank insignia and costume shoulder structure, made an open printable finding en algo abierto: dimensionado a la prenda y cosido, con la parte imprimible como objeto abierto de Yantra4D — todo el avío reparable, a la medida y libre de hacer."
    },
    "commons_license": "LicenseRef-FC1-pending"
  }
}
