{
  "project": {
    "name": "Peplum Top",
    "slug": "peplum-top",
    "version": "0.1.0",
    "engine": "fc",
    "description": {
      "en": "A fitted darted bodice seamed at the natural waist to a flared peplum — a short circular flounce that stands away over the hip. The peplum is a ring segment whose inner arc equals the bodice waist so the waist seam balances, and whose outer arc gives the flare. A soft-goods garment — no hardware (a back opening is the maker's choice). FC-200 long-tail (silhouette gap).\n\nOfficial visualizer and configurator: Fashion Cabinet",
      "es": "Un corpiño ajustado con pinzas unido en la cintura natural a un peplo acampanado — un vuelo circular corto que se separa del cuerpo sobre la cadera. El peplo es un segmento de anillo cuyo arco interior es igual a la cintura del corpiño para que la costura de cintura se equilibre, y cuyo arco exterior da el vuelo. Una prenda textil — sin herrajes (la abertura trasera es a elección de quien elabora). Cola larga FC-200 (hueco de silueta).\n\nVisualizador y configurador oficial: Fashion Cabinet"
    },
    "difficulty": "advanced",
    "tags": ["peplum", "top", "fitted", "flounce", "commons", "made-to-measure"],
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "LicenseRef-FC1-pending",
      "lineage": [{ "source": "Original draft for Fashion Cabinet", "license": "original" }]
    }
  },
  "modes": [
    { "id": "set", "label": { "en": "Full Top", "es": "Top completo" }, "script_file": "main.py", "pieces": ["front", "back", "peplum"] }
  ],
  "pieces": [
    { "id": "front", "label": { "en": "Bodice Front", "es": "Corpiño frente" }, "default_color": "#7a5a6a", "cut": { "quantity": 1, "on_fold": true, "fold_edge": "center", "mirror": true } },
    { "id": "back", "label": { "en": "Bodice Back", "es": "Corpiño espalda" }, "default_color": "#7a5a6a", "cut": { "quantity": 1, "on_fold": true, "fold_edge": "center", "mirror": true } },
    { "id": "peplum", "label": { "en": "Peplum flounce", "es": "Vuelo de peplo" }, "default_color": "#8a6a7a", "cut": { "quantity": 1, "on_fold": true, "fold_edge": "center", "mirror": true } }
  ],
  "parameters": [
    { "id": "bust_girth", "type": "slider", "default": 920, "min": 680, "max": 1500, "step": 10, "measurement": { "standard": "iso_8559", "code": "chest_bust_girth" }, "label": { "en": "Bust girth (mm)", "es": "Contorno de busto (mm)" }, "tooltip": { "en": "Full bust", "es": "Busto completo" } },
    { "id": "waist_girth", "type": "slider", "default": 740, "min": 540, "max": 1300, "step": 10, "measurement": { "standard": "iso_8559", "code": "waist_girth" }, "label": { "en": "Waist girth (mm)", "es": "Contorno de cintura (mm)" }, "tooltip": { "en": "Fitted waist", "es": "Cintura ajustada" } },
    { "id": "bodice_len", "type": "slider", "default": 360, "min": 300, "max": 460, "step": 5, "label": { "en": "Bodice length (mm)", "es": "Largo de corpiño (mm)" }, "tooltip": { "en": "Shoulder to waist seam", "es": "Del hombro a la costura de cintura" } },
    { "id": "peplum_len", "type": "slider", "default": 220, "min": 120, "max": 400, "step": 10, "label": { "en": "Peplum length (mm)", "es": "Largo del peplo (mm)" }, "tooltip": { "en": "Waist seam to peplum hem", "es": "De la costura de cintura al ruedo del peplo" } },
    { "id": "peplum_flare", "type": "slider", "default": 1.7, "min": 1.2, "max": 2.6, "step": 0.1, "label": { "en": "Peplum flare", "es": "Vuelo del peplo" }, "tooltip": { "en": "Outer arc ÷ waist arc", "es": "Arco exterior ÷ arco de cintura" } },
    { "id": "neck_width", "type": "slider", "default": 180, "min": 130, "max": 300, "step": 5, "label": { "en": "Neck width (mm)", "es": "Ancho de escote (mm)" }, "tooltip": { "en": "Neckline width", "es": "Ancho del escote" } },
    { "id": "bust_dart", "type": "slider", "default": 22, "min": 0, "max": 45, "step": 1, "label": { "en": "Bust dart (mm)", "es": "Pinza de busto (mm)" }, "tooltip": { "en": "Marked bust dart intake", "es": "Entrada de pinza de busto marcada" } }
  ],
  "presets": [
    { "id": "classic", "label": { "en": "Classic", "es": "Clásico" }, "values": { "peplum_flare": 1.7, "peplum_len": 220 } },
    { "id": "dramatic", "label": { "en": "Dramatic flare", "es": "Vuelo dramático" }, "values": { "peplum_flare": 2.3, "peplum_len": 300 } }
  ],
  "export_formats": ["svg", "dxf", "json"],
  "fabrics": [],
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "garment",
    "interfaces": [
      { "id": "shoulder_seam", "type": "shoulder", "label": { "en": "Shoulder seam", "es": "Costura de hombro" }, "edges": [{ "piece": "front", "edge": "shoulder" }, { "piece": "back", "edge": "shoulder" }], "parameters": ["neck_width", "bust_girth"] },
      { "id": "bodice_side", "type": "side_seam", "label": { "en": "Bodice side seam", "es": "Costura lateral de corpiño" }, "edges": [{ "piece": "front", "edge": "side" }, { "piece": "back", "edge": "side" }], "parameters": ["bust_girth", "waist_girth"] },
      { "id": "waist_seam", "type": "waistband", "label": { "en": "Waist seam (bodice to peplum)", "es": "Costura de cintura (corpiño a peplo)" }, "edges": [{ "piece": "front", "edge": "waist" }, { "piece": "peplum", "edge": "waist" }], "parameters": ["waist_girth", "peplum_flare"] }
    ],
    "capabilities": { "made_to_measure": true, "fold_cutting": true, "fabric_compensation": false },
    "societal_benefit": {
      "en": "An open, made-to-measure peplum top computes a true circular flounce whose inner arc matches the wearer's own waist, so a shape that usually needs pattern-drafting skill becomes a repeatable commons object anyone can cut to fit.",
      "es": "Un top con peplo abierto y a la medida calcula un vuelo circular verdadero cuyo arco interior coincide con la cintura de quien lo viste, de modo que una forma que suele requerir destreza de patronaje se vuelve un objeto común repetible que cualquiera puede cortar a su medida."
    },
    "commons_license": "LicenseRef-FC1-pending"
  }
}
