  "constraints": [
    {
      "expression": "hood_depth <= hood_height",
      "severity": "warning",
      "message": {
        "en": "Very deep hoods relative to height collapse forward",
        "es": "Capuchas muy profundas respecto a su alto se vencen hacia adelante",
        "fr": "Les capuches très profondes par rapport à leur hauteur s'affaissent vers l'avant"
      }
    },
    {
      "expression": "body_length - 70 + hemband_height <= 900",
      "severity": "warning",
      "message": {
        "en": "Derived zipper length exceeds common stock zipper lengths (900 mm)",
        "es": "El largo derivado del cierre excede los largos comunes de stock (900 mm)",
        "fr": "La longueur dérivée de la fermeture éclair dépasse les longueurs de stock courantes (900 mm)"
      }
    }
