{
  "project": {
    "name": "Wrap Top",
    "slug": "wrap-top",
    "version": "0.1.0",
    "engine": "fc",
    "description": {
      "en": "A surplice wrap top: two front panels cross in a deep V and tie at the side (one inseam tie through the side seam, one outside), over a plain back — the top-length counterpart to the wrap-dress. Each front extends past centre front by a crossover so they overlap; shoulder + side edges match the back, so both seams balance by construction. A soft-goods garment — no hardware. FC-200 long-tail (silhouette gap).\n\nOfficial visualizer and configurator: Fashion Cabinet",
      "es": "Un top cruzado (surplice): dos paneles frontales se cruzan en una V profunda y atan al costado (un lazo por la costura lateral, otro por fuera), sobre una espalda lisa — la versión corta del vestido cruzado. Cada frente se extiende más allá del centro por un traslape para que se superpongan; los cantos de hombro y lateral coinciden con la espalda, así que ambas costuras se equilibran por construcción. Una prenda textil — sin herrajes. Cola larga FC-200 (hueco de silueta).\n\nVisualizador y configurador oficial: Fashion Cabinet"
    },
    "difficulty": "intermediate",
    "tags": ["wrap", "surplice", "top", "ties", "commons", "made-to-measure"],
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "LicenseRef-FC1-pending",
      "lineage": [{ "source": "Original draft for Fashion Cabinet", "license": "original" }]
    }
  },
  "modes": [
    { "id": "set", "label": { "en": "Full Top", "es": "Top completo" }, "script_file": "main.py", "pieces": ["front", "back", "sleeve"] }
  ],
  "pieces": [
    { "id": "front", "label": { "en": "Wrap front", "es": "Frente cruzado" }, "default_color": "#7a6a5a", "cut": { "quantity": 2, "mirror": true } },
    { "id": "back", "label": { "en": "Back", "es": "Espalda" }, "default_color": "#7a6a5a", "cut": { "quantity": 1, "on_fold": true, "fold_edge": "center", "mirror": true } },
    { "id": "sleeve", "label": { "en": "Sleeve", "es": "Manga" }, "default_color": "#6a5a4a", "cut": { "quantity": 2, "mirror": true } }
  ],
  "parameters": [
    { "id": "bust_girth", "type": "slider", "default": 940, "min": 650, "max": 1500, "step": 10, "measurement": { "standard": "iso_8559", "code": "chest_bust_girth" }, "label": { "en": "Bust girth (mm)", "es": "Contorno de busto (mm)" }, "tooltip": { "en": "Full bust", "es": "Busto completo" } },
    { "id": "top_length", "type": "slider", "default": 600, "min": 400, "max": 880, "step": 10, "label": { "en": "Length (mm)", "es": "Largo (mm)" }, "tooltip": { "en": "Shoulder to hem", "es": "Del hombro al ruedo" } },
    { "id": "neck_width", "type": "slider", "default": 170, "min": 130, "max": 300, "step": 5, "label": { "en": "Neck width (mm)", "es": "Ancho de cuello (mm)" }, "tooltip": { "en": "Base neck at the shoulder", "es": "Cuello base en el hombro" } },
    { "id": "wrap_deep", "type": "slider", "default": 300, "min": 160, "max": 460, "step": 10, "label": { "en": "V depth (mm)", "es": "Profundidad de la V (mm)" }, "tooltip": { "en": "Depth of the wrap V", "es": "Profundidad de la V del cruce" } },
    { "id": "sleeve_len", "type": "slider", "default": 220, "min": 80, "max": 420, "step": 10, "label": { "en": "Sleeve length (mm)", "es": "Largo de manga (mm)" }, "tooltip": { "en": "Sleeve length", "es": "Largo de la manga" } },
    { "id": "sleeve_depth", "type": "slider", "default": 200, "min": 150, "max": 360, "step": 10, "label": { "en": "Sleeve depth (mm)", "es": "Profundidad de manga (mm)" }, "tooltip": { "en": "Armhole drop", "es": "Caída de sisa" } },
    { "id": "ease", "type": "slider", "default": 110, "min": 40, "max": 320, "step": 10, "label": { "en": "Fit ease (mm)", "es": "Holgura (mm)" }, "tooltip": { "en": "Semi-fitted ease", "es": "Holgura semiajustada" } }
  ],
  "presets": [
    { "id": "classic", "label": { "en": "Classic V", "es": "V clásica" }, "values": { "wrap_deep": 300, "sleeve_len": 220 } },
    { "id": "modest", "label": { "en": "Higher wrap", "es": "Cruce más alto" }, "values": { "wrap_deep": 220, "sleeve_len": 320 } }
  ],
  "export_formats": ["svg", "dxf", "json"],
  "fabrics": [],
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "garment",
    "interfaces": [
      { "id": "shoulder_seam", "type": "shoulder", "label": { "en": "Shoulder seam", "es": "Costura de hombro" }, "edges": [{ "piece": "front", "edge": "shoulder" }, { "piece": "back", "edge": "shoulder" }], "parameters": ["neck_width", "bust_girth"] },
      { "id": "side_seam", "type": "side_seam", "label": { "en": "Side seam (tied)", "es": "Costura lateral (con lazos)" }, "edges": [{ "piece": "front", "edge": "side" }, { "piece": "back", "edge": "side" }], "parameters": ["top_length"] },
      { "id": "armscye", "type": "armscye", "label": { "en": "Armhole", "es": "Sisa" }, "edges": [{ "piece": "sleeve", "edge": "sleevehead" }, { "piece": "back", "edge": "armhole" }], "parameters": ["sleeve_depth"] }
    ],
    "capabilities": { "made_to_measure": true, "fold_cutting": true, "fabric_compensation": false },
    "societal_benefit": {
      "en": "An open, made-to-measure wrap top adjusts to the body at the ties rather than a fixed closure, so one adaptable pattern fits changing and varied bodies — a forgiving everyday staple cut from soft, drapey cloth.",
      "es": "Un top cruzado abierto y a la medida se ajusta al cuerpo en los lazos en lugar de un cierre fijo, así que un patrón adaptable se ajusta a cuerpos cambiantes y variados — un básico cotidiano indulgente cortado de tela suave y fluida."
    },
    "commons_license": "LicenseRef-FC1-pending"
  }
}
