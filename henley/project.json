{
  "project": {
    "name": "Henley",
    "slug": "henley",
    "version": "0.1.0",
    "engine": "fc",
    "description": {
      "en": "FC-100 rank #73. The collarless placket shirt: the rank #1 knit block with the polo's marked three-button placket and backing strip, a long tapered cap-solved sleeve, and a derived rib neckband that runs the full neck opening — including across the placket top.\n\nOfficial visualizer and configurator: Fashion Cabinet",
      "es": "Rango #73 del FC-100. La playera de tapeta sin cuello: el bloque de punto del rango #1 con la tapeta marcada de tres botones del polo y su tira de refuerzo, una manga larga entallada de copa resuelta y un cuello de rib derivado que recorre toda la abertura del escote — incluso sobre la parte alta de la tapeta.\n\nVisualizador y configurador oficial: Fashion Cabinet"
    },
    "difficulty": "intermediate",
    "tags": ["henley", "placket", "knit", "long-sleeve", "fc100", "hyperobject", "commons"],
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "LicenseRef-FC1-pending",
      "lineage": [
        {
          "source": "Original draft for Fashion Cabinet; t-shirt-crew/polo family — rank #1 knit block with the polo's placket practice and the crew tee's derived rib band",
          "license": "original"
        }
      ]
    }
  },
  "modes": [
    {
      "id": "henley",
      "label": { "en": "Henley (all pieces)", "es": "Playera henley (todas las piezas)" },
      "script_file": "main.py",
      "pieces": ["front", "back", "sleeve", "neckband", "placket_backing"]
    }
  ],
  "pieces": [
    { "id": "front", "label": { "en": "Front", "es": "Delantero" }, "default_color": "#c06a3f", "cut": { "quantity": 1, "on_fold": true, "mirror": true } },
    { "id": "back", "label": { "en": "Back", "es": "Trasero" }, "default_color": "#96522f", "cut": { "quantity": 1, "on_fold": true, "mirror": true } },
    { "id": "sleeve", "label": { "en": "Sleeve (long)", "es": "Manga (larga)" }, "default_color": "#d28a5c", "cut": { "quantity": 2, "mirror": true } },
    { "id": "neckband", "label": { "en": "Neckband (rib)", "es": "Cuello (rib)" }, "default_color": "#e3b28c", "cut": { "quantity": 1 } },
    { "id": "placket_backing", "label": { "en": "Placket Backing", "es": "Refuerzo de Tapeta" }, "default_color": "#f0d3b8", "cut": { "quantity": 1 } }
  ],
  "parameters": [
    { "id": "chest_girth", "type": "slider", "default": 980, "min": 600, "max": 1800, "step": 10, "measurement": { "standard": "iso_8559", "code": "chest_bust_girth" }, "label": { "en": "Chest girth (mm)", "es": "Contorno de pecho (mm)" } },
    { "id": "body_length", "type": "slider", "default": 730, "min": 400, "max": 1000, "step": 10, "label": { "en": "Body length, nape to hem (mm)", "es": "Largo de cuerpo, nuca a dobladillo (mm)" } },
    { "id": "neck_girth", "type": "slider", "default": 380, "min": 300, "max": 520, "step": 5, "measurement": { "standard": "iso_8559", "code": "neck_girth" }, "label": { "en": "Neck girth (mm)", "es": "Contorno de cuello (mm)" } },
    { "id": "sleeve_length", "type": "slider", "default": 590, "min": 300, "max": 780, "step": 10, "label": { "en": "Sleeve length, shoulder to wrist (mm)", "es": "Largo de manga, hombro a muñeca (mm)" } },
    { "id": "knit_ease", "type": "slider", "default": 60, "min": -80, "max": 300, "step": 10, "label": { "en": "Total ease (mm, negative = compression)", "es": "Holgura total (mm, negativa = compresión)" } },
    { "id": "placket_length", "type": "slider", "default": 180, "min": 60, "max": 260, "step": 5, "label": { "en": "Placket length (mm)", "es": "Largo de tapeta (mm)" } },
    { "id": "placket_width", "type": "slider", "default": 30, "min": 20, "max": 50, "step": 1, "label": { "en": "Placket width (mm)", "es": "Ancho de tapeta (mm)" } },
    { "id": "neckband_ratio", "type": "slider", "default": 0.85, "min": 0.7, "max": 1.0, "step": 0.01, "advanced": true, "label": { "en": "Neckband/opening ratio", "es": "Proporción cuello/abertura" } },
    { "id": "neckband_width", "type": "slider", "default": 18, "min": 10, "max": 40, "step": 1, "label": { "en": "Neckband width (mm)", "es": "Ancho de cuello (mm)" } },
    { "id": "wrist_opening", "type": "slider", "default": 190, "min": 140, "max": 400, "step": 5, "label": { "en": "Wrist opening, flat (mm)", "es": "Abertura de puño, extendida (mm)" } },
    { "id": "seam_allowance", "type": "slider", "default": 7, "min": 0, "max": 20, "step": 1, "label": { "en": "Seam allowance (mm)", "es": "Margen de costura (mm)" } },
    { "id": "hem_allowance", "type": "slider", "default": 25, "min": 0, "max": 50, "step": 5, "label": { "en": "Hem allowance (mm)", "es": "Margen de dobladillo (mm)" } }
  ],
  "presets": [
    { "id": "size-m", "label": { "en": "M", "es": "M" }, "values": { "chest_girth": 980, "body_length": 730, "neck_girth": 380, "sleeve_length": 590 } },
    { "id": "size-l", "label": { "en": "L", "es": "G" }, "values": { "chest_girth": 1060, "body_length": 760, "neck_girth": 395, "sleeve_length": 610 } }
  ],
  "constraints": [
    {
      "expression": "placket_length < body_length / 3",
      "severity": "warning",
      "message": {
        "en": "A placket longer than a third of the body overshoots the henley range and reads as a popover placket",
        "es": "Una tapeta más larga que un tercio del cuerpo excede el rango henley y se lee como una tapeta de media abertura"
      }
    }
  ],
  "export_formats": ["svg", "dxf", "json"],
  "fabrics": ["jersey-algodon"],
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "garment",
    "interfaces": [
      { "id": "neckline", "type": "neckline", "edges": [{ "piece": "front", "edge": "neck" }, { "piece": "back", "edge": "neck" }], "parameters": ["neck_girth", "neckband_ratio", "neckband_width"] },
      { "id": "armscye", "type": "armscye", "edges": [{ "piece": "front", "edge": "armhole" }, { "piece": "back", "edge": "armhole" }, { "piece": "sleeve", "edge": "cap" }], "parameters": ["chest_girth", "knit_ease"] },
      { "id": "hem", "type": "hem", "edges": [{ "piece": "front", "edge": "hem" }, { "piece": "back", "edge": "hem" }], "parameters": ["body_length", "hem_allowance"] },
      { "id": "placket", "type": "placket", "edges": [{ "piece": "placket_backing", "edge": "side_a" }, { "piece": "placket_backing", "edge": "side_b" }], "parameters": ["placket_length", "placket_width"] }
    ],
    "capabilities": { "made_to_measure": true, "fold_cutting": true, "fabric_compensation": false, "knit_negative_ease": true },
    "societal_benefit": {
      "en": "The henley is the base layer of manual work from field to workshop — a placket without collar tailoring keeps it sewable on one machine. A verified parametric draft gives small shops a made-to-measure staple, and its full-opening band over a marked placket teaches closure construction one step below the polo's collar.",
      "es": "La henley es la primera capa del trabajo manual del campo al taller — una tapeta sin sastrería de cuello la mantiene cosible en una sola máquina. Un trazo paramétrico verificado da a los talleres pequeños un básico a medida, y su banda de abertura completa sobre una tapeta marcada enseña la construcción de cierres un paso antes del cuello del polo."
    },
    "commons_license": "LicenseRef-FC1-pending"
  }
}
