{
  "project": {
    "name": "Scrubs Pants",
    "slug": "scrubs-pants",
    "version": "0.1.0",
    "engine": "fc",
    "description": {
      "en": "FC-100 rank #86. Straight woven scrub pant on the sweatpants block: front/back legs with the front inseam bowed by a solved amount to match the deeper back fork, wide straight open hems, a drawstring waistband casing with a center exit mark, and a back patch-pocket placement marking.\n\nOfficial visualizer and configurator: Fashion Cabinet",
      "es": "Rango #86 del FC-100. Pantalón quirúrgico recto de tela plana sobre el bloque de pants: piernas delantera/trasera con la entrepierna delantera curvada por una cantidad resuelta para igualar el tiro trasero más profundo, bajos rectos y amplios abiertos, pretina de casing con jareta y marca de salida al centro, y marca de colocación del bolsillo trasero de parche.\n\nVisualizador y configurador oficial: Fashion Cabinet"
    },
    "difficulty": "beginner",
    "tags": ["scrubs", "workwear", "uniform", "woven", "fc100", "hyperobject", "commons"],
    "attribution": { "author": "Innovaciones MADFAM", "license": "LicenseRef-FC1-pending", "lineage": [{ "source": "Original draft for Fashion Cabinet (sweatpants block family)", "license": "original" }] }
  },
  "modes": [{ "id": "scrubs-pants", "label": { "en": "Scrubs pants (all pieces)", "es": "Pantalón quirúrgico (todas las piezas)" }, "script_file": "main.py", "pieces": ["front", "back", "waistband"] }],
  "pieces": [
    { "id": "front", "label": { "en": "Front Leg", "es": "Pierna Delantera" }, "default_color": "#5f8575", "cut": { "quantity": 2, "mirror": true } },
    { "id": "back", "label": { "en": "Back Leg", "es": "Pierna Trasera" }, "default_color": "#4d6f60", "cut": { "quantity": 2, "mirror": true } },
    { "id": "waistband", "label": { "en": "Waistband Casing (drawstring)", "es": "Pretina (casing con jareta)" }, "default_color": "#7fa290", "cut": { "quantity": 1 } }
  ],
  "parameters": [
    { "id": "hip_girth", "type": "slider", "default": 1000, "min": 650, "max": 1800, "step": 10, "measurement": { "standard": "iso_8559", "code": "hip_girth" }, "label": { "en": "Hip girth (mm)", "es": "Contorno de cadera (mm)" } },
    { "id": "inseam_length", "type": "slider", "default": 740, "min": 300, "max": 950, "step": 10, "measurement": { "standard": "iso_8559", "code": "inside_leg_length" }, "label": { "en": "Inseam (mm)", "es": "Entrepierna (mm)" } },
    { "id": "front_rise", "type": "slider", "default": 275, "min": 190, "max": 380, "step": 5, "label": { "en": "Front rise (mm)", "es": "Tiro delantero (mm)" } },
    { "id": "back_rise", "type": "slider", "default": 315, "min": 190, "max": 460, "step": 5, "label": { "en": "Back rise (mm)", "es": "Tiro trasero (mm)" } },
    { "id": "woven_ease", "type": "slider", "default": 160, "min": 60, "max": 400, "step": 10, "label": { "en": "Total ease (mm)", "es": "Holgura total (mm)" } },
    { "id": "hem_width", "type": "slider", "default": 140, "min": 90, "max": 260, "step": 5, "label": { "en": "Hem half-width, flat (mm)", "es": "Medio bajo, extendido (mm)" } },
    { "id": "elastic_width", "type": "slider", "default": 30, "min": 20, "max": 60, "step": 5, "label": { "en": "Elastic width (mm)", "es": "Ancho de elástico (mm)" } },
    { "id": "seam_allowance", "type": "slider", "default": 10, "min": 0, "max": 20, "step": 1, "label": { "en": "Seam allowance (mm)", "es": "Margen de costura (mm)" } },
    { "id": "hem_allowance", "type": "slider", "default": 30, "min": 0, "max": 50, "step": 5, "label": { "en": "Hem allowance (mm)", "es": "Margen de dobladillo (mm)" } }
  ],
  "presets": [
    { "id": "size-m", "label": { "en": "M", "es": "M" }, "values": { "hip_girth": 1000, "inseam_length": 740 } },
    { "id": "size-l", "label": { "en": "L", "es": "G" }, "values": { "hip_girth": 1120, "inseam_length": 780 } }
  ],
  "constraints": [
    { "expression": "back_rise >= front_rise", "severity": "error", "message": { "en": "Back rise must be at least the front rise", "es": "El tiro trasero debe ser al menos el delantero" } }
  ],
  "export_formats": ["svg", "dxf", "json"],
  "fabrics": ["popelina-algodon"],
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "garment",
    "interfaces": [
      { "id": "waistband", "type": "waistband", "edges": [{ "piece": "front", "edge": "waist" }, { "piece": "back", "edge": "waist" }], "parameters": ["hip_girth", "elastic_width"] },
      { "id": "hem", "type": "hem", "edges": [{ "piece": "front", "edge": "hem" }, { "piece": "back", "edge": "hem" }], "parameters": ["hem_width", "hem_allowance"] }
    ],
    "capabilities": { "made_to_measure": true, "fold_cutting": false, "fabric_compensation": false, "knit_negative_ease": false },
    "societal_benefit": {
      "en": "Healthcare's daily uniform as a commons object: the sweatpants block re-cut in plain-weave popeline with drawstring exits and pocket placement, ready for hospital laundry cycles.",
      "es": "El uniforme diario del sector salud como objeto del commons: el bloque de pants recortado en popelina plana con salidas de jareta y bolsillo trasero, listo para ciclos de lavandería hospitalaria."
    },
    "commons_license": "LicenseRef-FC1-pending"
  }
}
