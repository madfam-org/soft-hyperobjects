{
  "project": {
    "name": "Dopp Kit",
    "slug": "dopp-kit",
    "version": "0.1.0",
    "engine": "fc",
    "description": {
      "en": "A boxed toiletry / wash bag: a wrap body (front + base + back folded at the base), two end gussets that give it its rigid box shape, and a top zip that bridges to the Yantra4D `zipper` solid. Fashion Cabinet owns the bag — dimensions, boxed shape, zip length; Yantra4D owns the zip. FC-200 accessories capsule.\n\nOfficial visualizer and configurator: Fashion Cabinet",
      "es": "Un neceser de fondo cuadrado: un cuerpo envolvente (frente + base + espalda doblado en la base), dos fuelles de extremo que le dan su forma rígida y un cierre superior que se puentea al sólido `zipper` de Yantra4D. Fashion Cabinet posee la bolsa — dimensiones, forma, largo del cierre; Yantra4D posee el cierre.\n\nVisualizador y configurador oficial: Fashion Cabinet"
    },
    "difficulty": "intermediate",
    "tags": [
      "dopp-kit",
      "wash-bag",
      "bag",
      "accessory",
      "hardware",
      "zipper",
      "boxed",
      "commons",
      "made-to-measure"
    ],
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "LicenseRef-FC1-pending",
      "lineage": [
        {
          "source": "Original draft for Fashion Cabinet",
          "license": "original"
        }
      ]
    }
  },
  "modes": [
    {
      "id": "set",
      "label": {
        "en": "Full Dopp Kit",
        "es": "Neceser completo"
      },
      "script_file": "main.py",
      "pieces": [
        "body",
        "end"
      ]
    }
  ],
  "pieces": [
    {
      "id": "body",
      "label": {
        "en": "Body (front + base + back)",
        "es": "Cuerpo (frente + base + espalda)"
      },
      "default_color": "#4a5a6a",
      "cut": {
        "quantity": 1,
        "on_fold": false,
        "mirror": false
      }
    },
    {
      "id": "end",
      "label": {
        "en": "End gusset",
        "es": "Fuelle de extremo"
      },
      "default_color": "#3a4a5a",
      "cut": {
        "quantity": 2,
        "on_fold": false,
        "mirror": true
      }
    }
  ],
  "parameter_groups": [
    {
      "id": "construction",
      "label": {
        "en": "Construction",
        "es": "Construcción",
        "fr": "Construction"
      }
    }
  ],
  "parameters": [
    {
      "id": "kit_length",
      "type": "slider",
      "group": "construction",
      "default": 240,
      "min": 120,
      "max": 450,
      "step": 10,
      "label": {
        "en": "Length (mm)",
        "es": "Largo (mm)"
      },
      "tooltip": {
        "en": "Length the zip runs along; drives the Yantra4D zip length",
        "es": "Largo por donde corre el cierre; define el largo del cierre de Yantra4D"
      }
    },
    {
      "id": "kit_height",
      "type": "slider",
      "group": "construction",
      "default": 130,
      "min": 80,
      "max": 300,
      "step": 10,
      "label": {
        "en": "Height (mm)",
        "es": "Alto (mm)"
      },
      "tooltip": {
        "en": "Front-face height",
        "es": "Alto de la cara"
      }
    },
    {
      "id": "kit_depth",
      "type": "slider",
      "group": "construction",
      "default": 120,
      "min": 60,
      "max": 250,
      "step": 10,
      "label": {
        "en": "Depth (mm)",
        "es": "Fondo (mm)"
      },
      "tooltip": {
        "en": "Box depth (end-gusset width)",
        "es": "Fondo de la caja (ancho del fuelle)"
      }
    },
    {
      "id": "seam_allowance",
      "type": "slider",
      "group": "construction",
      "default": 10,
      "min": 0,
      "max": 20,
      "step": 1,
      "label": {
        "en": "Seam allowance (mm)",
        "es": "Margen de costura (mm)"
      },
      "tooltip": {
        "en": "Where the body sews to the ends and zip",
        "es": "Donde el cuerpo se cose a los extremos y al cierre"
      },
      "advanced": true
    }
  ],
  "presets": [
    {
      "id": "travel",
      "label": {
        "en": "Travel",
        "es": "Viaje"
      },
      "values": {
        "kit_length": 240,
        "kit_height": 130,
        "kit_depth": 120
      }
    },
    {
      "id": "compact",
      "label": {
        "en": "Compact",
        "es": "Compacto"
      },
      "values": {
        "kit_length": 180,
        "kit_height": 100,
        "kit_depth": 90
      }
    }
  ],
  "export_formats": [
    "svg",
    "dxf",
    "json"
  ],
  "fabrics": [],
  "notion": {
    "kind": "custom",
    "subtype": "dopp-kit top zip",
    "hardware_ref": {
      "platform": "yantra4d",
      "project_slug": "zipper",
      "linked": true,
      "params_map": {
        "zip_length": "kit_length"
      }
    }
  },
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "garment",
    "interfaces": [
      {
        "id": "zipper_tape",
        "type": "zipper_tape",
        "label": {
          "en": "Top zip tape",
          "es": "Cinta del cierre superior"
        },
        "edges": [
          {
            "piece": "body",
            "edge": "zip_front"
          }
        ],
        "parameters": [
          "kit_length",
          "seam_allowance"
        ]
      }
    ],
    "capabilities": {
      "made_to_measure": true,
      "fold_cutting": false,
      "fabric_compensation": false,
      "hardware_bridge": true
    },
    "societal_benefit": {
      "en": "A boxed wash bag sized to what you pack, with the zip an open printable Yantra4D object sized to the bag's own length — a durable, repairable, made-to-measure kit instead of a disposable one.",
      "es": "Un neceser de fondo cuadrado dimensionado a lo que empacas, con el cierre como objeto imprimible abierto de Yantra4D dimensionado al largo de la propia bolsa — un neceser durable, reparable y a la medida en vez de uno desechable."
    },
    "commons_license": "LicenseRef-FC1-pending"
  }
}
