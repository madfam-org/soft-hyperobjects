  "constraints": [
    {
      "expression": "back_rise >= front_rise",
      "severity": "warning",
      "message": {
        "en": "Back rise should be at least the front rise",
        "es": "El tiro trasero debe ser al menos el delantero",
        "fr": "La hauteur de fourche arrière doit être au moins égale à celle de devant",
        "pt": "O gancho traseiro deve ser pelo menos igual ao dianteiro"
      }
    },
    {
      "expression": "cuff_ratio <= 1.0",
      "severity": "warning",
      "message": {
        "en": "Cuff must be at or under the ankle opening so the rib recovers",
        "es": "El puño debe ser igual o menor a la abertura del tobillo para que el rib recupere",
        "fr": "Le poignet doit être égal ou inférieur à l'ouverture de cheville pour que la côte reprenne",
        "pt": "O punho deve ser igual ou menor que a abertura do tornozelo para que o canelado recupere"
      }
    },
    {
      "expression": "hem_width >= 85",
      "severity": "warning",
      "message": {
        "en": "Keep the ankle wide enough to pass the foot on a relaxed track pant",
        "es": "Mantenga el tobillo suficientemente ancho para pasar el pie en un track holgado",
        "fr": "Gardez la cheville assez large pour laisser passer le pied sur un track pant détendu",
        "pt": "Mantenha o tornozelo largo o bastante para passar o pé numa calça esportiva folgada"
      }
    }
  ],
