    "societal_benefit": {
      "en": "A printable lattice corset shapes the waist without whalebone or steel — an open, made-to-measure part rigid where it must be and breathing at the bridges, closing the loop from a fabric card to a printable solid.",
      "es": "Un corsé de celosía imprimible moldea la cintura sin ballena ni acero — una pieza abierta y a medida rígida donde debe y que respira en los puentes, cerrando el círculo de una ficha de tela a un sólido imprimible.",
      "fr": "Un corset ajouré imprimable modèle la taille sans baleine ni acier — une pièce ouverte et sur mesure rigide où il le faut et respirant aux ponts, bouclant la boucle d'une fiche de tissu à un solide imprimable.",
      "pt": "Um espartilho vazado imprimível modela a cintura sem barbatana ou aço — uma peça aberta e sob medida rígida onde precisa e que respira nas pontes, fechando o ciclo de uma ficha de tecido a um sólido imprimível."
    }
  },
  "notion": {
    "kind": "custom",
    "subtype": "printed lattice corset",
    "hardware_ref": {
      "platform": "yantra4d",
      "project_slug": "tpu-lattice-panel",
      "linked": true,
      "params_map": {
        "tile": "tile_size",
        "gap": "tile_gap",
        "cols": "round((bust_girth / 4 + (waist_girth / 4 - cinch / 2) + hip_girth / 4) / 3 / (tile_size + tile_gap))",
        "rows": "round(torso_length / (tile_size + tile_gap))"
      }
    }
  }
