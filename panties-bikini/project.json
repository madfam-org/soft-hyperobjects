{
  "project": {
    "name": "Bikini Panties",
    "slug": "panties-bikini",
    "version": "0.1.0",
    "engine": "fc",
    "description": {
      "en": "FC-100 rank #45. The commons' first intimates draft: fold-cut front (high-cut leg) and back (full coverage) at 12% negative ease, closed by a trapezoid gusset cut twice (self + liner) whose front and back edges match the bodies by construction. Waist and leg edges are elastic-finished and the BOM emits exact-mm elastic cut lengths derived from the measured openings.\n\nOfficial visualizer and configurator: Fashion Cabinet",
      "es": "Rango #45 del FC-100. El primer trazo de ropa interior del commons: delantero (pierna alta) y trasero (cobertura completa) cortados al doblez con 12% de holgura negativa, cerrados por un refuerzo trapezoidal cortado dos veces (tela + forro) cuyos bordes delantero y trasero igualan a los cuerpos por construcción. Cintura y piernas se terminan con elástico y la lista de materiales emite largos de elástico exactos en mm derivados de las aberturas medidas.\n\nVisualizador y configurador oficial: Fashion Cabinet"
    },
    "difficulty": "intermediate",
    "tags": ["panties", "bikini", "intimates", "underwear", "knit", "negative-ease", "elastic", "fc100", "hyperobject", "commons"],
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "LicenseRef-FC1-pending",
      "lineage": [{ "source": "Original draft for Fashion Cabinet", "license": "original" }]
    }
  },
  "modes": [
    {
      "id": "panties",
      "label": { "en": "Bikini panties (all pieces)", "es": "Pantaleta (todas las piezas)" },
      "script_file": "main.py",
      "pieces": ["front", "back", "gusset"]
    }
  ],
  "pieces": [
    { "id": "front", "label": { "en": "Front (high-cut)", "es": "Delantero (pierna alta)" }, "default_color": "#c26a8a", "cut": { "quantity": 1, "on_fold": true, "mirror": true } },
    { "id": "back", "label": { "en": "Back (full coverage)", "es": "Trasero (cobertura completa)" }, "default_color": "#a75573", "cut": { "quantity": 1, "on_fold": true, "mirror": true } },
    { "id": "gusset", "label": { "en": "Gusset (self + liner)", "es": "Refuerzo (tela + forro)" }, "default_color": "#dc94ac", "cut": { "quantity": 2, "on_fold": true, "mirror": true } }
  ],
  "parameters": [
    { "id": "hip_girth", "type": "slider", "default": 940, "min": 600, "max": 1700, "step": 10, "measurement": { "standard": "iso_8559", "code": "hip_girth" }, "label": { "en": "Hip girth (mm)", "es": "Contorno de cadera (mm)" } },
    { "id": "rise_height", "type": "slider", "default": 240, "min": 150, "max": 400, "step": 5, "label": { "en": "Rise, gusset to waist (mm)", "es": "Tiro, refuerzo a cintura (mm)" } },
    { "id": "negative_ease_pct", "type": "slider", "default": 12, "min": 0, "max": 20, "step": 1, "label": { "en": "Negative ease (%)", "es": "Holgura negativa (%)" } },
    { "id": "gusset_front_w", "type": "slider", "default": 32, "min": 20, "max": 60, "step": 2, "advanced": true, "label": { "en": "Gusset front width (mm)", "es": "Ancho delantero del refuerzo (mm)" } },
    { "id": "gusset_back_w", "type": "slider", "default": 38, "min": 20, "max": 60, "step": 2, "advanced": true, "label": { "en": "Gusset back width (mm)", "es": "Ancho trasero del refuerzo (mm)" } },
    { "id": "gusset_len", "type": "slider", "default": 70, "min": 40, "max": 120, "step": 5, "advanced": true, "label": { "en": "Gusset length (mm)", "es": "Largo del refuerzo (mm)" } },
    { "id": "elastic_ratio", "type": "slider", "default": 0.9, "min": 0.8, "max": 1.0, "step": 0.01, "advanced": true, "label": { "en": "Waist elastic/opening ratio", "es": "Proporción elástico/abertura de cintura" } },
    { "id": "leg_elastic_ratio", "type": "slider", "default": 0.85, "min": 0.75, "max": 1.0, "step": 0.01, "advanced": true, "label": { "en": "Leg elastic/opening ratio", "es": "Proporción elástico/abertura de pierna" } },
    { "id": "seam_allowance", "type": "slider", "default": 6, "min": 0, "max": 12, "step": 1, "label": { "en": "Seam allowance (mm)", "es": "Margen de costura (mm)" } }
  ],
  "presets": [
    { "id": "size-s", "label": { "en": "S", "es": "CH" }, "values": { "hip_girth": 880, "rise_height": 230 } },
    { "id": "size-l", "label": { "en": "L", "es": "G" }, "values": { "hip_girth": 1020, "rise_height": 250 } }
  ],
  "constraints": [
    {
      "expression": "negative_ease_pct >= 5",
      "severity": "warning",
      "message": { "en": "Below 5% negative ease the panty relies on elastic alone — expect a loose fit", "es": "Debajo de 5% de holgura negativa la prenda depende solo del elástico — el ajuste quedará flojo" }
    },
    {
      "expression": "negative_ease_pct <= 15",
      "severity": "warning",
      "message": { "en": "Above 15% negative ease demands high-elastane jersey; check the fabric card", "es": "Arriba de 15% de holgura negativa exige jersey con alto elastano; revisa la ficha de tela" }
    }
  ],
  "export_formats": ["svg", "dxf", "json"],
  "fabrics": ["jersey-algodon"],
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "garment",
    "interfaces": [
      { "id": "waistband", "type": "waistband", "label": { "en": "Waist elastic", "es": "Elástico de cintura" }, "edges": [{ "piece": "front", "edge": "waist" }, { "piece": "back", "edge": "waist" }], "parameters": ["hip_girth", "negative_ease_pct", "elastic_ratio"] },
      { "id": "leg_openings", "type": "hem", "label": { "en": "Leg openings (elastic hem)", "es": "Aberturas de pierna (dobladillo elástico)" }, "edges": [{ "piece": "front", "edge": "leg" }, { "piece": "back", "edge": "leg" }], "parameters": ["rise_height", "leg_elastic_ratio"] },
      { "id": "gusset", "type": "custom", "label": { "en": "Gusset panel", "es": "Refuerzo de entrepierna" }, "edges": [{ "piece": "gusset", "edge": "front_edge" }, { "piece": "gusset", "edge": "back_edge" }], "parameters": ["gusset_front_w", "gusset_back_w", "gusset_len"] }
    ],
    "capabilities": { "made_to_measure": true, "fold_cutting": true, "fabric_compensation": false, "knit_negative_ease": true, "elastic_finish": true },
    "societal_benefit": {
      "en": "The commons' first intimates draft, with the elastic math in the open: exact-mm waist and leg elastic cut lengths computed from measured pattern openings — the numbers usually locked inside factory spec sheets — plus a gusset that is proven to fit its bodies at render time.",
      "es": "El primer trazo de ropa interior del commons, con la matemática del elástico en abierto: largos exactos en mm del elástico de cintura y piernas calculados desde las aberturas medidas del patrón — los números que suelen quedar bajo llave en las hojas de especificación de fábrica — más un refuerzo cuyo ajuste a los cuerpos se comprueba al renderizar."
    },
    "commons_license": "LicenseRef-FC1-pending"
  }
}
