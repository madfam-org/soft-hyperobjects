  "presets": [
    {
      "id": "size-m", "label": { "en": "M", "es": "M" },
      "values": { "chest_girth": 1000, "hip_girth": 1000, "top_length": 720, "inseam_length": 720, "sleeve_length": 580 }
    },
    {
