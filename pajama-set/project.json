    { "id": "top_back", "label": { "en": "Top Back", "es": "Trasero (camisa)" }, "default_color": "#4e7398", "cut": { "quantity": 1, "on_fold": true, "mirror": true } },
    { "id": "top_sleeve", "label": { "en": "Top Sleeve (long)", "es": "Manga (camisa)" }, "default_color": "#6f95bb", "cut": { "quantity": 2, "mirror": true } },
    { "id": "collar", "label": { "en": "Band Collar", "es": "Cuello mao" }, "default_color": "#86a8c9", "cut": { "quantity": 2, "on_fold": true, "mirror": true } },
    { "id": "pant_front", "label": { "en": "Pant Front Leg", "es": "Pierna delantera" }, "default_color": "#a89a7e", "cut": { "quantity": 2, "mirror": true } },
    { "id": "pant_back", "label": { "en": "Pant Back Leg", "es": "Pierna trasera" }, "default_color": "#8f8268", "cut": { "quantity": 2, "mirror": true } },
    { "id": "pant_waistband", "label": { "en": "Pant Waistband Casing", "es": "Pretina (casing)" }, "default_color": "#bcae94", "cut": { "quantity": 1 } }
