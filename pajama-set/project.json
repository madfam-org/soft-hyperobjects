      "pieces": ["pant_front", "pant_back", "pant_waistband"]
    },
    {
      "id": "set",
      "label": { "en": "Full set (both garments)", "es": "Conjunto completo (ambas prendas)" },
      "script_file": "main.py",
      "pieces": ["top_front", "top_back", "top_sleeve", "collar", "pant_front", "pant_back", "pant_waistband"]
    }
  ],
