{
  "project": {
    "name": "Joggers",
    "slug": "joggers",
    "version": "0.1.0",
    "engine": "fc",
    "description": {
      "en": "FC-100 rank #16. The sweatpants block tapered to the ankle with a lower rise, solved front-inseam bow, and derived rib ankle cuffs plus waistband casing.\n\nOfficial visualizer and configurator: Fashion Cabinet",
      "es": "Rango #16 del FC-100. El bloque de pants entallado al tobillo con tiro más bajo, curva de entrepierna resuelta y puños de rib derivados más pretina de casing.\n\nVisualizador y configurador oficial: Fashion Cabinet",
      "fr": "FC-100 rang no 16. Le bloc de pantalon de survêtement fuselé à la cheville avec une hauteur de fourche plus basse, un galbe d'entrejambe devant résolu, des poignets côtelés dérivés et une coulisse de ceinture.\n\nVisualiseur et configurateur officiel : Fashion Cabinet",
      "pt": "Posto #16 do FC-100. O bloco de calça de moletom afunilado ao tornozelo, com gancho mais baixo, curva de entreperna dianteira resolvida e punhos de tornozelo canelados derivados mais o cós com bainha para elástico.\n\nVisualizador e configurador oficial: Fashion Cabinet"
    },
    "difficulty": "beginner",
    "tags": [
      "joggers",
      "fleece",
      "tapered",
      "fc100",
      "hyperobject",
      "commons"
    ],
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "CERN-OHL-W-2.0",
      "lineage": [
        {
          "source": "Original draft for Fashion Cabinet (sweatpants block family)",
          "license": "original"
        }
      ]
    }
  },
  "modes": [
    {
      "id": "joggers",
      "label": {
        "en": "Joggers (all pieces)",
        "es": "Joggers (todas las piezas)",
        "fr": "Jogging (toutes les pièces)",
        "pt": "Calça jogger (todas as peças)"
      },
      "script_file": "main.py",
      "pieces": [
        "front",
        "back",
        "cuff",
        "waistband"
      ]
    }
  ],
  "pieces": [
    {
      "id": "front",
      "label": {
        "en": "Front Leg",
        "es": "Pierna Delantera",
        "fr": "Jambe devant",
        "pt": "Frente da Perna"
      },
      "default_color": "#77808a",
      "cut": {
        "quantity": 2,
        "mirror": true
      }
    },
    {
      "id": "back",
      "label": {
        "en": "Back Leg",
        "es": "Pierna Trasera",
        "fr": "Jambe dos",
        "pt": "Costas da Perna"
      },
      "default_color": "#5e6770",
      "cut": {
        "quantity": 2,
        "mirror": true
      }
    },
    {
      "id": "cuff",
      "label": {
        "en": "Ankle Cuff (rib)",
        "es": "Puño de tobillo (rib)",
        "fr": "Poignet de cheville (côtes)",
        "pt": "Punho de tornozelo (canelado)"
      },
      "default_color": "#99a2ac",
      "cut": {
        "quantity": 2
      }
    },
    {
      "id": "waistband",
      "label": {
        "en": "Waistband Casing",
        "es": "Pretina (casing)",
        "fr": "Coulisse de ceinture",
        "pt": "Cós com Passagem"
      },
      "default_color": "#b3bcc6",
      "cut": {
        "quantity": 1
      }
    }
  ],
  "parameters": [
    {
      "id": "hip_girth",
      "type": "slider",
      "default": 1000,
      "min": 650,
      "max": 1800,
      "step": 10,
      "measurement": {
        "standard": "iso_8559",
        "code": "hip_girth"
      },
      "label": {
        "en": "Hip girth (mm)",
        "es": "Contorno de cadera (mm)",
        "fr": "Tour de hanches (mm)",
        "pt": "Contorno de quadril (mm)"
      }
    },
    {
      "id": "inseam_length",
      "type": "slider",
      "default": 700,
      "min": 300,
      "max": 950,
      "step": 10,
      "measurement": {
        "standard": "iso_8559",
        "code": "inside_leg_length"
      },
      "label": {
        "en": "Inseam (mm)",
        "es": "Entrepierna (mm)",
        "fr": "Entrejambe (mm)",
        "pt": "Gancho interno (mm)"
      }
    },
    {
      "id": "front_rise",
      "type": "slider",
      "default": 255,
      "min": 180,
      "max": 370,
      "step": 5,
      "label": {
        "en": "Front rise (mm)",
        "es": "Tiro delantero (mm)",
        "fr": "Hauteur de fourche avant (mm)",
        "pt": "Gancho dianteiro (mm)"
      }
    },
    {
      "id": "back_rise",
      "type": "slider",
      "default": 295,
      "min": 180,
      "max": 450,
      "step": 5,
      "label": {
        "en": "Back rise (mm)",
        "es": "Tiro trasero (mm)",
        "fr": "Hauteur de fourche arrière (mm)",
        "pt": "Gancho traseiro (mm)"
      }
    },
    {
      "id": "fleece_ease",
      "type": "slider",
      "default": 110,
      "min": 40,
      "max": 350,
      "step": 10,
      "label": {
        "en": "Total ease (mm)",
        "es": "Holgura total (mm)",
        "fr": "Aisance totale (mm)",
        "pt": "Folga total (mm)"
      }
    },
    {
      "id": "hem_width",
      "type": "slider",
      "default": 95,
      "min": 70,
      "max": 200,
      "step": 5,
      "label": {
        "en": "Ankle half-width, flat (mm)",
        "es": "Medio tobillo, extendido (mm)",
        "fr": "Demi-largeur de cheville, à plat (mm)",
        "pt": "Meia largura do tornozelo, plana (mm)"
      }
    },
    {
      "id": "cuff_ratio",
      "type": "slider",
      "default": 0.75,
      "min": 0.6,
      "max": 0.95,
      "step": 0.01,
      "advanced": true,
      "label": {
        "en": "Cuff/ankle ratio",
        "es": "Proporción puño/tobillo",
        "fr": "Rapport poignet/cheville",
        "pt": "Proporção punho/tornozelo"
      }
    },
    {
      "id": "cuff_height",
      "type": "slider",
      "default": 55,
      "min": 30,
      "max": 90,
      "step": 5,
      "label": {
        "en": "Cuff height (mm)",
        "es": "Alto de puño (mm)",
        "fr": "Hauteur du poignet (mm)",
        "pt": "Altura do punho (mm)"
      }
    },
    {
      "id": "elastic_width",
      "type": "slider",
      "default": 35,
      "min": 20,
      "max": 60,
      "step": 5,
      "label": {
        "en": "Elastic width (mm)",
        "es": "Ancho de elástico (mm)",
        "fr": "Largeur de l'élastique (mm)",
        "pt": "Largura do elástico (mm)"
      }
    },
    {
      "id": "seam_allowance",
      "type": "slider",
      "default": 8,
      "min": 0,
      "max": 20,
      "step": 1,
      "label": {
        "en": "Seam allowance (mm)",
        "es": "Margen de costura (mm)",
        "fr": "Marge de couture (mm)",
        "pt": "Margem de costura (mm)"
      }
    }
  ],
  "presets": [
    {
      "id": "size-m",
      "label": {
        "en": "M",
        "es": "M",
        "fr": "M",
        "pt": "M"
      },
      "values": {
        "hip_girth": 1000
      }
    },
    {
      "id": "size-l",
      "label": {
        "en": "L",
        "es": "G",
        "fr": "L",
        "pt": "G"
      },
      "values": {
        "hip_girth": 1080,
        "inseam_length": 720
      }
    }
  ],
  "constraints": [
    {
      "expression": "back_rise >= front_rise",
      "severity": "error",
      "message": {
        "en": "Back rise must be at least the front rise",
        "es": "El tiro trasero debe ser al menos el delantero",
        "fr": "La hauteur de fourche dos doit être au moins égale à celle du devant",
        "pt": "O gancho traseiro deve ser pelo menos igual ao dianteiro"
      }
    }
  ],
  "export_formats": [
    "svg",
    "dxf",
    "json",
    "pdf"
  ],
  "fabrics": [
    "felpa-algodon"
  ],
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "garment",
    "interfaces": [
      {
        "id": "waistband",
        "type": "waistband",
        "edges": [
          {
            "piece": "front",
            "edge": "waist"
          },
          {
            "piece": "back",
            "edge": "waist"
          }
        ],
        "parameters": [
          "hip_girth",
          "elastic_width"
        ]
      },
      {
        "id": "cuff",
        "type": "cuff",
        "edges": [
          {
            "piece": "front",
            "edge": "hem"
          },
          {
            "piece": "back",
            "edge": "hem"
          }
        ],
        "parameters": [
          "cuff_ratio",
          "cuff_height"
        ]
      }
    ],
    "capabilities": {
      "made_to_measure": true,
      "fold_cutting": false,
      "fabric_compensation": false,
      "knit_negative_ease": false
    },
    "societal_benefit": {
      "en": "Proves the trouser block family scales across silhouettes: same geometry, tapered and cuffed, with every finish still derived from measured edges.",
      "es": "Demuestra que la familia del bloque de pantalón escala entre siluetas: la misma geometría, entallada y con puños, con cada acabado derivado de bordes medidos.",
      "fr": "Démontre que la famille du bloc de pantalon s'adapte à toutes les silhouettes : même géométrie, fuselée et à poignets, chaque finition restant dérivée de bords mesurés.",
      "pt": "Prova que a família de moldes base de calça escala entre silhuetas: a mesma geometria, afunilada e com bainha virada, com cada acabamento ainda derivado de bordas medidas."
    },
    "commons_license": "CERN-OHL-W-2.0"
  }
}
