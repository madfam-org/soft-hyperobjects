  "constraints": [
    {
      "expression": "chest_girth + knit_ease >= neck_girth",
      "severity": "warning",
      "message": {
        "en": "The neck opening must be smaller than the body; a knit neckline still needs to clear the head",
        "es": "La abertura del escote debe ser menor que el cuerpo; un escote de punto igual debe pasar la cabeza"
      }
    },
    {
      "expression": "footed == false || foot_length >= ankle_girth / 4.0",
      "severity": "warning",
      "message": {
        "en": "A very shallow foot relative to the ankle makes the sole solver bulge hard; deepen the foot or narrow the ankle",
        "es": "Un pie muy poco profundo respecto al tobillo obliga a la plantilla a curvarse en exceso; aumenta el pie o reduce el tobillo"
      }
    }
