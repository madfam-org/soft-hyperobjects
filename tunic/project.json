{
  "project": {
    "name": "Tunic",
    "slug": "tunic",
    "version": "0.1.0",
    "engine": "fc",
    "description": {
      "en": "FC-100 rank #78. Flowing woven tunic with an integrated kimono sleeve: the shoulder line runs straight out to a wide short sleeve end and the underarm curves into the side seam — no separate sleeve piece. Side seams are sewn only down to the notched slit tops; the round neckline is finished with a bias binding strip derived from the measured opening.\n\nOfficial visualizer and configurator: Fashion Cabinet",
      "es": "Rango #78 del FC-100. Túnica vaporosa de tejido plano con manga kimono integrada: la línea de hombro se extiende recta hasta una bocamanga ancha y corta, y la sisa curva hacia la costura lateral — sin pieza de manga separada. Los laterales se cosen solo hasta las aberturas marcadas con piquetes; el escote redondo se termina con un vivo al bies derivado de la abertura medida.\n\nVisualizador y configurador oficial: Fashion Cabinet"
    },
    "difficulty": "beginner",
    "tags": ["tunic", "kimono-sleeve", "woven", "side-slits", "fc100", "hyperobject", "commons"],
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "LicenseRef-FC1-pending",
      "lineage": [
        { "source": "Original draft for Fashion Cabinet", "license": "original" }
      ]
    }
  },
  "modes": [
    {
      "id": "tunic",
      "label": { "en": "Tunic (all pieces)", "es": "Túnica (todas las piezas)" },
      "script_file": "main.py",
      "pieces": ["front", "back", "neck_binding"]
    }
  ],
  "pieces": [
    { "id": "front", "label": { "en": "Front", "es": "Delantero" }, "default_color": "#bc8a52", "cut": { "quantity": 1, "on_fold": true, "mirror": true } },
    { "id": "back", "label": { "en": "Back", "es": "Trasero" }, "default_color": "#96703d", "cut": { "quantity": 1, "on_fold": true, "mirror": true } },
    { "id": "neck_binding", "label": { "en": "Neck Binding (bias)", "es": "Vivo de Escote (al bies)" }, "default_color": "#dcb184", "cut": { "quantity": 1 } }
  ],
  "parameters": [
    { "id": "bust_girth", "type": "slider", "default": 950, "min": 700, "max": 1600, "step": 10, "measurement": { "standard": "iso_8559", "code": "chest_bust_girth" }, "label": { "en": "Bust girth (mm)", "es": "Contorno de busto (mm)" } },
    { "id": "body_length", "type": "slider", "default": 820, "min": 600, "max": 1100, "step": 10, "label": { "en": "Body length, HPS to hem (mm)", "es": "Largo de cuerpo (mm)" } },
    { "id": "neck_girth", "type": "slider", "default": 390, "min": 320, "max": 520, "step": 5, "measurement": { "standard": "iso_8559", "code": "neck_girth" }, "label": { "en": "Neck girth (mm)", "es": "Contorno de cuello (mm)" } },
    { "id": "sleeve_reach", "type": "slider", "default": 320, "min": 180, "max": 550, "step": 10, "label": { "en": "Sleeve reach, HPS to sleeve end (mm)", "es": "Alcance de manga, hombro a bocamanga (mm)" } },
    { "id": "sleeve_opening", "type": "slider", "default": 400, "min": 250, "max": 550, "step": 10, "label": { "en": "Sleeve opening (mm)", "es": "Abertura de bocamanga (mm)" } },
    { "id": "flare_mm", "type": "slider", "default": 60, "min": 0, "max": 200, "step": 10, "label": { "en": "Hem flare beyond bust line (mm)", "es": "Vuelo del bajo respecto al busto (mm)" } },
    { "id": "slit_height", "type": "slider", "default": 180, "min": 0, "max": 400, "step": 10, "label": { "en": "Side slit height above hem (mm)", "es": "Alto de abertura lateral (mm)" } },
    { "id": "seam_allowance", "type": "slider", "default": 10, "min": 0, "max": 20, "step": 1, "label": { "en": "Seam allowance (mm)", "es": "Margen de costura (mm)" } },
    { "id": "hem_allowance", "type": "slider", "default": 25, "min": 0, "max": 50, "step": 5, "label": { "en": "Hem & sleeve-end allowance (mm)", "es": "Margen de dobladillo y bocamanga (mm)" } }
  ],
  "presets": [
    { "id": "size-m", "label": { "en": "M", "es": "M" }, "values": { "bust_girth": 950, "body_length": 820 } },
    { "id": "flowy-long", "label": { "en": "Flowy (long)", "es": "Vaporosa (larga)" }, "values": { "bust_girth": 1050, "body_length": 900, "flare_mm": 100, "slit_height": 240 } }
  ],
  "constraints": [
    {
      "expression": "slit_height < body_length / 2",
      "severity": "error",
      "message": { "en": "Side slits taller than half the body length destabilize the garment", "es": "Aberturas mayores a la mitad del largo desestabilizan la prenda" }
    }
  ],
  "export_formats": ["svg", "dxf", "json"],
  "fabrics": ["popelina-algodon", "manta-cruda"],
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "garment",
    "interfaces": [
      { "id": "neckline", "type": "neckline", "edges": [{ "piece": "front", "edge": "neck" }, { "piece": "back", "edge": "neck" }], "parameters": ["neck_girth"] },
      { "id": "hem", "type": "hem", "edges": [{ "piece": "front", "edge": "hem" }, { "piece": "back", "edge": "hem" }], "parameters": ["body_length", "flare_mm", "hem_allowance"] }
    ],
    "capabilities": { "made_to_measure": true, "fold_cutting": true, "fabric_compensation": false, "integrated_sleeve": true, "side_slits": true, "bound_neckline": true },
    "societal_benefit": {
      "en": "The gateway woven garment: a kimono cut proves that a sleeve can live inside the body piece, so one fold-cut pattern clothes many bodies — and the slit-notch teaches how ease of movement is drafted, not added later.",
      "es": "La prenda de tejido plano de entrada: el corte kimono demuestra que la manga puede vivir dentro del cuerpo, de modo que un solo patrón al doblez viste muchos cuerpos — y el piquete de la abertura enseña que la libertad de movimiento se traza, no se agrega después."
    },
    "commons_license": "LicenseRef-FC1-pending"
  }
}
