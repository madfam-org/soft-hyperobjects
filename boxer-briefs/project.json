  "constraints": [
    {
      "expression": "negative_ease_pct >= 5",
      "severity": "warning",
      "message": {
        "en": "Below 5% negative ease the boxer brief relies on elastic alone — expect a loose fit",
        "es": "Debajo de 5% de holgura negativa la prenda depende solo del elástico — el ajuste quedará flojo",
        "fr": "Sous 5 % d'aisance négative le boxer repose sur le seul élastique — attendez-vous à un ajustement lâche"
      }
    },
    {
      "expression": "negative_ease_pct <= 15",
      "severity": "warning",
      "message": {
        "en": "Above 15% negative ease demands high-elastane jersey; check the fabric card",
        "es": "Arriba de 15% de holgura negativa exige jersey con alto elastano; revisa la ficha de tela",
        "fr": "Au-delà de 15 % d'aisance négative il faut un jersey à haute teneur en élasthanne ; vérifiez la fiche de tissu"
      }
    },
    {
      "expression": "gusset_back_w >= gusset_front_w",
      "severity": "warning",
      "message": {
        "en": "A back gusset narrower than the front pouch is unusual — verify the seat width",
        "es": "Un refuerzo trasero más angosto que la bolsa delantera es inusual — verifica el ancho del asiento",
        "fr": "Un gousset de dos plus étroit que la poche du devant est inhabituel — vérifiez la largeur de l'assise"
      }
    }
  ],
