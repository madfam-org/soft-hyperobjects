{
  "project": {
    "name": "Turtleneck Sweater",
    "slug": "turtleneck-sweater",
    "version": "0.1.0",
    "engine": "fc",
    "description": {
      "en": "FC-100 rank #40. Slim cut-and-sew knit turtleneck: high-neckline body on fold, long sleeve with the cap solved to the armholes, and a tall funnel collar derived as a rib rectangle at 0.75 of the neck opening — the piece is cut at twice the finished height plus allowances and folds double, worn folded to the finished height.\n\nOfficial visualizer and configurator: Fashion Cabinet",
      "es": "Rango #40 del FC-100. Suéter de cuello alto entallado en punto corte-y-confección: cuerpo de escote alto al doblez, manga larga con copa resuelta a las sisas, y cuello alto tipo chimenea derivado como rectángulo de rib a 0.75 de la abertura — la pieza se corta al doble del alto terminado más márgenes, se dobla en dos y se usa doblado al alto terminado.\n\nVisualizador y configurador oficial: Fashion Cabinet"
    },
    "difficulty": "intermediate",
    "tags": ["turtleneck", "sweater", "knitwear", "funnel-collar", "fc100", "hyperobject", "commons"],
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "LicenseRef-FC1-pending",
      "lineage": [{ "source": "Original draft for Fashion Cabinet", "license": "original" }]
    }
  },
  "modes": [
    {
      "id": "sweater",
      "label": { "en": "Sweater (all pieces)", "es": "Suéter (todas las piezas)" },
      "script_file": "main.py",
      "pieces": ["front", "back", "sleeve", "collar", "cuff", "hem_band"]
    }
  ],
  "pieces": [
    { "id": "front", "label": { "en": "Front", "es": "Delantero" }, "default_color": "#8a7f72", "cut": { "quantity": 1, "on_fold": true, "mirror": true } },
    { "id": "back", "label": { "en": "Back", "es": "Trasero" }, "default_color": "#6e6459", "cut": { "quantity": 1, "on_fold": true, "mirror": true } },
    { "id": "sleeve", "label": { "en": "Sleeve", "es": "Manga" }, "default_color": "#a39584", "cut": { "quantity": 2, "mirror": true } },
    { "id": "collar", "label": { "en": "Funnel Collar (rib)", "es": "Cuello alto (rib)" }, "default_color": "#c3b8a8", "cut": { "quantity": 1 } },
    { "id": "cuff", "label": { "en": "Cuff (rib)", "es": "Puño (rib)" }, "default_color": "#c3b8a8", "cut": { "quantity": 2 } },
    { "id": "hem_band", "label": { "en": "Hem Band (rib)", "es": "Pretina (rib)" }, "default_color": "#c3b8a8", "cut": { "quantity": 1 } }
  ],
  "parameters": [
    { "id": "chest_girth", "type": "slider", "default": 960, "min": 650, "max": 1900, "step": 10, "measurement": { "standard": "iso_8559", "code": "chest_bust_girth" }, "label": { "en": "Chest girth (mm)", "es": "Contorno de pecho (mm)" } },
    { "id": "body_length", "type": "slider", "default": 650, "min": 420, "max": 950, "step": 10, "label": { "en": "Body length to band seam (mm)", "es": "Largo de cuerpo hasta pretina (mm)" } },
    { "id": "neck_girth", "type": "slider", "default": 380, "min": 300, "max": 520, "step": 5, "measurement": { "standard": "iso_8559", "code": "neck_girth" }, "label": { "en": "Neck girth (mm)", "es": "Contorno de cuello (mm)" } },
    { "id": "sleeve_length", "type": "slider", "default": 610, "min": 200, "max": 780, "step": 10, "label": { "en": "Sleeve length to cuff seam (mm)", "es": "Largo de manga hasta puño (mm)" } },
    { "id": "sweater_ease", "type": "slider", "default": 90, "min": 30, "max": 300, "step": 10, "label": { "en": "Total ease (mm)", "es": "Holgura total (mm)" } },
    { "id": "collar_ratio", "type": "slider", "default": 0.75, "min": 0.55, "max": 0.95, "step": 0.01, "advanced": true, "label": { "en": "Collar/neck-opening ratio", "es": "Proporción cuello/abertura" } },
    { "id": "collar_height", "type": "slider", "default": 110, "min": 60, "max": 180, "step": 5, "tooltip": { "en": "Finished funnel height worn folded; the piece is cut at 2x this plus allowances", "es": "Alto terminado del cuello usado doblado; la pieza se corta al doble más márgenes" }, "label": { "en": "Collar height, finished (mm)", "es": "Alto de cuello terminado (mm)" } },
    { "id": "cuff_ratio", "type": "slider", "default": 0.72, "min": 0.6, "max": 0.95, "step": 0.01, "advanced": true, "label": { "en": "Cuff/opening ratio", "es": "Proporción puño/abertura" } },
    { "id": "hemband_ratio", "type": "slider", "default": 0.88, "min": 0.7, "max": 1.0, "step": 0.01, "advanced": true, "label": { "en": "Hem band/hem ratio", "es": "Proporción pretina/dobladillo" } },
    { "id": "cuff_height", "type": "slider", "default": 70, "min": 30, "max": 100, "step": 5, "label": { "en": "Cuff height (mm)", "es": "Alto de puño (mm)" } },
    { "id": "hemband_height", "type": "slider", "default": 45, "min": 30, "max": 100, "step": 5, "label": { "en": "Hem band height (mm)", "es": "Alto de pretina (mm)" } },
    { "id": "seam_allowance", "type": "slider", "default": 8, "min": 0, "max": 20, "step": 1, "label": { "en": "Seam allowance (mm)", "es": "Margen de costura (mm)" } }
  ],
  "presets": [
    { "id": "size-m", "label": { "en": "M", "es": "M" }, "values": { "chest_girth": 960, "body_length": 650, "sleeve_length": 610 } },
    { "id": "size-l", "label": { "en": "L", "es": "G" }, "values": { "chest_girth": 1040, "body_length": 680, "sleeve_length": 630 } }
  ],
  "constraints": [
    {
      "expression": "collar_ratio <= 0.85",
      "severity": "warning",
      "message": { "en": "Turtlenecks need strong negative ease to hug; keep the collar ratio at or below 0.85", "es": "Los cuellos altos necesitan holgura negativa fuerte para ceñirse; mantén la proporción en 0.85 o menos" }
    }
  ],
  "export_formats": ["svg", "dxf", "json"],
  "fabrics": ["felpa-algodon", "jersey-algodon"],
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "garment",
    "interfaces": [
      { "id": "neckline", "type": "neckline", "edges": [{ "piece": "front", "edge": "neck" }, { "piece": "back", "edge": "neck" }], "parameters": ["neck_girth", "collar_ratio", "collar_height"] },
      { "id": "armscye", "type": "armscye", "edges": [{ "piece": "front", "edge": "armhole" }, { "piece": "back", "edge": "armhole" }, { "piece": "sleeve", "edge": "cap" }], "parameters": ["chest_girth", "sweater_ease"] },
      { "id": "cuff", "type": "cuff", "edges": [{ "piece": "sleeve", "edge": "hem" }], "parameters": ["cuff_ratio", "cuff_height"] },
      { "id": "hem", "type": "hem", "edges": [{ "piece": "front", "edge": "hem" }, { "piece": "back", "edge": "hem" }], "parameters": ["hemband_ratio", "hemband_height"] }
    ],
    "capabilities": { "made_to_measure": true, "fold_cutting": true, "fabric_compensation": false, "knit_negative_ease": true },
    "societal_benefit": {
      "en": "The wardrobe's cold-weather staple, kept repairable and size-honest. Its folded funnel collar documents the doubled-rib rule — piece cut at twice the finished height, opening at strong negative ease — that every standing knit collar in the commons can reuse; the cut-and-sew branch keeps it makeable on a home machine until fully-fashioned knitting arrives.",
      "es": "El básico de clima frío del guardarropa, reparable y honesto en tallas. Su cuello doblado documenta la regla del rib doblado — pieza cortada al doble del alto terminado, abertura con holgura negativa fuerte — que todo cuello alto de punto del commons puede reutilizar; la rama corte-y-confección lo mantiene realizable en máquina casera hasta que llegue el tejido fully-fashioned."
    },
    "commons_license": "LicenseRef-FC1-pending"
  }
}
