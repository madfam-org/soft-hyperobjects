{
  "project": {
    "name": "Wrap Skirt",
    "slug": "wrap-skirt",
    "version": "0.1.0",
    "engine": "fc",
    "description": {
      "en": "FC-100 rank #81. A-line wrap skirt with no zipper: the back cuts on fold, one front piece cuts twice mirrored — its center edge extends past CF by the wrap extension, so the pair becomes the overlap and underlap panels — and two waist ties close the wrap. Flare replaces the darts; a front-waist notch marks the CF wrap line.",
      "es": "Rango #81 del FC-100. Falda cruzada en línea A sin cierre: el trasero se corta al doblez, un solo delantero se corta dos veces en espejo — su orilla central se extiende más allá del centro delantero por el cruce, de modo que el par se vuelve el panel superior y el panel inferior del cruce — y dos cintas de cintura cierran la falda. El vuelo sustituye a las pinzas; un piquete en la cintura delantera marca la línea del centro delantero.",
      "fr": "FC-100 rang n°81. Jupe portefeuille en ligne A sans fermeture éclair : le dos se coupe au pli, une seule pièce devant se coupe deux fois en miroir — son bord central se prolonge au-delà du CF par l'extension de croisé, de sorte que la paire devient les panneaux de dessus et de dessous — et deux liens de taille ferment le portefeuille. L'évasé remplace les Pinces ; un cran de taille devant repère la ligne de croisé du CF."
    },
    "difficulty": "beginner",
    "tags": [
      "skirt",
      "wrap",
      "a-line",
      "woven",
      "fc100",
      "hyperobject",
      "commons"
    ],
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "CERN-OHL-W-2.0",
      "lineage": [
        {
          "source": "Original draft for Fashion Cabinet",
          "license": "original"
        },
        {
          "source": "fashion-cabinet skirt-block (parent side-seam geometry)",
          "license": "CERN-OHL-W-2.0"
        }
      ]
    }
  },
  "modes": [
    {
      "id": "wrap",
      "label": {
        "en": "Wrap skirt (all pieces)",
        "es": "Falda cruzada (todas las piezas)",
        "fr": "Jupe portefeuille (toutes les pièces)"
      },
      "script_file": "main.py",
      "pieces": [
        "front",
        "back",
        "tie"
      ]
    }
  ],
  "pieces": [
    {
      "id": "front",
      "label": {
        "en": "Wrap Front",
        "es": "Delantero Cruzado",
        "fr": "Devant portefeuille"
      },
      "default_color": "#5d6c9e",
      "cut": {
        "quantity": 2,
        "mirror": true
      }
    },
    {
      "id": "back",
      "label": {
        "en": "Skirt Back",
        "es": "Falda Trasera",
        "fr": "Jupe Dos"
      },
      "default_color": "#48577f",
      "cut": {
        "quantity": 1,
        "on_fold": true,
        "mirror": true
      }
    },
    {
      "id": "tie",
      "label": {
        "en": "Waist Tie",
        "es": "Cinta de Cintura",
        "fr": "Lien de taille"
      },
      "default_color": "#8b97c4",
      "cut": {
        "quantity": 2
      }
    }
  ],
  "parameters": [
    {
      "id": "waist_girth",
      "type": "slider",
      "default": 700,
      "min": 450,
      "max": 1500,
      "step": 10,
      "measurement": {
        "standard": "iso_8559",
        "code": "waist_girth"
      },
      "label": {
        "en": "Waist girth (mm)",
        "es": "Contorno de cintura (mm)",
        "fr": "Tour de taille (mm)"
      }
    },
    {
      "id": "hip_girth",
      "type": "slider",
      "default": 940,
      "min": 600,
      "max": 1700,
      "step": 10,
      "measurement": {
        "standard": "iso_8559",
        "code": "hip_girth"
      },
      "label": {
        "en": "Hip girth (mm)",
        "es": "Contorno de cadera (mm)",
        "fr": "Tour de hanches (mm)"
      }
    },
    {
      "id": "skirt_length",
      "type": "slider",
      "default": 600,
      "min": 350,
      "max": 950,
      "step": 10,
      "label": {
        "en": "Skirt length (mm)",
        "es": "Largo de falda (mm)",
        "fr": "Longueur de jupe (mm)"
      }
    },
    {
      "id": "wrap_extension",
      "type": "slider",
      "default": 180,
      "min": 80,
      "max": 300,
      "step": 10,
      "label": {
        "en": "Wrap extension past CF (mm)",
        "es": "Cruce más allá del CF (mm)",
        "fr": "Extension de croisement au-delà du milieu devant (mm)"
      }
    },
    {
      "id": "flare_mm",
      "type": "slider",
      "default": 70,
      "min": 0,
      "max": 200,
      "step": 10,
      "label": {
        "en": "A-line flare per side (mm)",
        "es": "Vuelo línea A por costado (mm)",
        "fr": "Évasement trapèze par côté (mm)"
      }
    },
    {
      "id": "waist_ease",
      "type": "slider",
      "default": 20,
      "min": 0,
      "max": 80,
      "step": 5,
      "label": {
        "en": "Waist ease (mm)",
        "es": "Holgura de cintura (mm)",
        "fr": "Aisance de taille (mm)"
      }
    },
    {
      "id": "hip_ease",
      "type": "slider",
      "default": 40,
      "min": 0,
      "max": 150,
      "step": 5,
      "label": {
        "en": "Hip ease (mm)",
        "es": "Holgura de cadera (mm)",
        "fr": "Aisance de hanches (mm)"
      }
    },
    {
      "id": "tie_length",
      "type": "slider",
      "default": 800,
      "min": 400,
      "max": 1400,
      "step": 50,
      "label": {
        "en": "Waist tie length (mm)",
        "es": "Largo de cinta (mm)",
        "fr": "Longueur de lien de taille (mm)"
      }
    },
    {
      "id": "seam_allowance",
      "type": "slider",
      "default": 12,
      "min": 0,
      "max": 20,
      "step": 1,
      "label": {
        "en": "Seam allowance (mm)",
        "es": "Margen de costura (mm)",
        "fr": "Marge de couture (mm)"
      }
    },
    {
      "id": "hem_allowance",
      "type": "slider",
      "default": 30,
      "min": 0,
      "max": 60,
      "step": 5,
      "label": {
        "en": "Hem allowance (mm)",
        "es": "Margen de dobladillo (mm)",
        "fr": "Marge d'ourlet (mm)"
      }
    }
  ],
  "presets": [
    {
      "id": "size-m",
      "label": {
        "en": "M",
        "es": "M",
        "fr": "M"
      },
      "values": {}
    },
    {
      "id": "midi-full-wrap",
      "label": {
        "en": "Midi, generous wrap",
        "es": "Midi, cruce amplio",
        "fr": "Midi, croisement ample"
      },
      "values": {
        "skirt_length": 700,
        "wrap_extension": 220,
        "flare_mm": 100
      }
    }
  ],
  "constraints": [
    {
      "expression": "wrap_extension <= waist_girth / 3",
      "severity": "error",
      "message": {
        "en": "Wrap extension past CF must stay within a third of the waist girth",
        "es": "El cruce más allá del centro delantero debe quedar dentro de un tercio del contorno de cintura",
        "fr": "L'extension de croisé au-delà du CF doit rester dans le tiers du Tour de taille"
      }
    },
    {
      "expression": "hip_girth >= waist_girth",
      "severity": "error",
      "message": {
        "en": "Hip must be at least the waist",
        "es": "La cadera debe ser al menos la cintura",
        "fr": "La hanche doit être au moins égale à la taille"
      }
    }
  ],
  "export_formats": [
    "svg",
    "dxf",
    "json"
  ],
  "fabrics": [
    "popelina-algodon",
    "mezclilla-denim"
  ],
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "garment",
    "interfaces": [
      {
        "id": "waistband",
        "type": "waistband",
        "edges": [
          {
            "piece": "front",
            "edge": "waist"
          },
          {
            "piece": "back",
            "edge": "waist"
          }
        ],
        "parameters": [
          "waist_girth",
          "waist_ease"
        ]
      },
      {
        "id": "hem",
        "type": "hem",
        "edges": [
          {
            "piece": "front",
            "edge": "hem"
          },
          {
            "piece": "back",
            "edge": "hem"
          }
        ],
        "parameters": [
          "skirt_length",
          "hem_allowance"
        ]
      }
    ],
    "capabilities": {
      "made_to_measure": true,
      "fold_cutting": true,
      "fabric_compensation": false,
      "knit_negative_ease": false
    },
    "societal_benefit": {
      "en": "The FC-100 skirt family's first garment: a zipper-free closure anyone can sew and any body can adjust by how far it wraps — made-to-measure without hardware.",
      "es": "La primera prenda de la familia de faldas del FC-100: un cierre sin cremallera que cualquiera puede coser y cualquier cuerpo puede ajustar según cuánto cruza — a la medida sin herrajes.",
      "fr": "Le premier vêtement de la famille des jupes du FC-100 : une fermeture sans fermeture éclair que chacun peut coudre et que tout corps peut ajuster selon la profondeur du croisé — sur mesure sans quincaillerie."
    },
    "commons_license": "CERN-OHL-W-2.0"
  }
}
