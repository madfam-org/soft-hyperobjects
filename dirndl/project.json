      "type": "slider",
      "group": "fit",
      "default": 0.62,
      "min": 0.45,
      "max": 0.85,
      "step": 0.01,
      "label": {
        "en": "Apron width fraction",
        "es": "Fracción de ancho del delantal",
        "fr": "Fraction de largeur du tablier"
      },
      "tooltip": {
        "en": "Apron width as a fraction of the skirt",
        "es": "Ancho del delantal como fracción de la falda",
        "fr": "Largeur du tablier en fraction de la jupe"
      }
    }
  ],
  "presets": [
