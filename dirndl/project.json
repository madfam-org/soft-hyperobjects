  "fabrics": [],
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "garment",
    "interfaces": [
      {
        "id": "shoulder_seam",
        "type": "shoulder",
        "label": {
          "en": "Shoulder seam",
          "es": "Costura de hombro",
          "fr": "Couture d'épaule"
        },
        "edges": [
          {
            "piece": "bodice_front",
            "edge": "shoulder"
          },
          {
            "piece": "bodice_back",
            "edge": "shoulder"
          }
        ],
        "parameters": [
          "neck_width",
          "bust_girth"
        ]
      },
      {
        "id": "bodice_side",
        "type": "side_seam",
        "label": {
          "en": "Bodice side seam",
          "es": "Costura lateral de corpiño",
          "fr": "Couture côté de corsage"
        },
        "edges": [
          {
            "piece": "bodice_front",
            "edge": "side"
          },
          {
            "piece": "bodice_back",
            "edge": "side"
          }
        ],
        "parameters": [
          "bust_girth",
          "waist_girth"
        ]
      },
      {
        "id": "waist_seam",
        "type": "waistband",
        "label": {
          "en": "Waist seam (bodice to skirt)",
          "es": "Costura de cintura (corpiño a falda)",
          "fr": "Couture de taille (corsage vers jupe)"
        },
        "edges": [
          {
            "piece": "bodice_front",
            "edge": "waist"
          },
          {
            "piece": "skirt",
            "edge": "waist"
          }
        ],
        "parameters": [
          "waist_girth",
          "gather_ratio"
        ]
      }
    ],
    "capabilities": {
      "made_to_measure": true,
      "fold_cutting": true,
      "fabric_compensation": false,
      "heritage": true
    },
    "societal_benefit": {
      "en": "An open, made-to-measure dirndl pattern keeps a living heritage garment makeable and repairable by the people who wear it — bodice, skirt, and apron drafted to real measurements, with the regional decoration left to the maker rather than dictated or sold back.",
      "es": "Un patrón de dirndl abierto y a la medida mantiene una prenda patrimonial viva fabricable y reparable por quienes la visten — corpiño, falda y delantal trazados a medidas reales, con la decoración regional en manos de quien elabora, no dictada ni revendida.",
      "fr": "Un patron de dirndl ouvert et sur mesure garde un vêtement patrimonial vivant fabricable et réparable par ceux qui le portent — corsage, jupe et tablier tracés à des mesures réelles, la décoration régionale laissée à la personne qui le confectionne plutôt que dictée ou revendue."
    },
