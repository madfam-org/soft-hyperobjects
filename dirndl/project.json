        "en": "Skirt length (mm)",
        "es": "Largo de falda (mm)",
        "fr": "Longueur de jupe (mm)"
      },
      "tooltip": {
        "en": "Waist to hem",
        "es": "De la cintura al ruedo",
        "fr": "De la taille à l'ourlet"
