      "type": "slider",
      "group": "body",
      "default": 380,
      "min": 300,
      "max": 480,
      "step": 5,
      "label": {
        "en": "Bodice length (mm)",
        "es": "Largo de corpiño (mm)",
        "fr": "Longueur de corsage (mm)"
      },
      "tooltip": {
        "en": "Shoulder to waist seam",
        "es": "Del hombro a la costura de cintura",
        "fr": "De l'épaule à la couture de taille"
