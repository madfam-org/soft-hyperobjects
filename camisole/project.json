{
  "project": {
    "name": "Camisole",
    "slug": "camisole",
    "version": "0.1.0",
    "engine": "fc",
    "description": {
      "en": "FC-100 rank #44. Strappy knit camisole with a slight A-line flare: front and back cut on fold, bound top edges whose binding strip is derived from the measured openings times a stretch ratio, and separate spaghetti-strap strips.\n\nOfficial visualizer and configurator: Fashion Cabinet",
      "es": "Rango #44 del FC-100. Camisola de punto con tirantes y ligero corte en A: delantero y trasero cortados al doblez, bordes superiores con vivo cuya tira se deriva de las aberturas medidas por una proporción de estiramiento, y tiras de tirante espagueti separadas.\n\nVisualizador y configurador oficial: Fashion Cabinet",
      "fr": "Rang #44 du FC-100. Caraco en maille à fines bretelles avec un léger évasement en A : devant et dos coupés au pli, bords supérieurs gansés dont la bande de ganse est dérivée des ouvertures mesurées multipliées par un ratio d'étirement, et fines bretelles spaghetti séparées.\n\nVisualiseur et configurateur officiel : Fashion Cabinet"
    },
    "difficulty": "beginner",
    "tags": [
      "camisole",
      "straps",
      "knit",
      "underwear-lounge",
      "fc100",
      "hyperobject",
      "commons"
    ],
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "CERN-OHL-W-2.0",
      "lineage": [
        {
          "source": "Original draft for Fashion Cabinet",
          "license": "original"
        }
      ]
    }
  },
  "modes": [
    {
      "id": "camisole",
      "label": {
        "en": "Camisole (all pieces)",
        "es": "Camisola (todas las piezas)",
        "fr": "Caraco (toutes les pièces)"
      },
      "script_file": "main.py",
      "pieces": [
        "front",
        "back",
        "strap",
        "top_binding"
      ]
    }
  ],
  "pieces": [
    {
      "id": "front",
      "label": {
        "en": "Front",
        "es": "Delantero",
        "fr": "Devant"
      },
      "default_color": "#b25a78",
      "cut": {
        "quantity": 1,
        "on_fold": true,
        "mirror": true
      }
    },
    {
      "id": "back",
      "label": {
        "en": "Back",
        "es": "Trasero",
        "fr": "Dos"
      },
      "default_color": "#8e4560",
      "cut": {
        "quantity": 1,
        "on_fold": true,
        "mirror": true
      }
    },
    {
      "id": "strap",
      "label": {
        "en": "Strap",
        "es": "Tirante",
        "fr": "Bretelle"
      },
      "default_color": "#d489a4",
      "cut": {
        "quantity": 2
      }
    },
    {
      "id": "top_binding",
      "label": {
        "en": "Top Binding",
        "es": "Vivo Superior",
        "fr": "Passepoil supérieur"
      },
      "default_color": "#e3aec3",
      "cut": {
        "quantity": 1
      }
    }
  ],
  "parameters": [
    {
      "id": "bust_girth",
      "type": "slider",
      "default": 880,
      "min": 600,
      "max": 1600,
      "step": 10,
      "measurement": {
        "standard": "iso_8559",
        "code": "bust_girth"
      },
      "label": {
        "en": "Bust girth (mm)",
        "es": "Contorno de busto (mm)",
        "fr": "Tour de buste (mm)"
      }
    },
    {
      "id": "body_length",
      "type": "slider",
      "default": 620,
      "min": 350,
      "max": 900,
      "step": 10,
      "label": {
        "en": "Body length, strap point to hem (mm)",
        "es": "Largo de cuerpo, tirante a dobladillo (mm)",
        "fr": "Longueur du corps, point de bretelle à l'ourlet (mm)"
      }
    },
    {
      "id": "front_drop",
      "type": "slider",
      "default": 110,
      "min": 40,
      "max": 200,
      "step": 5,
      "label": {
        "en": "Front neckline drop (mm)",
        "es": "Caída del escote delantero (mm)",
        "fr": "Descente d'encolure devant (mm)"
      }
    },
    {
      "id": "back_drop",
      "type": "slider",
      "default": 40,
      "min": 10,
      "max": 120,
      "step": 5,
      "label": {
        "en": "Back edge drop (mm)",
        "es": "Caída del borde trasero (mm)",
        "fr": "Descente du bord dos (mm)"
      }
    },
    {
      "id": "strap_length",
      "type": "slider",
      "default": 380,
      "min": 250,
      "max": 600,
      "step": 10,
      "label": {
        "en": "Strap cut length (mm)",
        "es": "Largo de corte del tirante (mm)",
        "fr": "Longueur de coupe de la bretelle (mm)"
      }
    },
    {
      "id": "flare_mm",
      "type": "slider",
      "default": 40,
      "min": 0,
      "max": 120,
      "step": 5,
      "label": {
        "en": "A-line flare per quarter (mm)",
        "es": "Vuelo en A por cuarto (mm)",
        "fr": "Évasement trapèze par quart (mm)"
      }
    },
    {
      "id": "knit_ease",
      "type": "slider",
      "default": 0,
      "min": -80,
      "max": 150,
      "step": 5,
      "label": {
        "en": "Total ease (mm, negative hugs)",
        "es": "Holgura total (mm, negativa ciñe)",
        "fr": "Aisance totale (mm, négative épouse)"
      }
    },
    {
      "id": "binding_ratio",
      "type": "slider",
      "default": 0.92,
      "min": 0.75,
      "max": 1.0,
      "step": 0.01,
      "advanced": true,
      "label": {
        "en": "Binding/opening ratio",
        "es": "Proporción vivo/abertura",
        "fr": "Rapport biais/ouverture"
      }
    },
    {
      "id": "binding_width",
      "type": "slider",
      "default": 10,
      "min": 6,
      "max": 20,
      "step": 1,
      "label": {
        "en": "Binding finished width (mm)",
        "es": "Ancho terminado del vivo (mm)",
        "fr": "Largeur finie du biais (mm)"
      }
    },
    {
      "id": "seam_allowance",
      "type": "slider",
      "default": 7,
      "min": 0,
      "max": 20,
      "step": 1,
      "label": {
        "en": "Seam allowance (mm)",
        "es": "Margen de costura (mm)",
        "fr": "Marge de couture (mm)"
      }
    },
    {
      "id": "hem_allowance",
      "type": "slider",
      "default": 20,
      "min": 0,
      "max": 50,
      "step": 5,
      "label": {
        "en": "Hem allowance (mm)",
        "es": "Margen de dobladillo (mm)",
        "fr": "Marge d'ourlet (mm)"
      }
    }
  ],
  "presets": [
    {
      "id": "size-s",
      "label": {
        "en": "S",
        "es": "CH",
        "fr": "S"
      },
      "values": {
        "bust_girth": 800,
        "body_length": 600
      }
    },
    {
      "id": "size-m",
      "label": {
        "en": "M",
        "es": "M",
        "fr": "M"
      },
      "values": {
        "bust_girth": 880,
        "body_length": 620
      }
    }
  ],
  "constraints": [
    {
      "expression": "front_drop >= back_drop",
      "severity": "warning",
      "message": {
        "en": "A camisole neckline drops deeper in front than in back",
        "es": "El escote de una camisola cae más al frente que en la espalda",
        "fr": "L'encolure d'un caraco descend plus bas au devant qu'au dos"
      }
    }
  ],
  "export_formats": [
    "svg",
    "dxf",
    "json",
    "pdf"
  ],
  "fabrics": [
    "jersey-algodon"
  ],
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "garment",
    "interfaces": [
      {
        "id": "neckline",
        "type": "neckline",
        "edges": [
          {
            "piece": "front",
            "edge": "top"
          },
          {
            "piece": "back",
            "edge": "top"
          }
        ],
        "parameters": [
          "front_drop",
          "back_drop",
          "binding_ratio"
        ]
      },
      {
        "id": "hem",
        "type": "hem",
        "edges": [
          {
            "piece": "front",
            "edge": "hem"
          },
          {
            "piece": "back",
            "edge": "hem"
          }
        ],
        "parameters": [
          "body_length",
          "flare_mm",
          "hem_allowance"
        ]
      }
    ],
    "capabilities": {
      "made_to_measure": true,
      "fold_cutting": true,
      "fabric_compensation": false,
      "knit_negative_ease": true
    },
    "societal_benefit": {
      "en": "The first-layer staple that teaches strap engineering: attachment points marked on the body, spaghetti straps and top binding computed as strips from measured edges instead of guessed lengths.",
      "es": "El básico de primera capa que enseña la ingeniería de tirantes: puntos de anclaje marcados en el cuerpo, tirantes espagueti y vivo superior calculados como tiras a partir de bordes medidos en lugar de largos adivinados.",
      "fr": "Le basique de première couche qui enseigne l'ingénierie des bretelles : points d'attache marqués sur le corps, bretelles spaghetti et ganse supérieure calculées comme des bandes à partir de bords mesurés plutôt que de longueurs devinées."
    },
    "commons_license": "CERN-OHL-W-2.0"
  }
}
