{
  "project": {
    "name": "Long-sleeve Tee",
    "slug": "long-sleeve-tee",
    "version": "0.1.0",
    "engine": "fc",
    "description": {
      "en": "FC-100 rank #13. The rank #1 drop-shoulder knit block with a long, tapered, cap-solved sleeve and a derived rib neckband.\n\nOfficial visualizer and configurator: Fashion Cabinet",
      "es": "Rango #13 del FC-100. El bloque de hombro caído del rango #1 con manga larga entallada de copa resuelta y cuello de rib derivado.\n\nVisualizador y configurador oficial: Fashion Cabinet",
      "fr": "FC-100 rang no 13. Le bloc en maille à épaule tombante du rang no 1 avec une manche longue, fuselée, à tête résolue et une bordure d'encolure côtelée dérivée.\n\nVisualiseur et configurateur officiel : Fashion Cabinet"
    },
    "difficulty": "beginner",
    "tags": [
      "long-sleeve",
      "tee",
      "knit",
      "fc100",
      "hyperobject",
      "commons"
    ],
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "LicenseRef-FC1-pending",
      "lineage": [
        {
          "source": "Original draft for Fashion Cabinet (rank #1 block family)",
          "license": "original"
        }
      ]
    }
  },
  "modes": [
    {
      "id": "tee",
      "label": {
        "en": "Long-sleeve tee (all pieces)",
        "es": "Playera manga larga (todas las piezas)",
        "fr": "T-shirt manches longues (toutes les pièces)"
      },
      "script_file": "main.py",
      "pieces": [
        "front",
        "back",
        "sleeve",
        "neckband"
      ]
    }
  ],
  "pieces": [
    {
      "id": "front",
      "label": {
        "en": "Front",
        "es": "Delantero",
        "fr": "Devant"
      },
      "default_color": "#4a8fc9",
      "cut": {
        "quantity": 1,
        "on_fold": true,
        "mirror": true
      }
    },
    {
      "id": "back",
      "label": {
        "en": "Back",
        "es": "Trasero",
        "fr": "Dos"
      },
      "default_color": "#3a6f9f",
      "cut": {
        "quantity": 1,
        "on_fold": true,
        "mirror": true
      }
    },
    {
      "id": "sleeve",
      "label": {
        "en": "Sleeve (long)",
        "es": "Manga (larga)",
        "fr": "Manche (longue)"
      },
      "default_color": "#6aa4d4",
      "cut": {
        "quantity": 2,
        "mirror": true
      }
    },
    {
      "id": "neckband",
      "label": {
        "en": "Neckband (rib)",
        "es": "Cuello (rib)",
        "fr": "Col bord-côte (rib)"
      },
      "default_color": "#8fb8dc",
      "cut": {
        "quantity": 1
      }
    }
  ],
  "parameters": [
    {
      "id": "chest_girth",
      "type": "slider",
      "default": 980,
      "min": 600,
      "max": 1800,
      "step": 10,
      "measurement": {
        "standard": "iso_8559",
        "code": "chest_bust_girth"
      },
      "label": {
        "en": "Chest girth (mm)",
        "es": "Contorno de pecho (mm)",
        "fr": "Tour de poitrine (mm)"
      }
    },
    {
      "id": "body_length",
      "type": "slider",
      "default": 720,
      "min": 400,
      "max": 1000,
      "step": 10,
      "label": {
        "en": "Body length, nape to hem (mm)",
        "es": "Largo de cuerpo (mm)",
        "fr": "Longueur du corps, nuque à l'ourlet (mm)"
      }
    },
    {
      "id": "neck_girth",
      "type": "slider",
      "default": 380,
      "min": 300,
      "max": 520,
      "step": 5,
      "measurement": {
        "standard": "iso_8559",
        "code": "neck_girth"
      },
      "label": {
        "en": "Neck girth (mm)",
        "es": "Contorno de cuello (mm)",
        "fr": "Tour de cou (mm)"
      }
    },
    {
      "id": "sleeve_length",
      "type": "slider",
      "default": 590,
      "min": 300,
      "max": 780,
      "step": 10,
      "label": {
        "en": "Sleeve length, shoulder to hem (mm)",
        "es": "Largo de manga (mm)",
        "fr": "Longueur de manche, épaule à l'ourlet (mm)"
      }
    },
    {
      "id": "knit_ease",
      "type": "slider",
      "default": 60,
      "min": -80,
      "max": 300,
      "step": 10,
      "label": {
        "en": "Total ease (mm)",
        "es": "Holgura total (mm)",
        "fr": "Aisance totale (mm)"
      }
    },
    {
      "id": "wrist_opening",
      "type": "slider",
      "default": 190,
      "min": 140,
      "max": 400,
      "step": 5,
      "label": {
        "en": "Wrist opening, flat (mm)",
        "es": "Abertura de puño, extendida (mm)",
        "fr": "Ouverture de poignet, à plat (mm)"
      }
    },
    {
      "id": "neckband_ratio",
      "type": "slider",
      "default": 0.85,
      "min": 0.7,
      "max": 1.0,
      "step": 0.01,
      "advanced": true,
      "label": {
        "en": "Neckband/opening ratio",
        "es": "Proporción cuello/abertura",
        "fr": "Proportion col/ouverture"
      }
    },
    {
      "id": "neckband_width",
      "type": "slider",
      "default": 20,
      "min": 10,
      "max": 40,
      "step": 1,
      "label": {
        "en": "Neckband width (mm)",
        "es": "Ancho de cuello (mm)",
        "fr": "Largeur du col (mm)"
      }
    },
    {
      "id": "seam_allowance",
      "type": "slider",
      "default": 7,
      "min": 0,
      "max": 20,
      "step": 1,
      "label": {
        "en": "Seam allowance (mm)",
        "es": "Margen de costura (mm)",
        "fr": "Marge de couture (mm)"
      }
    },
    {
      "id": "hem_allowance",
      "type": "slider",
      "default": 25,
      "min": 0,
      "max": 50,
      "step": 5,
      "label": {
        "en": "Hem allowance (mm)",
        "es": "Margen de dobladillo (mm)",
        "fr": "Marge d'ourlet (mm)"
      }
    }
  ],
  "presets": [
    {
      "id": "size-m",
      "label": {
        "en": "M",
        "es": "M",
        "fr": "M"
      },
      "values": {
        "chest_girth": 980,
        "sleeve_length": 590
      }
    },
    {
      "id": "size-l",
      "label": {
        "en": "L",
        "es": "G",
        "fr": "L"
      },
      "values": {
        "chest_girth": 1060,
        "body_length": 750,
        "sleeve_length": 610
      }
    }
  ],
  "constraints": [
    {
      "expression": "wrist_opening <= chest_girth / 3",
      "severity": "warning",
      "message": {
        "en": "Very wide wrist relative to body — check the taper intent",
        "es": "Puño muy amplio respecto al cuerpo — verifica la intención del entallado",
        "fr": "Poignet très large par rapport au corps — vérifiez l'intention du fuselé"
      }
    }
  ],
  "export_formats": [
    "svg",
    "dxf",
    "json"
  ],
  "fabrics": [
    "jersey-algodon"
  ],
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "garment",
    "interfaces": [
      {
        "id": "neckline",
        "type": "neckline",
        "edges": [
          {
            "piece": "front",
            "edge": "neck"
          },
          {
            "piece": "back",
            "edge": "neck"
          }
        ],
        "parameters": [
          "neck_girth",
          "neckband_ratio"
        ]
      },
      {
        "id": "armscye",
        "type": "armscye",
        "edges": [
          {
            "piece": "front",
            "edge": "armhole"
          },
          {
            "piece": "back",
            "edge": "armhole"
          },
          {
            "piece": "sleeve",
            "edge": "cap"
          }
        ],
        "parameters": [
          "chest_girth",
          "knit_ease"
        ]
      },
      {
        "id": "hem",
        "type": "hem",
        "edges": [
          {
            "piece": "front",
            "edge": "hem"
          },
          {
            "piece": "back",
            "edge": "hem"
          }
        ],
        "parameters": [
          "body_length",
          "hem_allowance"
        ]
      }
    ],
    "capabilities": {
      "made_to_measure": true,
      "fold_cutting": true,
      "fabric_compensation": false,
      "knit_negative_ease": true
    },
    "societal_benefit": {
      "en": "The cold-weather half of the world's default garment; proves the rank #1 block family scales across sleeve variants without new drafting rules.",
      "es": "La mitad de clima frío de la prenda por defecto del mundo; demuestra que la familia del bloque #1 escala entre variantes de manga sin nuevas reglas de trazo.",
      "fr": "La moitié « temps froid » du vêtement par défaut du monde ; démontre que la famille du bloc no 1 s'adapte aux variantes de manche sans nouvelles règles de tracé."
    },
    "commons_license": "LicenseRef-FC1-pending"
  }
}
